def github_health_check(config):
    """Trả (ok, msg). Chạy trong thread."""
    if not config:
        return False, "no config"
    try:
        url = (f"https://api.github.com/repos/{config['owner']}/{config['repo']}")
        req = urllib.request.Request(url, headers={
            "Authorization": f"token {config['token']}",
            "User-Agent":    "ManagementSystem/2.0",
        })
        with urllib.request.urlopen(req, timeout=10) as resp:
            if resp.status == 200:
                data = json.loads(resp.read().decode("utf-8"))
                if data.get("permissions", {}).get("push"):
                    return True, "OK"
                return False, "Không có quyền push"
    except urllib.error.HTTPError as e:
        if e.code == 401:
            return False, "Token không hợp lệ"
        if e.code == 404:
            return False, "Repo không tồn tại"
        return False, f"HTTP {e.code}"
    except Exception as e:
        return False, str(e)
    return False, "unknown"


