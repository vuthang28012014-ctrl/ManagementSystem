        bar.set_categories(b_cats)

        bar.dataLabels = DataLabelList()
        bar.dataLabels.showVal        = True
        bar.dataLabels.showPercent    = False
        bar.dataLabels.showSerName    = False
        bar.dataLabels.showCatName    = False
