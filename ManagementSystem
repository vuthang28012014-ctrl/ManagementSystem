def _build_word_report(hoc_sinh, path, ly_do_md):
    """
    Xuất báo cáo Word (.doc) — dùng HTML tables thay vì SVG.
    Word KHÔNG render inline SVG đúng (text dồn về góc), nên biểu đồ
    được vẽ bằng table với ô bgcolor.
    """
    try:
        def esc(s):
            return (str(s).replace("&", "&amp;")
                           .replace("<", "&lt;")
                           .replace(">", "&gt;"))

        hs_order = sorted(hoc_sinh.keys(),
                          key=lambda m: hoc_sinh[m]["name"].lower())

        def color_of(rate):
            if rate >= 90:   return "#C6EFCE", "#1a5c1a"
            elif rate >= 75: return "#FFEB9C", "#7a5a00"
            else:            return "#FFC7CE", "#8b1a2a"

        # ── Tính dữ liệu ──
        rows = []
        all_cm = all_vp = all_vkp = all_loi = 0
        for ma in hs_order:
            d = hoc_sinh[ma]
            n_cm = n_vp = n_vkp = n_loi = 0
            for t in range(1, TONG_TUAN + 1):
                w = d.get("weeks", {}).get(t) or {}
                att = w.get("attendance", {})
                rea = w.get("reasons", {})
                err = w.get("errors", {})
                for day in THU:
                    if att.get(day, False):
                        n_cm += 1
                    else:
                        r = (rea.get(day, "") or "").strip()
                        if r and r != ly_do_md: n_vp += 1
                        else: n_vkp += 1
                    if (err.get(day, "") or "").strip():
                        n_loi += 1
            total = n_cm + n_vp + n_vkp
            rate = (n_cm / total * 100) if total else 0
            rows.append({
                "ma": ma, "name": d["name"], "class": d["class"],
