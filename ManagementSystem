    # ═══ Vẽ biểu đồ thống kê ═══
    def _ve_bieu_do_thong_ke(self, canvas, rows, by_class,
                              tot_p, tot_e, tot_a):
        """Vẽ donut + bar charts lên Canvas."""
        try:
            canvas.delete("all")
            canvas.update_idletasks()
            W = max(940, canvas.winfo_width() - 4)
        except Exception:
            return

        PAD = 30
        content_w = W - 2 * PAD

        # ═══════════════════════════════════════════════
        # SECTION 1 — DONUT TỔNG QUAN + LEGEND
        # ═══════════════════════════════════════════════
        y = 20
        canvas.create_text(PAD, y,
                           text="TỔNG QUAN CHUYÊN CẦN",
                           anchor="w", fill=self.XANH_DUONG,
                           font=("Segoe UI", 13, "bold"))
        canvas.create_text(PAD, y + 20,
                           text=f"{len(rows)} học sinh · {TONG_TUAN} tuần học",
                           anchor="w", fill=self.CHU_MO,
                           font=("Segoe UI", 9, "italic"))

        total = tot_p + tot_e + tot_a
        cx = PAD + 130
        cy = y + 180
        r  = 115

        # Donut
        if total > 0:
            arcs = [
                (tot_p, self.XANH_LA),
                (tot_e, self.VANG),
                (tot_a, self.DO),
            ]
            start = 90
            for value, color in arcs:
                if value <= 0: continue
                extent = -value / total * 360
                canvas.create_arc(cx - r, cy - r, cx + r, cy + r,
                                  start=start, extent=extent,
                                  fill=color, outline=self.NEN, width=3)
                start += extent

        # Lỗ donut
        inner = r * 0.58
        canvas.create_oval(cx - inner, cy - inner,
                           cx + inner, cy + inner,
                           fill=self.NEN, outline="")
        canvas.create_text(cx, cy - 12,
                           text=f"{total:,}".replace(",", "."),
                           fill=self.CHU,
                           font=("Segoe UI", 22, "bold"))
        canvas.create_text(cx, cy + 16, text="tổng buổi",
                           fill=self.CHU_MO,
                           font=("Segoe UI", 9))

        # Legend bên phải
        lx = PAD + 320
        ly = cy - 90
        legend_items = [
            ("Có mặt",      tot_p, self.XANH_LA),
            ("Có phép",     tot_e, self.VANG),
            ("Không phép",  tot_a, self.DO),
        ]
        for label, value, color in legend_items:
            pct = (value / total * 100) if total else 0
            canvas.create_rectangle(lx, ly - 10, lx + 18, ly + 10,
                                    fill=color, outline="")
            canvas.create_text(lx + 30, ly, text=label,
                               anchor="w", fill=self.CHU,
                               font=("Segoe UI", 11, "bold"))
            canvas.create_text(lx + 160, ly,
                               text=f"{value:,} buổi".replace(",", "."),
                               anchor="w", fill=self.CHU_MO,
                               font=("Consolas", 10))
            canvas.create_text(lx + 300, ly,
                               text=f"{pct:.1f}%",
                               anchor="w", fill=color,
                               font=("Segoe UI", 12, "bold"))
            ly += 40

        # Tỉ lệ chuyên cần chung
        rate_all = (tot_p / total * 100) if total else 0
        if rate_all >= 90:   c_all = self.XANH_LA
        elif rate_all >= 75: c_all = self.VANG
        else:                c_all = self.DO

        canvas.create_text(lx, ly + 20,
                           text="Tỉ lệ chuyên cần chung",
                           anchor="w", fill=self.CHU_MO,
                           font=("Segoe UI", 10))
        canvas.create_text(lx, ly + 48,
                           text=f"{rate_all:.1f}%",
                           anchor="w", fill=c_all,
                           font=("Segoe UI", 22, "bold"))

        # ═══════════════════════════════════════════════
        # SECTION 2 — BAR CHART THEO LỚP
        # ═══════════════════════════════════════════════
        y2 = cy + r + 50
        canvas.create_text(PAD, y2,
                           text="CHUYÊN CẦN THEO LỚP",
                           anchor="w", fill=self.XANH_DUONG,
                           font=("Segoe UI", 13, "bold"))

        class_items = []
        for cls, (p, e, a, cnt) in by_class.items():
            tt = p + e + a
            rate = (p / tt * 100) if tt else 0
            class_items.append((cls, rate, p, tt, cnt))
        class_items.sort(key=lambda x: -x[1])

        label_w  = 150
        value_w  = 180
        bar_max_w = max(200, content_w - label_w - value_w)
        row_h    = 36

        yy = y2 + 36
        for cls, rate, p, tt, cnt in class_items:
            canvas.create_text(PAD, yy - 6, text=cls,
                               anchor="w", fill=self.CHU,
                               font=("Segoe UI", 10, "bold"))
            canvas.create_text(PAD, yy + 10,
                               text=f"{cnt} HS · {p}/{tt} buổi",
                               anchor="w", fill=self.CHU_MO,
                               font=("Segoe UI", 8))

            bx = PAD + label_w
            canvas.create_rectangle(bx, yy - 11,
                                    bx + bar_max_w, yy + 11,
                                    fill=self.NEN2, outline="")
            bw = bar_max_w * (rate / 100)
            if rate >= 90:   bc = self.XANH_LA
            elif rate >= 75: bc = self.VANG
            else:            bc = self.DO
            if bw > 0:
                canvas.create_rectangle(bx, yy - 11,
                                        bx + bw, yy + 11,
                                        fill=bc, outline="")
            canvas.create_text(bx + bar_max_w + 12, yy,
                               text=f"{rate:.1f}%",
                               anchor="w", fill=bc,
                               font=("Consolas", 11, "bold"))
            yy += row_h

        # ═══════════════════════════════════════════════
        # SECTION 3 — TOP HS CHUYÊN CẦN THẤP NHẤT
        # ═══════════════════════════════════════════════
        y3 = yy + 30
        canvas.create_text(PAD, y3,
                           text="TOP 15 HỌC SINH CHUYÊN CẦN THẤP NHẤT",
                           anchor="w", fill=self.XANH_DUONG,
                           font=("Segoe UI", 13, "bold"))
        canvas.create_text(PAD, y3 + 18,
                           text="Sắp xếp theo tỉ lệ có mặt tăng dần",
                           anchor="w", fill=self.CHU_MO,
                           font=("Segoe UI", 9, "italic"))

        top = sorted(rows, key=lambda r: r["rate"])[:15]
        yy = y3 + 46
        for r in top:
            name_disp = r["name"]
            if len(name_disp) > 22:
                name_disp = name_disp[:20] + "…"
            canvas.create_text(PAD, yy - 6, text=name_disp,
                               anchor="w", fill=self.CHU,
                               font=("Segoe UI", 10, "bold"))
            canvas.create_text(PAD, yy + 10,
                               text=f"Lớp {r['class']} · Tổ {r['to']} · Mã {r['ma']}",
                               anchor="w", fill=self.CHU_MO,
                               font=("Segoe UI", 8))

            bx = PAD + label_w
            canvas.create_rectangle(bx, yy - 11,
                                    bx + bar_max_w, yy + 11,
                                    fill=self.NEN2, outline="")
            bw = bar_max_w * (r["rate"] / 100)
            if r["rate"] >= 90:   bc = self.XANH_LA
            elif r["rate"] >= 75: bc = self.VANG
            else:                 bc = self.DO
            if bw > 0:
                canvas.create_rectangle(bx, yy - 11,
                                        bx + bw, yy + 11,
                                        fill=bc, outline="")
            canvas.create_text(bx + bar_max_w + 12, yy,
                               text=f"{r['rate']:.1f}%",
                               anchor="w", fill=bc,
                               font=("Consolas", 11, "bold"))
            canvas.create_text(bx + bar_max_w + 90, yy,
                               text=f"({r['present']}/{r['total']})",
                               anchor="w", fill=self.CHU_MO,
                               font=("Consolas", 9))
            if r["errors"] > 0:
                canvas.create_text(bx + bar_max_w + 170, yy,
                                   text=f"⚠ {r['errors']} lỗi",
                                   anchor="w", fill=self.CAM,
                                   font=("Segoe UI", 9, "bold"))
            yy += row_h

        # Update scrollregion
        H = yy + 40
        canvas.configure(scrollregion=(0, 0, W, H))

    def xuat_excel(self):
        """Xuất Excel: dùng openpyxl nếu có, ngược lại HTML .xls."""
        if not self.HocSinh:
            self.thong_bao("⚠ Không có dữ liệu", self.VANG); return

        if OPENPYXL_OK:
            self._xuat_xlsx()
        else:
            self._xuat_xls_html()

    # ─────────────────────────────────────────────────────
    def _xuat_xlsx(self):
        """Xuất .xlsx thật bằng openpyxl — có màu, width, freeze header."""
        ext = ".xlsx"
        path = filedialog.asksaveasfilename(
            defaultextension=ext,
            filetypes=[("Excel files", "*.xlsx"), ("All files", "*.*")],
            initialfile=f"diem_danh_tuan_{self.tuan_hien_tai}.xlsx")
        if not path: return

        ly_do_md = self.settings["ly_do_mac_dinh"]
        tuan = self.tuan_hien_tai

        try:
            wb = Workbook()
            ws = wb.active
            ws.title = f"Tuần {tuan}"

            # ── Styles ──
            thin = Side(border_style="thin", color="999999")
            border = Border(left=thin, right=thin, top=thin, bottom=thin)
            header_fill = PatternFill("solid", fgColor="4472C4")
            header_font = Font(bold=True, color="FFFFFF", size=11)
            center = Alignment(horizontal="center", vertical="center")
            left   = Alignment(horizontal="left",   vertical="center")

            fill_cm  = PatternFill("solid", fgColor="C6EFCE")  # xanh lá nhạt
            fill_vp  = PatternFill("solid", fgColor="FFEB9C")  # vàng nhạt
            fill_vkp = PatternFill("solid", fgColor="FFC7CE")  # đỏ nhạt
            fill_err = PatternFill("solid", fgColor="FFD4A3")  # cam nhạt

            # ── Tiêu đề ──
            ws["A1"] = f"BẢNG ĐIỂM DANH — TUẦN {tuan}"
            ws["A1"].font = Font(bold=True, size=14, color="1F3864")
            ws.merge_cells(start_row=1, start_column=1,
                           end_row=1, end_column=6 + len(THU) + 4)

            ws["A2"] = f"Ngày xuất: {datetime.now().strftime('%d/%m/%Y %H:%M')}"
            ws["A2"].font = Font(italic=True, color="666666")
            ws.merge_cells(start_row=2, start_column=1,
                           end_row=2, end_column=6 + len(THU) + 4)

            # ── Header row ──
            headers = (["STT", "Mã", "Họ tên", "Lớp", "Tổ", "Tuần"]
                       + THU
                       + ["Có mặt", "Vắng phép", "Vắng KP", "Lỗi"])
            header_row = 4
            for col, h in enumerate(headers, 1):
                c = ws.cell(row=header_row, column=col, value=h)
                c.fill = header_fill
                c.font = header_font
                c.alignment = center
                c.border = border

            # ── Data ──
            tong_cm = tong_vp = tong_vkp = tong_loi = 0
            row_i = header_row + 1
            for stt, ma in enumerate(sorted(self.HocSinh.keys()), 1):
                d = self.HocSinh[ma]
                w = self._du_lieu_tuan(ma, tuan)
                if not w: continue

                n_cm = n_vp = n_vkp = n_loi = 0
                ky_list = []
                for day in THU:
                    ky = self._ky_hieu_o(ma, day)
                    ky_list.append(ky)
                    if w["attendance"].get(day, False):
                        n_cm += 1
                    else:
                        r = w["reasons"].get(day, "").strip()
                        if r and r != ly_do_md:
                            n_vp += 1
                        else:
                            n_vkp += 1
                    if w["errors"].get(day, "").strip():
                        n_loi += 1

                row_data = ([stt, ma, d["name"], d["class"],
                             d.get("to", "") or "—", f"Tuần {tuan}"]
                            + ky_list
                            + [n_cm, n_vp, n_vkp, n_loi])

                for col, val in enumerate(row_data, 1):
                    c = ws.cell(row=row_i, column=col, value=val)
                    c.border = border
                    if col in (1, 2, 4, 5, 6) or col > 6:
                        c.alignment = center
                    else:
                        c.alignment = left

                    # Tô màu ký hiệu điểm danh
                    if 7 <= col <= 6 + len(THU):
                        ky = str(val)
                        if ky.startswith("✓"):   c.fill = fill_cm
                        elif ky.startswith("✗"): c.fill = fill_vp
                        elif ky.startswith("⊘"): c.fill = fill_vkp
                        elif ky.startswith("!"): c.fill = fill_err

                tong_cm  += n_cm
                tong_vp  += n_vp
                tong_vkp += n_vkp
                tong_loi += n_loi
                row_i += 1

            # ── Dòng tổng kết ──
            row_i += 1
            ws.cell(row=row_i, column=2, value="TỔNG").font = Font(bold=True)
            ws.cell(row=row_i, column=3,
                    value=f"{len(self.HocSinh)} HS").font = Font(bold=True)
            for col, val in enumerate([tong_cm, tong_vp, tong_vkp, tong_loi],
                                       start=6 + len(THU) + 1):
                c = ws.cell(row=row_i, column=col, value=val)
                c.font = Font(bold=True)
                c.alignment = center

            # ── Column widths ──
            widths = [5, 8, 22, 8, 6, 10] + [4] * len(THU) + [8, 10, 10, 6]
            for i, wd in enumerate(widths, 1):
                ws.column_dimensions[get_column_letter(i)].width = wd

            # ── Freeze header ──
            ws.freeze_panes = ws.cell(row=header_row + 1, column=1)

            wb.save(path)
            self.thong_bao(
                f"✓ Đã xuất Excel: {os.path.basename(path)}", self.XANH_LA)
        except Exception as e:
            self.thong_bao(f"✗ Lỗi xuất Excel: {e}", self.DO)

    # ─────────────────────────────────────────────────────
    def _xuat_xls_html(self):
        """Fallback: HTML table lưu đuôi .xls — Excel mở đẹp, có màu."""
        path = filedialog.asksaveasfilename(
            defaultextension=".xls",
            filetypes=[("Excel files", "*.xls"), ("All files", "*.*")],
            initialfile=f"diem_danh_tuan_{self.tuan_hien_tai}.xls")
        if not path: return

        ly_do_md = self.settings["ly_do_mac_dinh"]
        tuan = self.tuan_hien_tai

        def esc(s):
            return (str(s).replace("&", "&amp;")
                           .replace("<", "&lt;")
                           .replace(">", "&gt;"))

        def fill_of(ky):
            if ky.startswith("✓"):   return "#C6EFCE"
            if ky.startswith("✗"):   return "#FFEB9C"
            if ky.startswith("⊘"):   return "#FFC7CE"
            if ky.startswith("!"):   return "#FFD4A3"
            return ""

        try:
            parts = []
            parts.append('<html><head><meta charset="UTF-8">')
            parts.append('<style>')
            parts.append('table { border-collapse: collapse; '
                         'font-family: Calibri; font-size: 11pt; }')
            parts.append('th, td { border: 1px solid #999; '
                         'padding: 4px 6px; }')
            parts.append('th { background: #4472C4; color: white; '
                         'font-weight: bold; text-align: center; }')
            parts.append('td.c { text-align: center; }')
            parts.append('.title { font-size: 16pt; font-weight: bold; '
                         'color: #1F3864; }')
            parts.append('.meta { color: #666; font-style: italic; }')
            parts.append('</style></head><body>')

            parts.append(f'<p class="title">'
                         f'BẢNG ĐIỂM DANH — TUẦN {tuan}</p>')
            parts.append(f'<p class="meta">Ngày xuất: '
                         f'{datetime.now().strftime("%d/%m/%Y %H:%M")}</p>')

            parts.append('<table>')

            # Header
            parts.append('<tr>')
            for h, w in [("STT", 40), ("Mã", 60), ("Họ tên", 180),
                         ("Lớp", 60), ("Tổ", 40), ("Tuần", 70),
                         ("T2", 35), ("T3", 35), ("T4", 35), ("T5", 35),
                         ("T6", 35), ("T7", 35), ("CN", 35),
                         ("Có mặt", 60), ("Vắng phép", 70),
                         ("Vắng KP", 70), ("Lỗi", 50)]:
                parts.append(f'<th width="{w}">{h}</th>')
            parts.append('</tr>')

            # Data
            tong_cm = tong_vp = tong_vkp = tong_loi = 0
            for stt, ma in enumerate(sorted(self.HocSinh.keys()), 1):
                d = self.HocSinh[ma]
                w = self._du_lieu_tuan(ma, tuan)
                if not w: continue

                n_cm = n_vp = n_vkp = n_loi = 0
                cells = []
                for day in THU:
                    ky = self._ky_hieu_o(ma, day)
                    bg = fill_of(ky)
                    style = (f' style="background:{bg};text-align:center"'
                             if bg else ' class="c"')
                    cells.append(f'<td{style}>{esc(ky)}</td>')

                    if w["attendance"].get(day, False):
                        n_cm += 1
                    else:
                        r = w["reasons"].get(day, "").strip()
                        if r and r != ly_do_md:
                            n_vp += 1
                        else:
                            n_vkp += 1
                    if w["errors"].get(day, "").strip():
                        n_loi += 1

                parts.append('<tr>')
                parts.append(f'<td class="c">{stt}</td>')
                parts.append(f'<td class="c">{ma}</td>')
                parts.append(f'<td>{esc(d["name"])}</td>')
                parts.append(f'<td class="c">{esc(d["class"])}</td>')
                parts.append(f'<td class="c">'
                             f'{esc(d.get("to","")) or "—"}</td>')
                parts.append(f'<td class="c">Tuần {tuan}</td>')
                parts.extend(cells)
                parts.append(f'<td class="c">{n_cm}</td>')
                parts.append(f'<td class="c">{n_vp}</td>')
                parts.append(f'<td class="c">{n_vkp}</td>')
                parts.append(f'<td class="c">{n_loi}</td>')
                parts.append('</tr>')

                tong_cm  += n_cm
                tong_vp  += n_vp
                tong_vkp += n_vkp
                tong_loi += n_loi

            # Tổng kết
            parts.append('<tr style="background:#D9E1F2;font-weight:bold">')
            parts.append('<td colspan="2" class="c">TỔNG</td>')
            parts.append(f'<td colspan="4">{len(self.HocSinh)} HS</td>')
            parts.append(f'<td colspan="{len(THU)}"></td>')
            parts.append(f'<td class="c">{tong_cm}</td>')
            parts.append(f'<td class="c">{tong_vp}</td>')
            parts.append(f'<td class="c">{tong_vkp}</td>')
            parts.append(f'<td class="c">{tong_loi}</td>')
            parts.append('</tr>')

            parts.append('</table></body></html>')

            with open(path, "w", encoding="utf-8") as f:
                f.write("".join(parts))

            self.thong_bao(
                f"✓ Đã xuất Excel: {os.path.basename(path)}", self.XANH_LA)
        except Exception as e:
            self.thong_bao(f"✗ Lỗi xuất Excel: {e}", self.DO)

    # ═══ Auto-save ═══
    def _schedule_auto_save(self):
        ms = self.settings["auto_save_interval_s"] * 1000
        self.root.after(ms, self._auto_save_tick)

    def _auto_save_tick(self):
        if self._dirty and not self._saving:
            log_info("Auto-save...")
            self.luu_ngay()
        self._schedule_auto_save()

    def _start_progress(self):
        if self._progress_running: return
        self._progress_running = True
        self._progress_pos = 0
        self._progress_step()

    def _stop_progress(self):
        self._progress_running = False
        try: self.progress_bar.place_configure(width=0)
        except Exception: pass

    def _progress_step(self):
        if not self._progress_running: return
        try:
            w = self.progress_frame.winfo_width()
            if w <= 1: w = 800
        except Exception:
            w = 800
        bar_w = int(w * 0.28)
        self._progress_pos = (self._progress_pos + max(8, w // 60)) % (w + bar_w)
        x = self._progress_pos - bar_w
        try:
            self.progress_bar.place_configure(x=x, width=bar_w)
        except Exception:
            return
        self.root.after(16, self._progress_step)

    # ═══ Status ═══
    def thong_bao(self, msg, mau=None):
        color = mau or self.CHU_MO

        # Hủy typewriter cũ
        if self._tw_job:
            try: self.root.after_cancel(self._tw_job)
            except Exception: pass
            self._tw_job = None

        anim_on = self.settings.get("enable_animation", True)

        if not anim_on:
            self.thanh_trang_thai.config(text=msg, fg=color)
        else:
            # Typewriter: hiện từng ký tự
            chars = list(msg)
            try:
                self.thanh_trang_thai.config(text="", fg=color)
            except Exception:
                return

            def type_next(i):
                if i > len(chars):
                    self._tw_job = None
                    return
                try:
                    self.thanh_trang_thai.config(text="".join(chars[:i]))
                except Exception:
                    self._tw_job = None
                    return
                self._tw_job = self.root.after(12, lambda: type_next(i + 1))

            type_next(1)

        # Pulse nhẹ
        if anim_on:
            try:
                orig = self.thanh_trang_thai.cget("bg")
                pulse = "#3a3d55"
                def do_pulse():
                    animate_color(self.thanh_trang_thai, orig, pulse,
                                  duration=90, steps=5, attr="bg",
                                  on_done=lambda: animate_color(
                                      self.thanh_trang_thai, pulse, orig,
                                      duration=220, steps=8, attr="bg"))
                self.thanh_trang_thai.after(1, do_pulse)
            except Exception:
                pass
    
    # ═══════════════════════════════════════════════════════════
    # INLINE PANEL HELPER — dùng chung cho Settings / Thống kê / Lịch sử
    # ═══════════════════════════════════════════════════════════
    def _mo_panel_inline(self, card_w, card_h, accent, build_fn):
        """
        Mở panel nổi giữa cửa sổ: blur nền + shadow + card + glow-in.
        build_fn(card, close_fn) — vẽ UI vào card.
        """
        # Đóng panel cũ
        if self._settings_overlay is not None:
            fn = getattr(self, "_close_settings_fn", None)
            if fn:
                try: fn()
                except Exception: pass
            try: self.root.update_idletasks()
            except Exception: pass

        # ── Blur overlay ──
        self.root.update_idletasks()
        blur_ok = False
        if PIL_OK:
            try:
                rx = self.root.winfo_rootx()
                ry = self.root.winfo_rooty()
                rw = self.root.winfo_width()
                rh = self.root.winfo_height()
                img = ImageGrab.grab(bbox=(rx, ry, rx + rw, ry + rh))
                img = img.filter(ImageFilter.GaussianBlur(radius=12))
                img = img.convert("RGBA")
                dark = Image.new("RGBA", img.size, (10, 10, 20, 90))
                img = Image.alpha_composite(img, dark).convert("RGB")
                photo = ImageTk.PhotoImage(img)
                blur = tk.Label(self.root, image=photo,
                                borderwidth=0, highlightthickness=0)
                blur.image = photo
                blur.place(x=0, y=0, relwidth=1, relheight=1)
                blur.lift()
                self._settings_blur = blur
                blur_ok = True
            except Exception as e:
                log_warn(f"Blur panel fail: {e}")

        if not blur_ok:
            overlay = tk.Frame(self.root, bg="#1a1a26")
            overlay.place(x=0, y=0, relwidth=1, relheight=1)
            overlay.lift()
            self._settings_blur = overlay

        # ── Shadow ──
        shadow = tk.Frame(self.root, bg="#0a0a14")
        shadow.place(relx=0.5, rely=0.5, anchor="center",
                     width=card_w + 8, height=card_h + 8)
        shadow.lift()
        self._settings_shadow = shadow

        # ── Card ──
        card = tk.Frame(self.root, bg=self.NEN,
                        highlightthickness=2,
                        highlightbackground=accent)
        card.place(relx=0.5, rely=0.5, anchor="center",
                   width=card_w, height=card_h)
        card.pack_propagate(False)
        card.lift()
        self._settings_overlay = card
        self._settings_card_w  = card_w
        self._settings_card_h  = card_h

        # ── Close ──
        def close():
            for attr in ("_settings_cover", "_settings_overlay",
                         "_settings_shadow", "_settings_blur"):
                w = getattr(self, attr, None)
                if w is not None:
                    try: w.destroy()
                    except Exception: pass
                    setattr(self, attr, None)
            try: self.root.update_idletasks()
            except Exception: pass
        self._close_settings_fn = close

        # Bind background click / wheel
        self._settings_blur.bind("<Button-1>", lambda e: close())
        self._settings_blur.bind("<MouseWheel>", lambda e: "break")
        self._settings_blur.bind("<Button-4>",   lambda e: "break")
        self._settings_blur.bind("<Button-5>",   lambda e: "break")

        # ── Build nội dung ──
        build_fn(card, close)

        # ── Glow-in ──
        if self.settings.get("enable_animation", True):
            card.configure(highlightbackground=self.NEN)
            from_rgb = _hex_to_rgb(self.NEN)
            to_rgb   = _hex_to_rgb(accent)

            def glow(i=0, total=14):
                if i > total:
                    try: card.configure(highlightbackground=accent)
                    except Exception: pass
                    return
                k = i / total
                k = 1 - (1 - k) ** 3
                try:
                    rgb = tuple(_lerp(from_rgb[j], to_rgb[j], k)
                                for j in range(3))
                    card.configure(highlightbackground=_rgb_to_hex(rgb))
                except Exception:
                    return
                self.root.after(16, lambda: glow(i + 1, total))
            self.root.after(30, lambda: glow(0))
        else:
            try: card.configure(highlightbackground=accent)
            except Exception: pass

