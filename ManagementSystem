    def kiem_tra_cap_nhat(self, force=False):
        """Kiểm tra update. force=True → bỏ qua cooldown."""
        if not force and not self.settings.get("auto_check_update", True):
            return
        if not force:
            last = self.settings.get("last_update_check", 0)
            if _time.time() - last < UPDATE_CHECK_INTERVAL_S:
                return

        self.thong_bao("🔃 Đang kiểm tra cập nhật...", self.XANH_DUONG)

        def task():
            return fetch_remote_script()

        def on_done(remote):
            if remote:    # tải lỗi thì không khóa 6 giờ
                self.settings["last_update_check"] = _time.time()
                save_settings(self.settings)

            if not remote:
                if force:
                    self.thong_bao("⚠ Không kết nối được server cập nhật",
                                   self.VANG)
                return

            # So sánh hash file hiện tại với hash remote
            cur_hash = _get_self_hash()
            if cur_hash is None:
                if force:
                    self.thong_bao(
                        "⚠ Không đọc được file script — chạy từ .exe?",
                        self.VANG)
                return

            if _hash_str(remote) == cur_hash:
                if force:
                    self.thong_bao(
                        f"✓ Đã là phiên bản mới nhất (v{APP_VERSION})",
                        self.XANH_LA)
                return

            remote_ver = _parse_version(remote)
            if _version_tuple(remote_ver) <= _version_tuple(APP_VERSION):
                if force:
                    self.thong_bao(
                        f"✓ Không có bản mới hơn (máy v{APP_VERSION}, GitHub v{remote_ver})",
                        self.XANH_LA)
                return

            self._hien_dialog_cap_nhat(remote)

        self._async(task, on_success=on_done)

