            self.thong_bao("⚠ Chưa chọn HS nào", self.VANG); return
        ds_ma = [int(self.bang.item(i, "values")[0]) for i in sel]
        ds_ten = [self.HocSinh[s]["name"] for s in ds_ma if s in self.HocSinh]
        if not messagebox.askyesno("Xác nhận xóa",
            f"Xóa {len(ds_ma)} học sinh?\n\n" + "\n".join(f"• {n}" for n in ds_ten)):
            return
        self._snapshot(f"Xóa {len(ds_ma)} HS")
        for ma in ds_ma: self.HocSinh.pop(ma, None)
        self.cap_nhat_bang()
        self.cap_nhat_diem_danh()
        self._xoa_panel_ct()
        self.thong_bao(f"✓ Đã xóa {len(ds_ma)} HS (Ctrl+Z để hoàn tác)", self.XANH_LA)

    def luu_ngay(self):
        if self._saving:
            self.thong_bao("⏳ Đang lưu...", self.VANG)
            return
        self._saving = True
        self.thong_bao("💾 Đang pull → merge → push...", self.XANH_DUONG)

        # Snapshot để thread dùng (tránh race condition)
        local_snapshot = deepcopy(self.HocSinh)
        ly_do_md = self.settings["ly_do_mac_dinh"]

        def task():
            return ghi_file(local_snapshot, ly_do_md, DATA_FILE)

        def on_done(res):
            ok_local, ok_gh, err, merged = res
            self._saving = False
            self._dirty = False

            # Update UI với bản merged (nếu có)
            if merged is not None:
                self.HocSinh.clear()
                for k, v in merged.items():
                    self.HocSinh[k] = v
                self.cap_nhat_bang()
                self.cap_nhat_diem_danh()
                log_info(f"UI refresh với {len(self.HocSinh)} HS sau merge")

            n = len(self.HocSinh)
            if ok_local and ok_gh:
                self.thong_bao(f"✓ Pull-merge-push {n} HS lên GitHub", self.XANH_LA)
            elif ok_local:
                msg = f"✓ Local OK ({n} HS)"
                if GH_CONFIG:
                    msg += f" · ⚠ GitHub: {err or 'fail'}"
                self.thong_bao(msg, self.VANG)
            else:
                self.thong_bao("✗ Lỗi lưu — xem app.log", self.DO)

        def on_err(e):
            self._saving = False
            self.thong_bao(f"✗ Lỗi: {e}", self.DO)

        self._async(task, on_success=on_done, on_error=on_err)

