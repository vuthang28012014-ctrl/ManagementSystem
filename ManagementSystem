    def _build_settings_tab_changelog(self, parent):
        frame = tk.Frame(parent, bg=self.NEN)
        frame.pack(fill="both", expand=True)
        txt = tk.Text(frame, bg=self.NEN2, fg=self.CHU,
                       insertbackground=self.CHU, relief="flat",
                       font=("Consolas", 9), wrap="word",
                       padx=12, pady=10)
        sb = ttk.Scrollbar(frame, orient="vertical", command=txt.yview)
        txt.configure(yscrollcommand=sb.set)
        txt.pack(side="left", fill="both", expand=True)
        sb.pack(side="right", fill="y")
        txt.tag_configure("version", foreground=self.XANH_LA,
                          font=("Segoe UI", 12, "bold"))
        txt.tag_configure("date",    foreground=self.CHU_MO,
                          font=("Consolas", 8, "italic"))
        txt.tag_configure("section", foreground=self.TIM,
                          font=("Segoe UI", 10, "bold"))
        txt.tag_configure("item",    foreground=self.CHU,
                          font=("Consolas", 9))
        txt.tag_configure("sep",     foreground=self.NEN3)

        for i, (ver, date, items) in enumerate(CHANGELOG_ENTRIES):
            if i > 0:
                txt.insert("end", "\n" + "─" * 55 + "\n\n", "sep")
            txt.insert("end", f"{ver}\n", "version")
            txt.insert("end", f"  {date}\n\n", "date")
            for tag, line in items:
                txt.insert("end", line + "\n", tag)
        txt.config(state="disabled")

