    def xuat_excel_all(self):
        """Xuất báo cáo — LUÔN hỏi kỳ trước khi xuất."""
        if not self.HocSinh:
            self.thong_bao("⚠ Không có dữ liệu", self.VANG); return

        # ═══ BƯỚC 1: HỎI KỲ ═══
        period = self._chon_ky_thong_ke(
            parent_title="Chọn kỳ xuất báo cáo")
        if not period:
            return

        p_label  = _period_label(period)
        p_suffix = _period_suffix(period)
        self.thong_bao(f"📚 Đã chọn: {p_label}", self.XANH_DUONG)

        # ═══ BƯỚC 2: DISPATCH ═══
        fmt = self.settings.get("export_format", "excel")
        if fmt == "word":
            self._xuat_word_all(period=period)
            return
        if fmt == "pdf":
            self._xuat_pdf_all(period=period)
            return
        if fmt == "html":
            self.xuat_bao_cao_html(period=period)
            return

        # ═══ Excel ═══
        if not OPENPYXL_OK:
            messagebox.showwarning(
                "Cần openpyxl",
                "Tính năng xuất nhiều sheet cần thư viện openpyxl.\n\n"
                "Cài đặt: pip install openpyxl")
            return

        path = filedialog.asksaveasfilename(
            defaultextension=".xlsx",
            filetypes=[("Excel files", "*.xlsx"), ("All files", "*.*")],
            initialfile=f"bao_cao_{p_suffix}.xlsx")
        if not path: return

        hs_snapshot = deepcopy(self.HocSinh)
        ly_do_md = self.settings["ly_do_mac_dinh"]

        self._start_progress()
        self.thong_bao(f"⏳ Đang xuất Excel ({p_label})...", self.XANH_DUONG)

        def task():
            return _build_xlsx_all(hs_snapshot, path, ly_do_md, period)

        def on_done(ok):
            self._stop_progress()
            if ok:
                self.thong_bao(
                    f"✓ Đã xuất Excel: {os.path.basename(path)} ({p_label})",
                    self.XANH_LA)
            else:
                self.thong_bao("✗ Lỗi xuất — xem app.log", self.DO)

        def on_err(e):
            self._stop_progress()
            self.thong_bao(f"✗ Lỗi: {e}", self.DO)

        self._async(task, on_success=on_done, on_error=on_err)

