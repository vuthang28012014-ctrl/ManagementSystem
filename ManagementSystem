def github_commits(config, limit=30):
    """Lấy list commits của path. Trả list dict hoặc []."""
    if not URLLIB_OK or not config:
        return []
    owner, repo, branch, path = (config["owner"], config["repo"],
                                 config["branch"], config["path"])
    url = (f"https://api.github.com/repos/{owner}/{repo}/commits"
           f"?path={path}&sha={branch}&per_page={limit}")
    headers = {
        "Authorization": f"token {config['token']}",
        "Accept": "application/vnd.github.v3+json",
        "User-Agent": "ManagementSystem/2.0",
    }
    try:
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        out = []
        for c in data:
            out.append({
                "sha":    c["sha"],
                "short":  c["sha"][:7],
                "msg":    c["commit"]["message"],
                "author": c["commit"]["author"]["name"],
                "email":  c["commit"]["author"]["email"],
                "date":   c["commit"]["author"]["date"],
            })
        return out
    except urllib.error.HTTPError as e:
        log_error(f"Fetch commits HTTP {e.code}")
        return []
    except Exception as e:
        log_error(f"Fetch commits fail: {e}")
        return []


