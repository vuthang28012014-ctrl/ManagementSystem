        try: ma = int(ma_str)
        except ValueError:
            self.thong_bao("⚠ Mã phải là số nguyên", self.DO)
            self.o_ma.focus_set(); return
        if ma in self.HocSinh:
            self.thong_bao(f"⚠ Mã {ma} đã tồn tại", self.DO)
            self.o_ma.focus_set(); return

        self._snapshot(f"Thêm HS {ma}")
        self.HocSinh[ma] = {
            "name": ten, "class": lop,
            "weeks": tao_du_lieu_tat_ca_tuan(),
        }
        self.xoa_form()
        self.cap_nhat_bang()
        self.cap_nhat_diem_danh()
        self.thong_bao(f"✓ Đã thêm: {ten} (Mã {ma}, {lop})", self.XANH_LA)

