def loi_moi():       return {d: "" for d in THU}

def tuan_moi():
    return {"attendance": diem_danh_moi(),
            "reasons":    ly_do_moi(),
            "errors":     loi_moi()}

def tao_du_lieu_tat_ca_tuan():
    return {t: tuan_moi() for t in range(1, TONG_TUAN + 1)}

def phan_loai_o(att, reason, ly_do_md):
    """
    Phân loại 1 ô điểm danh:
      'cm'   có mặt
      'vp'   vắng có phép (lý do riêng)
      'vkp'  vắng không phép (lý do = lý do mặc định)
      'chua' chưa điểm danh (không tick, không lý do) -> KHÔNG tính thống kê
    """
    if att:
        return "cm"
    r = (reason or "").strip()
    if not r:
        return "chua"
    if r == ly_do_md:
        return "vkp"
    return "vp"


def migrate_unrecorded(hoc_sinh, ly_do_md):
    """
    Dữ liệu cũ: ghi_file từng tự điền lý do mặc định cho MỌI ô vắng,
    kể cả ngày chưa điểm danh. Hàm này trả các ô đó về 'chưa điểm danh':
      - Tuần mà không ai có mặt ngày nào và không ai có lý do riêng
        -> coi cả tuần là chưa điểm danh.
      - Ngày không học (CN): bỏ lý do mặc định.
    Trả về số ô đã sửa.
    """
    n_fix = 0
    tuan_set = set()
    for d in hoc_sinh.values():
        tuan_set.update(d.get("weeks", {}).keys())
    for t in tuan_set:
        tuan_trong = True
        for d in hoc_sinh.values():
            w = d.get("weeks", {}).get(t) or {}
            att = w.get("attendance", {})
            rea = w.get("reasons", {})
            for day in THU:
                if att.get(day, False):
                    tuan_trong = False
                    break
                r = (rea.get(day, "") or "").strip()
                if r and r != ly_do_md:
                    tuan_trong = False
                    break
            if not tuan_trong:
                break
        for d in hoc_sinh.values():
            w = d.get("weeks", {}).get(t)
            if not w:
                continue
            att = w.get("attendance", {})
            rea = w.get("reasons", {})
            for day in THU:
                if att.get(day, False):
                    continue
                r = (rea.get(day, "") or "").strip()
                if r == ly_do_md and (tuan_trong or day in NGAY_KHONG_HOC):
                    rea[day] = ""
                    n_fix += 1
    return n_fix


def _tuan_rong(w):
    """True nếu tuần không có dữ liệu gì (không cần lưu lên GitHub)."""
    if not isinstance(w, dict):
        return True
    if any(w.get("attendance", {}).values()):
        return False
    for key in ("reasons", "errors"):
        if any((v or "").strip() for v in w.get(key, {}).values()):
            return False
    return True


def _rut_gon_hs(info):
    """Bản HS để ghi file: bỏ các tuần trống cho file nhỏ gọn."""
    out = dict(info)
    out["weeks"] = {t: w for t, w in info.get("weeks", {}).items()
                    if not _tuan_rong(w)}
    return out


def ten_hoc_ky(tuan):
    return "Học kỳ 1" if tuan <= TUAN_HK1 else "Học kỳ 2"

def _get_weeks_for_period(period):
    """
    Trả list tuần tương ứng với period.
    Với month_N: nếu không có tuần nào trong khoảng → trả [] (caller tự xử).
    """
    if period == "year":
        return list(range(1, TONG_TUAN + 1))
    if period == "hk1":
        return list(range(1, min(TUAN_HK1, TONG_TUAN) + 1))
    if period == "hk2":
        return list(range(TUAN_HK1 + 1, TONG_TUAN + 1))
    if period.startswith("month_"):
        try:
            m = int(period.split("_")[1])
        except (ValueError, IndexError):
            return list(range(1, TONG_TUAN + 1))
        start = (m - 1) * 4 + 1
        end   = min(m * 4, TONG_TUAN)
        if start > TONG_TUAN:
            return []                       # ← tháng vượt phạm vi
        return list(range(start, end + 1))
    return list(range(1, TONG_TUAN + 1))


def _period_available(period) -> bool:
    """True nếu period có ít nhất 1 tuần dữ liệu."""
    return len(_get_weeks_for_period(period)) > 0


def _thang_lich(m):
    """Tháng học thứ m (1..9, 4 tuần/tháng) → tháng dương lịch (năm học bắt đầu tháng 9)."""
    try:
        return ((int(m) + 7) % 12) + 1
    except (ValueError, TypeError):
        return m


def _period_label(period):
    """Label tiếng Việt cho period."""
    if period == "year": return "CẢ NĂM"
    if period == "hk1":  return "HỌC KỲ 1"
    if period == "hk2":  return "HỌC KỲ 2"
    if period.startswith("month_"):
        return f"THÁNG {period.split('_')[1]}"
    return "CẢ NĂM"


def _period_suffix(period):
    """Suffix cho tên file."""
    if period == "year": return "ca_nam"
    if period == "hk1":  return "hoc_ky_1"
    if period == "hk2":  return "hoc_ky_2"
    if period.startswith("month_"):
        return f"thang_{_thang_lich(period.split('_')[1])}"
    return "ca_nam"

