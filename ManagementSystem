    def _on_data_loaded(self):
        """Callback khi load xong data (chạy trong main thread)."""
        n = self._data_load_result["n"]
        warns = self._data_load_result["warns"]
        err = self._data_load_result["err"]
        new_data = self._data_load_result.get("data") or {}

        # ── SWAP trong main thread — an toàn, không race ──
        if new_data:
            self.HocSinh.clear()
            self.HocSinh.update(new_data)
            log_info(f"✓ Đã swap {len(new_data)} HS vào UI state")
            # Base cho merge 3 chiều: bản vừa tải từ GitHub, hoặc bản đã lưu ở lần đồng bộ trước
            if LOADED_FROM_REMOTE:
                self._base = deepcopy(new_data)
            else:
                self._base = _load_base_data()
            if os.path.exists(PENDING_FILE) and not self.read_only:
                self._dirty = True      # còn dữ liệu chưa push → để auto-save đẩy lên
            # Migrate dữ liệu cũ: ô chưa điểm danh bị tự điền "Không phép"
            if not self.settings.get("migrated_unrecorded", False):
                n_fix = migrate_unrecorded(
                    self.HocSinh, self.settings["ly_do_mac_dinh"])
                if n_fix:
                    self._dirty = True
                    log_info(f"✓ Migrate: trả {n_fix} ô về chưa điểm danh")
                if not self.read_only:
                    self.settings["migrated_unrecorded"] = True
                    save_settings(self.settings)

        try:
            self.cap_nhat_bang()
            self.cap_nhat_diem_danh()
        except Exception as e:
            log_warn(f"Refresh after load fail: {e}")
        
        if err:
            self.thong_bao(f"✗ Lỗi tải data: {err}", self.DO)
            return
        
        gh_status = "GitHub ✓" if GH_CONFIG else "Local only"
        if n > 0:
            msg = f"Đã tải {n} HS · {gh_status}"
            if warns:
                msg += f" · ⚠ {len(warns)} cảnh báo"
            self.thong_bao(msg, self.XANH_LA)
        else:
            self.thong_bao(f"Chưa có dữ liệu · {gh_status}", self.CHU_MO)

