        tv_frame = tk.Frame(card, bg=self.NEN)
        tv_frame.pack(fill="x", expand=False, padx=10, pady=(0, 6))
        cols = ("time", "author", "msg", "sha")
        tv = ttk.Treeview(tv_frame, columns=cols,
