    # ═══ Tìm kiếm ═══
    def _schedule_filter(self):
        if self._debounce_job:
            self.root.after_cancel(self._debounce_job)
        ms = self.settings["filter_debounce_ms"]
        self._debounce_job = self.root.after(ms, self._apply_filter)

    def _apply_filter(self):
        self._debounce_job = None
        self.cap_nhat_bang()

    def _thoa_filter(self, ma, d):
        q = self.bien_tim_kiem.get().strip().lower()
        if q:
            if not (q in str(ma).lower()
                    or q in str(d["name"]).lower()
                    or q in str(d["class"]).lower()):
                return False
        if self.bien_tim_ma is not None:
            m = self.bien_tim_ma.get().strip()
            if m and m not in str(ma): return False
        if self.bien_tim_ten is not None:
            t = self.bien_tim_ten.get().strip().lower()
            if t and t not in str(d["name"]).lower(): return False
        if self.bien_tim_lop is not None:
            l = self.bien_tim_lop.get().strip().lower()
            if l and l not in str(d["class"]).lower(): return False
        if self.bien_tim_to is not None:
            to_q = self.bien_tim_to.get().strip()
            if to_q and to_q != str(d.get("to", "")).strip(): return False
        return True

    def _co_filter(self):
        return bool(
            self.bien_tim_kiem.get().strip()
            or (self.bien_tim_ma  and self.bien_tim_ma.get().strip())
            or (self.bien_tim_ten and self.bien_tim_ten.get().strip())
            or (self.bien_tim_lop and self.bien_tim_lop.get().strip())
            or (self.bien_tim_to  and self.bien_tim_to.get().strip())
        )

    def tim_kiem(self):
        self._apply_filter()
        ds_khop = [ma for ma, d in self.HocSinh.items() if self._thoa_filter(ma, d)]

        if not ds_khop:
            self.thong_bao("⚠ Không tìm thấy HS nào khớp", self.VANG)
            try: self.bang.selection_remove(self.bang.selection())
            except Exception: pass
            try: self.bang_dd.selection_remove(self.bang_dd.selection())
            except Exception: pass
            self.cap_nhat_diem_danh()
            return

        iids = [str(ma) for ma in ds_khop]
        try: self.bang.selection_set(iids)
        except Exception: pass
        first = ds_khop[0]
        try:
            self.bang.see(str(first)); self.bang.focus(str(first))
        except Exception: pass

        self.cap_nhat_diem_danh()

        try: self.bang_dd.selection_set(iids)
        except Exception: pass
        try:
            self.bang_dd.see(str(first)); self.bang_dd.focus(str(first))
        except Exception: pass

        if len(ds_khop) == 1:
            d = self.HocSinh[first]
            self.tieu_de_ct.config(
                text=f"👁 Đã chọn: {d['name']} ({d['class']}) — Mã {first}",
                fg=self.XANH_DUONG, font=("Segoe UI", 10, "bold"))
        else:
            self.tieu_de_ct.config(
                text=f"👁 Tìm thấy {len(ds_khop)} HS. Đã chọn tất cả.",
                fg=self.XANH_DUONG, font=("Segoe UI", 10, "bold"))

        if len(ds_khop) == 1:
            self.thong_bao(f"✓ Đã chọn: {self.HocSinh[first]['name']}", self.XANH_LA)
        else:
            self.thong_bao(f"✓ Đã chọn {len(ds_khop)} HS ở cả 2 bảng", self.XANH_LA)

    def xoa_loc(self):
        self.bien_tim_kiem.set("")
        if self.bien_tim_ma:  self.bien_tim_ma.set("")
        if self.bien_tim_ten: self.bien_tim_ten.set("")
        if self.bien_tim_lop: self.bien_tim_lop.set("")
        if self.bien_tim_to:  self.bien_tim_to.set("")
        self.cap_nhat_bang()
        self.thong_bao("Đã xóa filter", self.CHU_MO)

    # ═══ Bảng HS ═══
    def cap_nhat_bang(self):
        for item in self.bang.get_children(): self.bang.delete(item)
        rows = [(ma, d["name"], d["class"], str(d.get("to", "")))
                for ma, d in self.HocSinh.items() if self._thoa_filter(ma, d)]
        key = self.khoa_sap_xep
        if key == "ma":
            rows.sort(key=lambda r: r[0], reverse=self.dao_sap_xep)
        elif key == "ten":
            rows.sort(key=lambda r: r[1].lower(), reverse=self.dao_sap_xep)
        elif key == "lop":
            rows.sort(key=lambda r: r[2].lower(), reverse=self.dao_sap_xep)
        elif key == "to":
            # Sắp xếp tổ: số trước (1,2,3,4), rỗng sau cùng
            def _to_key(r):
                to = r[3]
                return (1, "") if not to else (0, int(to) if to.isdigit() else 999)
            rows.sort(key=_to_key, reverse=self.dao_sap_xep)
        else:
            rows.sort(key=lambda r: r[2].lower(), reverse=self.dao_sap_xep)

        for i, (ma, ten, lop, to) in enumerate(rows):
            tag = "le" if i % 2 else "chan"
            to_disp = to if to else "—"
            self.bang.insert("", "end", iid=str(ma),
                             values=(ma, ten, lop, to_disp), tags=(tag,))

        self.nhan_tong.config(text=f"Tổng: {len(self.HocSinh)}")
        if self.nhan_ket_qua is not None:
            if self._co_filter():
                self.nhan_ket_qua.config(
                    text=f"Tìm thấy: {len(rows)}/{len(self.HocSinh)} HS",
                    fg=self.XANH_LA)
            else:
                self.nhan_ket_qua.config(text="")

    def sap_xep(self, key):
        if self.khoa_sap_xep == key:
            self.dao_sap_xep = not self.dao_sap_xep
        else:
            self.khoa_sap_xep = key; self.dao_sap_xep = False
        self.settings["sort_key"]  = self.khoa_sap_xep
        self.settings["sort_desc"] = self.dao_sap_xep
        save_settings(self.settings)
        self.cap_nhat_bang()

    # ═══ Ký hiệu ═══
    def _ky_hieu_o(self, ma, day):
        w = self._du_lieu_tuan(ma)
        if not w: return ""
        if w["attendance"].get(day, False):
            base = "✓"
        else:
            reason = w["reasons"].get(day, "").strip()
            base = "✗" if (reason and reason != self.settings["ly_do_mac_dinh"]) else "⊘"
        err = w["errors"].get(day, "").strip()
        return f"{base}!" if err else base

    def cap_nhat_diem_danh(self):
        for item in self.bang_dd.get_children(): self.bang_dd.delete(item)
        ds_ma = sorted(self.HocSinh.keys(),
                       key=lambda s: self.HocSinh[s]["name"].lower())
        sel = self.bang.selection()
        ma_da_chon = [int(self.bang.item(i, "values")[0]) for i in sel] if sel else None

        for ma in ds_ma:
            d = self.HocSinh[ma]
            ten_hien = d["name"]
            to_str = f"T{d['to']} · " if d.get("to") else ""
            tag = ()
            if ma_da_chon and ma not in ma_da_chon:
                ten_hien = f"· {d['name']}"
            elif ma_da_chon and ma in ma_da_chon:
                tag = ("focus",)
            vals = [f"{to_str}{ten_hien} ({d['class']})"] + \
                   [self._ky_hieu_o(ma, day) for day in THU]
            self.bang_dd.insert("", "end", iid=str(ma), values=vals, tags=tag)

        tong = len(ds_ma)
        if ma_da_chon:
            self.nhan_tom_tat.config(text=f"Đang xem {len(ma_da_chon)}/{tong} · Tuần {self.tuan_hien_tai}")
        else:
            self.nhan_tom_tat.config(text=f"{tong} HS · Tuần {self.tuan_hien_tai}")

    def _cap_nhat_hang_dd(self, ma):
        d = self.HocSinh.get(ma)
        if not d: return
        to_str = f"T{d['to']} · " if d.get("to") else ""
        vals = [f"{to_str}{d['name']} ({d['class']})"] + \
               [self._ky_hieu_o(ma, day) for day in THU]
        try: self.bang_dd.item(str(ma), values=vals)
        except Exception: pass

    # ═══ Click handlers ═══
    def _xac_dinh_o(self, x, y):
        if self.bang_dd.identify("region", x, y) != "cell": return None
        row_id = self.bang_dd.identify_row(y)
        if not row_id: return None
        col_id = self.bang_dd.identify_column(x)
        col_idx = int(col_id[1:]) - 1
        col_name = COT_DIEMDANH[col_idx]
        if col_name == COT_TEN: return None
        return (int(row_id), col_name)

    def click_diem_danh(self, event):
        x, y = event.x, event.y
        if self.hen_gio_click:
            self.root.after_cancel(self.hen_gio_click)
        ms = self.settings["click_delay_ms"]
        self.hen_gio_click = self.root.after(
            ms, lambda: self._xu_ly_click_don(x, y))

    def _xu_ly_click_don(self, x, y):
        self.hen_gio_click = None
        cell = self._xac_dinh_o(x, y)
        if cell is None: return
        self._hien_thi_panel_ct(*cell)

    def double_click_diem_danh(self, event):
        if self.hen_gio_click:
            self.root.after_cancel(self.hen_gio_click)
            self.hen_gio_click = None
        cell = self._xac_dinh_o(event.x, event.y)
        if cell is None: return
        self._doi_trang_thai(*cell)

    def _doi_trang_thai(self, ma, day):
        if not self._can_write(): return          # ← THÊM DÒNG NÀY
        if not self._tuan_co_the_sua():
            self.thong_bao(
                f"⚠ Tuần {self.tuan_hien_tai} đã khóa (max={self.settings['max_editable_week']})",
                self.DO)
            self._pulse_locked(ma)
            return
        w = self._du_lieu_tuan(ma)
        if not w: return
        self._snapshot(f"Đổi trạng thái {ma}/{day}")
        d = self.HocSinh[ma]
        new_val = not w["attendance"].get(day, False)
        w["attendance"][day] = new_val
        if new_val:
            w["reasons"][day] = ""
            self.thong_bao(f"✓ {d['name']} — T{self.tuan_hien_tai} {day}: Có mặt", self.XANH_LA)
        else:
            w["reasons"][day] = self.settings["ly_do_mac_dinh"]
            self.thong_bao(f"⊘ {d['name']} — T{self.tuan_hien_tai} {day}: "
                            f"{self.settings['ly_do_mac_dinh']}", self.DO)
        self._cap_nhat_hang_dd(ma)
        self._hien_thi_panel_ct(ma, day)

        # ── Animation: flash row ──
        if self.settings.get("enable_animation", True):
            color = "#4a5b3f" if new_val else "#4a3f3f"
            flash_row(self.bang_dd, str(ma), color=color, duration=380)

    def _hien_thi_panel_ct(self, ma, day):
        w = self._du_lieu_tuan(ma)
        if not w: return
        self._slide_up_panel_ct()          # ← THÊM
        d = self.HocSinh[ma]
        self.o_hien_tai = (ma, day)
