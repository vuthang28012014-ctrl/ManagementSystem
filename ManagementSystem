def _norm_text(s):
    """Chuẩn hóa mọi kiểu xuống dòng về \\n (LF)."""
    s = re.sub(r"\r+\n", "\n", s)
    return s.replace("\r", "\n")

def _get_self_path():
    """
    Dò đường dẫn file script .py đang chạy.
    Thử theo thứ tự:
      1. settings.json → script_path (người dùng đã chỉ định)
      2. __file__ (chạy từ source bình thường)
      3. Cạnh file .exe / cạnh DATA_FILE, tên quanly.py
      4. Cạnh DATA_FILE, tên ManagementSystem.py / .pyw
    Trả str (absolute path) hoặc None.
    """
    # ── 1. Ưu tiên settings nếu người dùng đã chốt path ──
    try:
        if os.path.exists(SETTINGS_FILE):
            with open(SETTINGS_FILE, "r", encoding="utf-8") as f:
                s = json.load(f)
            sp = (s.get("script_path") or "").strip()
            if sp and os.path.exists(sp) and os.path.isfile(sp):
                return os.path.abspath(sp)
    except Exception:
        pass

    # ── 2. __file__ (chạy source bình thường) ──
    try:
        p = os.path.abspath(__file__)
        if os.path.exists(p) and p.endswith(".py"):
            return p
    except NameError:
        pass
    except Exception:
        pass

    # ── 3. Dò cạnh SCRIPT_DIR (thư mục chứa .exe hoặc file .py này) ──
    candidates = [
        "quanly.py",
        "quanly.pyw",
        "ManagementSystem.py",
        "ManagementSystem.pyw",
        "main.py",
    ]
    for name in candidates:
        p = os.path.join(SCRIPT_DIR, name)
        if os.path.exists(p) and os.path.isfile(p):
            # Ghi nhớ để lần sau khỏi dò
            _remember_script_path(p)
            return p

    # ── 4. Dò cạnh DATA_FILE (nếu khác SCRIPT_DIR) ──
    data_dir = os.path.dirname(os.path.abspath(DATA_FILE))
    if data_dir != SCRIPT_DIR:
        for name in candidates:
            p = os.path.join(data_dir, name)
            if os.path.exists(p) and os.path.isfile(p):
                _remember_script_path(p)
                return p

    return None


def _remember_script_path(path):
    """Lưu path script vào settings.json để lần sau dùng luôn."""
    try:
        s = {}
        if os.path.exists(SETTINGS_FILE):
            with open(SETTINGS_FILE, "r", encoding="utf-8") as f:
                s = json.load(f) or {}
        if s.get("script_path") != path:
            s["script_path"] = path
            with open(SETTINGS_FILE, "w", encoding="utf-8") as f:
                json.dump(s, f, indent=2, ensure_ascii=False)
            log_info(f"✓ Đã lưu script_path = {path}")
    except Exception as e:
        log_warn(f"Remember script path fail: {e}")


def _get_self_hash():
    """SHA256 của file script (đã normalize CRLF→LF)."""
    p = _get_self_path()
    if not p or not os.path.exists(p):
        return None
    try:
        with open(p, "rb") as f:
            txt = f.read().decode("utf-8", errors="replace")
        return hashlib.sha256(_norm_text(txt).encode("utf-8")).hexdigest()
    except Exception as e:
        log_warn(f"Hash self fail: {e}")
        return None


def _version_tuple(v):
    """'2.10' -> (2, 10). Không đọc được -> (0,)."""
    parts = []
    for p in str(v).split("."):
        try:
            parts.append(int(p))
        except ValueError:
            parts.append(0)
    return tuple(parts)


def _hash_str(s):
    return hashlib.sha256(_norm_text(s).encode("utf-8")).hexdigest()


def _parse_version(content):
    """Tìm APP_VERSION trong content. Trả str hoặc '?'."""
    import re
    m = re.search(r'APP_VERSION\s*=\s*["\']([^"\']+)["\']', content)
    return m.group(1) if m else "?"


def fetch_remote_script(timeout=20):
    """Tải script từ UPDATE_URL. Trả string hoặc None."""
    if not URLLIB_OK:
        return None
    try:
        headers = {
            "User-Agent": f"ManagementSystem/{APP_VERSION}",
            "Cache-Control": "no-cache",
        }
        if GH_CONFIG and GH_CONFIG.get("token"):
            headers["Authorization"] = f"token {GH_CONFIG['token']}"
        req = urllib.request.Request(UPDATE_URL, headers=headers)
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.read().decode("utf-8", errors="replace")
    except urllib.error.HTTPError as e:
        log_warn(f"Fetch update HTTP {e.code}")
        return None
    except Exception as e:
        log_warn(f"Fetch update fail: {e}")
        return None

def _fix_double_newlines(text):
    """
    Gộp dòng trống xen kẽ sinh ra do copy từ Word / web chat / markdown render.
    Chỉ gọi khi đã xác định file bị lỗi (ratio dòng trống > 35%).
    
    Logic: nếu dòng hiện tại KHÔNG trống, dòng ngay sau TRỐNG, 
    và dòng sau nữa KHÔNG trống → bỏ dòng trống đó.
    Dòng trống giữa các block (2+ dòng trống liên tiếp) sẽ được giữ.
    """
    lines = text.split("\n")
    result = []
    i = 0
    n = len(lines)
    while i < n:
        result.append(lines[i])
        if (i + 2 < n
                and lines[i].strip() != ""
                and lines[i + 1].strip() == ""
                and lines[i + 2].strip() != ""):
            i += 2   # bỏ dòng trống xen kẽ
        else:
            i += 1
    cleaned = "\n".join(result)
    # Gộp 3+ dòng trống liên tiếp thành 2 (chuẩn PEP8)
    import re as _re
    cleaned = _re.sub(r"\n{4,}", "\n\n\n", cleaned)
    return cleaned

def _save_base_text(text):
