        if not self.HocSinh:
            self.thong_bao("⚠ Không có dữ liệu", self.VANG); return

        if period is None:
            period = self._chon_ky_thong_ke(parent_title="Chọn kỳ xuất HTML")
            if not period: return

        p_label  = _period_label(period)
        p_suffix = _period_suffix(period)
        
        path = filedialog.asksaveasfilename(
            defaultextension=".html",
            filetypes=[("HTML files", "*.html"), ("All files", "*.*")],
            initialfile=f"bao_cao_{p_suffix}.html")
        if not path: return

        hs_snapshot = deepcopy(self.HocSinh)
        ly_do_md = self.settings["ly_do_mac_dinh"]

        self._start_progress()
        self.thong_bao(f"⏳ Đang xuất HTML ({p_label})...", self.XANH_DUONG)

        def task():
            return _build_html_report(hs_snapshot, path, ly_do_md,
                                       tuan=None, period=period)

        def on_done(ok):
            self._stop_progress()
            if ok:
                self.thong_bao(
                    f"✓ Đã xuất HTML: {os.path.basename(path)} ({p_label})",
                    self.XANH_LA)
                self._mo_file_bang_os(path)
            else:
                self.thong_bao("✗ Lỗi xuất HTML — xem app.log", self.DO)

        def on_err(e):
            self._stop_progress()
            self.thong_bao(f"✗ Lỗi: {e}", self.DO)

        self._async(task, on_success=on_done, on_error=on_err)

