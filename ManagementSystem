        ws_chart["A1"].alignment = Alignment(horizontal="center")
        ws_chart.merge_cells("A1:P1")
        ws_chart.row_dimensions[1].height = 30

        # ═══ LINE CHART — 1 đường smooth, không marker rối ═══
