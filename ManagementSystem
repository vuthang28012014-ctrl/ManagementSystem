def _svg_donut(cx, cy, r, thickness, segments,
               center_text="", center_sub=""):
    """Donut chart SVG. segments = [(value, color), ...]."""
    total = sum(v for v, _ in segments)
    if total <= 0:
        return ""

    circ_parts = []
    cum = 0.0
    for value, color in segments:
        pct = value / total * 100
        circ_parts.append(
            f'<circle cx="{cx}" cy="{cy}" r="{r}" fill="none" '
            f'stroke="{color}" stroke-width="{thickness}" '
            f'pathLength="100" '
            f'stroke-dasharray="{pct:.4f} 100" '
            f'stroke-dashoffset="{-cum:.4f}" '
            f'transform="rotate(-90 {cx} {cy})"/>'
        )
        cum += pct

    size = cx * 2
    svg = [f'<svg xmlns="http://www.w3.org/2000/svg" '
           f'width="{size}" height="{size}" '
           f'viewBox="0 0 {size} {size}" '
           f'style="display:block">']
    svg.extend(circ_parts)
    if center_text:
        svg.append(
            f'<text x="{cx}" y="{cy}" text-anchor="middle" '
            f'font-size="26" font-weight="700" fill="#1F3864" '
            f'dominant-baseline="middle">{center_text}</text>')
    if center_sub:
        svg.append(
            f'<text x="{cx}" y="{cy+26}" text-anchor="middle" '
            f'font-size="11" fill="#888">{center_sub}</text>')
    svg.append('</svg>')
    return "".join(svg)


def _svg_line_chart(points, width=900, height=280):
    """Line chart SVG. points = [(label, value_0_to_100), ...]."""
    if not points:
        return ""

    pl, pt, pr, pb = 50, 20, 30, 40
    plot_w = width - pl - pr
    plot_h = height - pt - pb

    svg = [f'<svg xmlns="http://www.w3.org/2000/svg" '
           f'width="{width}" height="{height}" '
           f'viewBox="0 0 {width} {height}" '
           f'style="display:block;max-width:100%;height:auto">']

    # Plot area
    svg.append(f'<rect x="{pl}" y="{pt}" width="{plot_w}" height="{plot_h}" '
               f'fill="#FAFBFC" stroke="#E5E7EB" rx="4"/>')

    # Grid
    for pct in (0, 25, 50, 75, 100):
        y = pt + plot_h * (1 - pct / 100)
        svg.append(f'<line x1="{pl}" y1="{y:.1f}" '
                   f'x2="{pl+plot_w}" y2="{y:.1f}" '
                   f'stroke="#E5E7EB" stroke-width="1"/>')
        svg.append(f'<text x="{pl-6}" y="{y+4:.1f}" text-anchor="end" '
                   f'font-size="10" fill="#888">{pct}%</text>')

    n = len(points)
    coords = []
    for i, (_, v) in enumerate(points):
        x = pl + plot_w * i / (n - 1) if n > 1 else pl + plot_w / 2
        y = pt + plot_h * (1 - min(100, max(0, v)) / 100)
        coords.append((x, y))

    # Area under
    if n > 1:
        area_path = f'M {coords[0][0]:.1f},{pt+plot_h:.1f} '
        for x, y in coords:
            area_path += f'L {x:.1f},{y:.1f} '
        area_path += f'L {coords[-1][0]:.1f},{pt+plot_h:.1f} Z'
        svg.append(f'<path d="{area_path}" fill="#89B4FA" '
                   f'fill-opacity="0.25"/>')

        line_path = 'M ' + ' L '.join(
            f'{x:.1f},{y:.1f}' for x, y in coords)
        svg.append(f'<path d="{line_path}" fill="none" '
                   f'stroke="#1E66F5" stroke-width="2.5" '
                   f'stroke-linejoin="round" stroke-linecap="round"/>')

    # Points + x labels
    for i, (x, y) in enumerate(coords):
        svg.append(f'<circle cx="{x:.1f}" cy="{y:.1f}" r="3.5" '
                   f'fill="white" stroke="#1E66F5" stroke-width="2"/>')
        if n <= 20 or i % 5 == 0 or i == n - 1:
            svg.append(f'<text x="{x:.1f}" y="{pt+plot_h+16}" '
                       f'text-anchor="middle" font-size="9" fill="#666">'
                       f'{points[i][0]}</text>')

    svg.append('</svg>')
    return "".join(svg)


def _svg_bar_chart(items, width=900, row_h=30):
    """Horizontal bar chart SVG. items = [(label, rate, color), ...]."""
    if not items:
        return ""

    label_w = 110
    value_w = 90
    bar_max = max(200, width - label_w - value_w)
    height = 20 + len(items) * row_h + 20

    svg = [f'<svg xmlns="http://www.w3.org/2000/svg" '
           f'width="{width}" height="{height}" '
           f'viewBox="0 0 {width} {height}" '
           f'style="display:block;max-width:100%;height:auto">']

    # Grid lines
    for pct in (0, 25, 50, 75, 100):
        x = label_w + bar_max * pct / 100
        svg.append(f'<line x1="{x:.1f}" y1="10" '
                   f'x2="{x:.1f}" y2="{height-20}" '
                   f'stroke="#E5E7EB" stroke-width="1"/>')
        svg.append(f'<text x="{x:.1f}" y="{height-8}" '
                   f'text-anchor="middle" font-size="9" fill="#888">'
                   f'{pct}%</text>')

    for i, (label, rate, color) in enumerate(items):
        y = 20 + i * row_h
        # Label
        svg.append(f'<text x="{label_w-8}" y="{y+row_h/2+4:.1f}" '
                   f'text-anchor="end" font-size="11" fill="#1a1a1a" '
                   f'font-weight="600">{xml_escape(str(label))}</text>')
        # Track
        svg.append(f'<rect x="{label_w}" y="{y+6:.1f}" '
                   f'width="{bar_max}" height="{row_h-12:.1f}" '
                   f'fill="#F0F4FA" rx="3"/>')
        # Bar
        bw = bar_max * min(100, max(0, rate)) / 100
        if bw > 0:
            svg.append(f'<rect x="{label_w}" y="{y+6:.1f}" '
                       f'width="{bw:.1f}" height="{row_h-12:.1f}" '
                       f'fill="{color}" rx="3"/>')
        # Value
        svg.append(f'<text x="{label_w+bar_max+10:.1f}" '
                   f'y="{y+row_h/2+4:.1f}" '
                   f'font-size="12" fill="{color}" font-weight="700">'
                   f'{rate:.1f}%</text>')

    svg.append('</svg>')
    return "".join(svg)

def _svg_bar_chart_vertical(items, width=900, height=280,
                             color="#F97316", show_labels_mod=5):
    """Vertical bar chart. items = [(label, value_0_to_100), ...]."""
    if not items:
        return ""

    pl, pt, pr, pb = 50, 20, 30, 50
    plot_w = width - pl - pr
    plot_h = height - pt - pb
    n = len(items)

    svg = [f'<svg xmlns="http://www.w3.org/2000/svg" '
           f'width="{width}" height="{height}" '
           f'viewBox="0 0 {width} {height}" '
           f'style="display:block;max-width:100%;height:auto">']

    # Plot area
    svg.append(f'<rect x="{pl}" y="{pt}" width="{plot_w}" '
               f'height="{plot_h}" fill="#FAFBFC" '
               f'stroke="#E5E7EB" rx="4"/>')

    # Grid ngang
    for pct in (0, 25, 50, 75, 100):
        y = pt + plot_h * (1 - pct / 100)
        svg.append(f'<line x1="{pl}" y1="{y:.1f}" '
                   f'x2="{pl+plot_w}" y2="{y:.1f}" '
                   f'stroke="#E5E7EB" stroke-width="1"/>')
        svg.append(f'<text x="{pl-6}" y="{y+4:.1f}" '
                   f'text-anchor="end" font-size="10" '
                   f'fill="#888">{pct}%</text>')

    gap = plot_w / n
    bar_w = gap * 0.7

    for i, (label, value) in enumerate(items):
        x = pl + gap * i + gap * 0.15
        h = plot_h * min(100, max(0, value)) / 100
        y = pt + plot_h - h

        # Bar (không vẽ nếu value = 0)
        if h > 0:
            svg.append(f'<rect x="{x:.1f}" y="{y:.1f}" '
                       f'width="{bar_w:.1f}" height="{h:.1f}" '
                       f'fill="{color}" rx="2"/>')

        # X label — chỉ hiện 1 số tuần để không rối
        if i % show_labels_mod == 0 or i == n - 1:
            svg.append(f'<text x="{x + bar_w/2:.1f}" '
                       f'y="{pt+plot_h+16}" text-anchor="middle" '
                       f'font-size="9" fill="#666">{label}</text>')

        # Value trên đầu cột (chỉ khi cột đủ cao và ít điểm)
        if value > 0 and n <= 20:
            svg.append(f'<text x="{x + bar_w/2:.1f}" y="{y-4:.1f}" '
                       f'text-anchor="middle" font-size="9" '
                       f'fill="{color}" font-weight="600">'
                       f'{value:.1f}%</text>')

    svg.append('</svg>')
    return "".join(svg)

