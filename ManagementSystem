    def _tao_nut(self, parent, text, cmd, bg, hover):
        fg = "#1e1e2e" if bg not in (self.NEN3, self.NEN2) else self.CHU
        b = tk.Button(parent, text=text, command=cmd,
                      bg=bg, fg=fg, activebackground=hover, activeforeground=fg,
                      relief="flat", cursor="hand2",
                      font=("Segoe UI", 10, "bold"), bd=0)

        anim_on = self.settings.get("enable_animation", True)

        if not anim_on:
            b.bind("<Enter>", lambda e: b.configure(bg=hover))
            b.bind("<Leave>", lambda e: b.configure(bg=bg))
            return b

        def on_enter(e):
            if getattr(b, "_anim_busy", False): return
            b._anim_busy = True
            animate_color(b, bg, hover, duration=140, steps=7, attr="bg",
                          on_done=lambda: setattr(b, "_anim_busy", False))

        def on_leave(e):
            if getattr(b, "_anim_busy", False): return
            b._anim_busy = True
            animate_color(b, hover, bg, duration=180, steps=7, attr="bg",
                          on_done=lambda: setattr(b, "_anim_busy", False))

        b.bind("<Enter>", on_enter)
        b.bind("<Leave>", on_leave)
        return b

    # ═══ Undo/Redo ═══
    def _snapshot(self, label):
        snap = deepcopy(self.HocSinh)
        self.undo_stack.push(snap, label)
        self._dirty = True

    def undo(self):
        if not self.undo_stack.can_undo():
            self.thong_bao("Không có gì để undo", self.CHU_MO); return
        cur_snap = deepcopy(self.HocSinh)
        snap, label, _ = self.undo_stack.do_undo()
        self.undo_stack.push_redo(cur_snap, label)
        self.HocSinh = snap
        self._xoa_panel_ct()
        self.cap_nhat_bang()
        self.cap_nhat_diem_danh()
        self.thong_bao(f"↩ Undo: {label}", self.VANG)

    def redo(self):
        if not self.undo_stack.can_redo():
            self.thong_bao("Không có gì để redo", self.CHU_MO); return
        cur_snap = deepcopy(self.HocSinh)
        snap, label, _ = self.undo_stack.do_redo()
        self.undo_stack.push(cur_snap, label)
        self.HocSinh = snap
        self._xoa_panel_ct()
        self.cap_nhat_bang()
        self.cap_nhat_diem_danh()
        self.thong_bao(f"↪ Redo: {label}", self.XANH_LA)

    # ═══ GitHub Actions ═══
    def keo_github(self):
        global GH_CONFIG
        if not GH_CONFIG:
            self.thong_bao("⚠ Chưa có github_config.json", self.VANG); return

        if self.HocSinh:
            ok = messagebox.askyesno(
                "Xác nhận",
                "Tải data mới từ GitHub sẽ GHI ĐÈ data hiện tại.\n"
                "Mọi thay đổi chưa Save sẽ MẤT.\n\nTiếp tục?")
            if not ok: return

        self.thong_bao("☁ Đang tải từ GitHub...", self.XANH_DUONG)

        def task():
            return github_fetch(GH_CONFIG)

        def on_done(content):
            if not content:
                self.thong_bao("✗ Không tải được từ GitHub", self.DO); return
            try:
                raw = json.loads(content)
            except Exception as e:
                self.thong_bao(f"✗ Data GitHub hỏng: {e}", self.DO); return

            # Backup trước khi ghi đè
            _backup_file(DATA_FILE, keep=self.settings["backup_count"])

            self._snapshot("Pull GitHub")
            self.HocSinh.clear()

            for sid_str, info in raw.items():
                if sid_str == "_meta":
                    continue
                try: sid = int(sid_str)
                except ValueError: continue
                if "weeks" not in info:
                    info["weeks"] = tao_du_lieu_tat_ca_tuan()
                    info["weeks"][1]["attendance"] = info.get("attendance", diem_danh_moi())
                    info["weeks"][1]["reasons"]    = info.get("reasons",    ly_do_moi())
                    info["weeks"][1]["errors"]     = info.get("errors",     loi_moi())
                    for k in ("attendance", "reasons", "errors"):
                        info.pop(k, None)
                weeks_int = {}
                for k, v in info["weeks"].items():
                    try:
                        t_int = int(k)
                    except (ValueError, TypeError):
                        continue
                    weeks_int[t_int] = _chuan_hoa_tuan(v)

                for t in range(1, TONG_TUAN + 1):
                    if t not in weeks_int:
                        weeks_int[t] = tuan_moi()

                info["weeks"] = weeks_int
                if not validate_hs_info(info):
                    info["name"]  = str(info.get("name",  ""))
                    info["class"] = str(info.get("class", ""))
                self.HocSinh[sid] = info

            try:
                with open(DATA_FILE, "w", encoding="utf-8") as f:
                    f.write(content)
            except Exception:
                pass

            self.cap_nhat_bang()
            self.cap_nhat_diem_danh()
            self._xoa_panel_ct()
            self.thong_bao(f"✓ Đã tải {len(self.HocSinh)} HS từ GitHub", self.XANH_LA)

        self._async(task, on_success=on_done)

