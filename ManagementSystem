    def _khi_doi_tuan(self, event=None):
        s = self.bien_tuan.get()
        try: t = int(s.split()[1])
        except Exception: return
        self.tuan_hien_tai = t
        self.nhan_hk.config(text=ten_hoc_ky(t))
