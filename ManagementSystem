        parts.append('</div>')   # đóng summary-box

        # ═════════════════════════════════════════════════════
        # BIỂU ĐỒ SVG — Donut + Line + Bar
        # ═════════════════════════════════════════════════════
        parts.append('<h2 style="color:#1F3864;margin:32px 0 16px 0;'
                     'padding-bottom:8px;border-bottom:2px solid #4472C4">'
                     '📊 Biểu đồ phân tích</h2>')

        total_all = all_cm + all_vp + all_vkp
        rate_all_c = (all_cm / total_all * 100) if total_all else 0

        # ── Donut + Legend ──
        segments = [
            (all_cm,  "#22C55E"),
            (all_vp,  "#EAB308"),
            (all_vkp, "#EF4444"),
        ]
        donut_svg = _svg_donut(
            cx=130, cy=130, r=95, thickness=42,
            segments=segments,
            center_text=f"{rate_all_c:.0f}%",
            center_sub="có mặt")

        parts.append('<div style="display:flex;gap:30px;'
                     'flex-wrap:wrap;align-items:center;'
                     'justify-content:center;margin:16px 0 32px 0">')
        parts.append(f'<div>{donut_svg}</div>')

        # Legend
        parts.append('<div style="flex:1;min-width:280px;max-width:400px">')
        for label, value, color in [
            ("✓ Có mặt",       all_cm,  "#22C55E"),
            ("✗ Vắng phép",    all_vp,  "#EAB308"),
            ("⊘ Không phép",   all_vkp, "#EF4444"),
        ]:
            pct = (value / total_all * 100) if total_all else 0
            parts.append(
                f'<div style="display:flex;align-items:center;'
                f'padding:12px 16px;background:#f8fafc;'
                f'border-radius:8px;margin-bottom:10px;'
                f'border-left:5px solid {color}">'
                f'<div style="flex:1;font-weight:600;font-size:14px">'
                f'{label}</div>'
                f'<div style="font-family:Consolas,monospace;'
                f'color:#666;margin-right:20px;font-size:13px">'
                f'{value:,} buổi</div>'.replace(",", ".") +
                f'<div style="font-weight:700;color:{color};'
                f'font-size:18px;min-width:70px;text-align:right">'
                f'{pct:.1f}%</div>'
                f'</div>')
        parts.append('</div>')
        parts.append('</div>')

        # ── Line chart theo tuần ──
