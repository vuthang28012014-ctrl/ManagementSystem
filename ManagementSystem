    # ═══ Threading helpers ═══
    def _async(self, fn, on_success=None, on_error=None):
        def _safe_call(cb, arg):
            try:
                # Kiểm tra root còn sống trước khi gọi after
                if not self.root.winfo_exists():
                    return
                self.root.after(0, lambda: cb(arg))
            except Exception:
                pass  # root đã bị destroy → bỏ qua

        def worker():
            try:
                result = fn()
                if on_success:
                    _safe_call(on_success, result)
            except Exception as e:
                tb = traceback.format_exc()
                log_error(f"Async task fail: {e}\n{tb}")
                if on_error:
                    _safe_call(on_error, e)
        threading.Thread(target=worker, daemon=True).start()

