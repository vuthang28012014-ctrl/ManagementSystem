        # ═══ BAR CHART — Tỉ lệ HS có lỗi theo tuần ═══
        err_chart = BarChart()
        err_chart.type = "col"
        err_chart.title = "Tỉ lệ HS có lỗi theo tuần"
        err_chart.y_axis.title = "Tỉ lệ (%)"
        err_chart.y_axis.scaling.min = 0
        err_chart.y_axis.scaling.max = 100
        err_chart.x_axis.title = "Tuần"
        err_chart.height = 10
        err_chart.width = 22
        err_chart.gapWidth = 20
        err_chart.legend = None   # ẩn legend — chỉ 1 series

        err_data = Reference(
            ws_data,
            min_col=12, max_col=12,
            min_row=1, max_row=1 + TONG_TUAN)
        err_cats = Reference(
            ws_data,
            min_col=1, max_col=1,
            min_row=2, max_row=1 + TONG_TUAN)

        s_err = Series(err_data, title_from_data=True)

        # Style cột cam
        try:
            s_err.graphicalProperties = GraphicalProperties()
            s_err.graphicalProperties.solidFill = "F97316"
        except Exception as e:
            log_warn(f"Err bar style fail: {e}")

        err_chart.series.append(s_err)
        err_chart.set_categories(err_cats)

        ws_chart.add_chart(err_chart, "A69")

        # Cột rộng để chart không bị chèn
        for col_letter in ("A", "B", "C", "D", "E", "F", "G", "H",
                           "I", "J", "K", "L", "M", "N", "O", "P"):
            ws_chart.column_dimensions[col_letter].width = 12

        # ═══ SẮP XẾP SHEET ═══
        # Thứ tự mong muốn: Tổng hợp | Biểu đồ | Tuần 1..N | _data_charts
        # 1. Đưa "Biểu đồ" lên ngay sau "Tổng hợp"
        wb.move_sheet("Biểu đồ", offset=-(len(wb.sheetnames) - 2))
        # 2. Đưa "_data_charts" xuống cuối
        wb.move_sheet("_data_charts", offset=1000)

        wb.save(path)
        log_info(f"✓ Xuất Excel all: {path} ({TONG_TUAN} tuần)")
        return True
    except Exception as e:
        log_error(f"Xuất xlsx-all fail: {e}\n{traceback.format_exc()}")
        return False

def _build_html_report(hoc_sinh, path, ly_do_md, tuan=None, for_word=False):
    """
    Xuất báo cáo HTML. Nếu tuan=None → cả năm. Chạy trong thread.
    Trả True nếu OK.
    """
    try:
        def esc(s):
            return (str(s).replace("&", "&amp;")
                           .replace("<", "&lt;")
                           .replace(">", "&gt;"))

        hs_order = sorted(hoc_sinh.keys(),
                          key=lambda m: hoc_sinh[m]["name"].lower())

        # ── Tính toán ──
        def tinh(hs_d, tuan_filter=None):
            n_cm = n_vp = n_vkp = n_loi = 0
            weeks = range(1, TONG_TUAN + 1) if tuan_filter is None else [tuan_filter]
            for t in weeks:
                w = hs_d.get("weeks", {}).get(t) or {}
                att = w.get("attendance", {})
                rea = w.get("reasons", {})
                err = w.get("errors", {})
                for day in THU:
                    if att.get(day, False):
                        n_cm += 1
                    else:
                        r = (rea.get(day, "") or "").strip()
                        if r and r != ly_do_md:
                            n_vp += 1
                        else:
                            n_vkp += 1
                    if (err.get(day, "") or "").strip():
                        n_loi += 1
            total = n_cm + n_vp + n_vkp
            rate = (n_cm / total * 100) if total else 0
            return n_cm, n_vp, n_vkp, n_loi, rate

        title = (f"BÁO CÁO CHUYÊN CẦN — TUẦN {tuan}"
                 if tuan else "BÁO CÁO CHUYÊN CẦN CẢ NĂM")

        parts = []
        if for_word:
            parts.append(
                '<html xmlns:o="urn:schemas-microsoft-com:office:office" '
                'xmlns:w="urn:schemas-microsoft-com:office:word" '
                'xmlns="http://www.w3.org/TR/REC-html40">')
            parts.append('<head>')
            parts.append('<meta charset="UTF-8">')
            parts.append(f'<title>{esc(title)}</title>')
            parts.append('<!--[if gte mso 9]><xml>')
            parts.append('<w:WordDocument>')
            parts.append('<w:View>Print</w:View>')
            parts.append('<w:Zoom>100</w:Zoom>')
            parts.append('</w:WordDocument></xml><![endif]-->')
        else:
            parts.append('<!DOCTYPE html><html lang="vi"><head>')
            parts.append('<meta charset="UTF-8">')
            parts.append(f'<title>{esc(title)}</title>')
        parts.append('<style>')
        parts.append('''
            body { font-family: 'Segoe UI', Calibri, Arial, sans-serif;
                   margin: 20px; color: #1a1a1a; background: #f8f9fb; }
            .container { max-width: 1100px; margin: 0 auto;
                         background: white; padding: 30px 40px;
                         border-radius: 12px;
                         box-shadow: 0 2px 16px rgba(0,0,0,0.08); }
            h1 { color: #1F3864; margin: 0 0 8px 0; font-size: 24px; }
            .meta { color: #666; font-style: italic; margin-bottom: 24px;
                    font-size: 14px; }
            table { border-collapse: collapse; width: 100%;
                    margin: 16px 0; font-size: 13px; }
            th { background: #4472C4; color: white;
                 padding: 8px 10px; text-align: center;
                 font-weight: 600; border: 1px solid #345a9e; }
            td { padding: 7px 10px; border: 1px solid #d8dee9;
                 text-align: center; }
            td.name { text-align: left; font-weight: 500; }
            tr:nth-child(even) td { background: #f5f7fa; }
            .rate-good { background: #C6EFCE !important;
                         color: #1a5c1a; font-weight: 600; }
            .rate-ok   { background: #FFEB9C !important;
                         color: #7a5a00; font-weight: 600; }
            .rate-bad  { background: #FFC7CE !important;
                         color: #8b1a2a; font-weight: 600; }
            .ky-cm  { background: #C6EFCE; }
            .ky-vp  { background: #FFEB9C; }
            .ky-vkp { background: #FFC7CE; }
            .ky-err { background: #FFD4A3; }
            .footer { margin-top: 30px; text-align: center;
                      color: #888; font-size: 12px; }
            .summary-box { display: flex; gap: 16px; margin: 20px 0; }
            .summary-item { flex: 1; background: #f0f4fa;
                            padding: 14px; border-radius: 8px;
                            border-left: 4px solid #4472C4; }
            .summary-item .label { font-size: 12px; color: #666;
                                   text-transform: uppercase; }
            .summary-item .value { font-size: 22px; font-weight: 700;
                                   color: #1F3864; margin-top: 4px; }
            @media print {
                body { background: white; margin: 0; }
                .container { box-shadow: none; max-width: none; }
                .no-print { display: none; }
            }
        ''')
        parts.append('</style></head><body>')
        parts.append('<div class="container">')

        # Nút in
        parts.append('<div class="no-print" '
                     'style="text-align:right;margin-bottom:12px">')
        parts.append('<button onclick="window.print()" '
                     'style="padding:8px 20px;background:#4472C4;'
                     'color:white;border:none;border-radius:6px;'
                     'cursor:pointer;font-size:14px;font-weight:600">'
                     '🖨 In báo cáo (Ctrl+P)</button>')
        parts.append('</div>')

        parts.append(f'<h1>{esc(title)}</h1>')
        parts.append(f'<div class="meta">Ngày xuất: '
                     f'{datetime.now().strftime("%d/%m/%Y %H:%M")} '
                     f'· {len(hoc_sinh)} học sinh '
                     f'· {TONG_TUAN} tuần</div>')

        # ── Tổng quan ──
        all_cm = all_vp = all_vkp = all_loi = 0
        rows = []
        for ma in hs_order:
            d = hoc_sinh[ma]
            n_cm, n_vp, n_vkp, n_loi, rate = tinh(d, tuan)
            rows.append({
                "ma": ma, "name": d["name"], "class": d["class"],
                "to": d.get("to", "") or "—",
                "cm": n_cm, "vp": n_vp, "vkp": n_vkp,
                "loi": n_loi, "rate": rate,
