def github_fetch(config, timeout=15):
    """Tải file từ GitHub. Trả string hoặc None."""
    if not URLLIB_OK or not config:
        return None
    url = (f"https://raw.githubusercontent.com/{config['owner']}/{config['repo']}/"
           f"{config['branch']}/{config['path']}?t={int(_time.time())}")
    try:
        req = urllib.request.Request(url, headers={
            "User-Agent": "ManagementSystem/2.0",
            "Cache-Control": "no-cache",
        })
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.read().decode("utf-8")
    except urllib.error.HTTPError as e:
        if e.code == 404:
            log_info("GitHub: file chưa tồn tại → bắt đầu rỗng")
            return "{}"
        if e.code == 403:
            log_error("GitHub: 403 – rate limit hoặc token sai")
            return None
        log_error(f"GitHub fetch HTTP {e.code}")
        return None
    except Exception as e:
        log_error(f"GitHub fetch: {e}")
        return None


def github_push(config, content, commit_msg=None):
    """Push file. Retry 3 lần khi conflict. Trả (ok, err_msg)."""
    if not URLLIB_OK or not config:
        return False, "Không có config GitHub"

    if not commit_msg:
        commit_msg = f"Cập nhật lúc {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}"

    api_url = (f"https://api.github.com/repos/{config['owner']}/"
               f"{config['repo']}/contents/{config['path']}")
    headers = {
        "Authorization": f"token {config['token']}",
        "Accept":        "application/vnd.github.v3+json",
        "User-Agent":    "ManagementSystem/2.0",
    }

    def get_sha():
        try:
            req = urllib.request.Request(api_url + f"?ref={config['branch']}",
                                          headers=headers)
            with urllib.request.urlopen(req, timeout=10) as resp:
                return json.loads(resp.read().decode("utf-8")).get("sha")
        except urllib.error.HTTPError as e:
            if e.code == 404:
                return None
            log_error(f"GitHub lấy SHA HTTP {e.code}")
            return None
        except Exception as e:
            log_error(f"GitHub lấy SHA: {e}")
            return None

    sha = get_sha()

    for attempt in range(3):
        body = {
            "message": commit_msg,
            "content": base64.b64encode(content.encode("utf-8")).decode("ascii"),
            "branch":  config["branch"],
        }
        if sha:
            body["sha"] = sha

        try:
            req = urllib.request.Request(
                api_url,
                data=json.dumps(body).encode("utf-8"),
                headers={**headers, "Content-Type": "application/json"},
                method="PUT",
            )
            with urllib.request.urlopen(req, timeout=20) as resp:
                if resp.status in (200, 201):
                    return True, None
        except urllib.error.HTTPError as e:
            if e.code in (409, 422):
                log_warn(f"GitHub conflict — thử lại {attempt+1}/3")
                _time.sleep(1)
                sha = get_sha()
                continue
            if e.code == 403:
                return False, "403 – token hết hạn hoặc rate limit"
            return False, f"HTTP {e.code}"
        except Exception as e:
            return False, str(e)

    return False, "Conflict sau 3 lần thử"

def github_push_ex(config, content, commit_msg=None):
