    # ═══ Bảng HS ═══
    def cap_nhat_bang(self):
        for item in self.bang.get_children(): self.bang.delete(item)
        rows = [(ma, d["name"], d["class"])
                for ma, d in self.HocSinh.items() if self._thoa_filter(ma, d)]
        key = self.khoa_sap_xep
        if key == "ma":  rows.sort(key=lambda r: r[0],          reverse=self.dao_sap_xep)
        elif key == "ten": rows.sort(key=lambda r: r[1].lower(), reverse=self.dao_sap_xep)
        else:              rows.sort(key=lambda r: r[2].lower(), reverse=self.dao_sap_xep)

        for i, (ma, ten, lop) in enumerate(rows):
            tag = "le" if i % 2 else "chan"
            self.bang.insert("", "end", iid=str(ma),
                             values=(ma, ten, lop), tags=(tag,))

        self.nhan_tong.config(text=f"Tổng: {len(self.HocSinh)}")
        if self.nhan_ket_qua is not None:
            if self._co_filter():
                self.nhan_ket_qua.config(
                    text=f"Tìm thấy: {len(rows)}/{len(self.HocSinh)} HS",
                    fg=self.XANH_LA)
            else:
                self.nhan_ket_qua.config(text="")

    def sap_xep(self, key):
        if self.khoa_sap_xep == key:
            self.dao_sap_xep = not self.dao_sap_xep
        else:
            self.khoa_sap_xep = key; self.dao_sap_xep = False
        self.settings["sort_key"]  = self.khoa_sap_xep
        self.settings["sort_desc"] = self.dao_sap_xep
        save_settings(self.settings)
        self.cap_nhat_bang()

    # ═══ Ký hiệu ═══
    def _ky_hieu_o(self, ma, day):
        w = self._du_lieu_tuan(ma)
        if not w: return ""
        if w["attendance"].get(day, False):
            base = "✓"
        else:
            reason = w["reasons"].get(day, "").strip()
            base = "✗" if (reason and reason != self.settings["ly_do_mac_dinh"]) else "⊘"
        err = w["errors"].get(day, "").strip()
        return f"{base}!" if err else base

    def cap_nhat_diem_danh(self):
        for item in self.bang_dd.get_children(): self.bang_dd.delete(item)
        ds_ma = sorted(self.HocSinh.keys(),
                       key=lambda s: self.HocSinh[s]["name"].lower())
        sel = self.bang.selection()
        ma_da_chon = [int(self.bang.item(i, "values")[0]) for i in sel] if sel else None

        for ma in ds_ma:
            d = self.HocSinh[ma]
            ten_hien = d["name"]
            tag = ()
            if ma_da_chon and ma not in ma_da_chon:
                ten_hien = f"· {d['name']}"
            elif ma_da_chon and ma in ma_da_chon:
                tag = ("focus",)
            vals = [f"{ten_hien} ({d['class']})"] + [self._ky_hieu_o(ma, day) for day in THU]
            self.bang_dd.insert("", "end", iid=str(ma), values=vals, tags=tag)

        tong = len(ds_ma)
        if ma_da_chon:
            self.nhan_tom_tat.config(text=f"Đang xem {len(ma_da_chon)}/{tong} · Tuần {self.tuan_hien_tai}")
        else:
            self.nhan_tom_tat.config(text=f"{tong} HS · Tuần {self.tuan_hien_tai}")

    def _cap_nhat_hang_dd(self, ma):
        d = self.HocSinh.get(ma)
        if not d: return
        vals = [f"{d['name']} ({d['class']})"] + [self._ky_hieu_o(ma, day) for day in THU]
        try: self.bang_dd.item(str(ma), values=vals)
        except Exception: pass

    # ═══ Click handlers ═══
    def _xac_dinh_o(self, x, y):
        if self.bang_dd.identify("region", x, y) != "cell": return None
        row_id = self.bang_dd.identify_row(y)
        if not row_id: return None
        col_id = self.bang_dd.identify_column(x)
        col_idx = int(col_id[1:]) - 1
        col_name = COT_DIEMDANH[col_idx]
        if col_name == COT_TEN: return None
        return (int(row_id), col_name)

    def click_diem_danh(self, event):
        x, y = event.x, event.y
        if self.hen_gio_click:
            self.root.after_cancel(self.hen_gio_click)
        ms = self.settings["click_delay_ms"]
        self.hen_gio_click = self.root.after(
            ms, lambda: self._xu_ly_click_don(x, y))

    def _xu_ly_click_don(self, x, y):
        self.hen_gio_click = None
        cell = self._xac_dinh_o(x, y)
        if cell is None: return
        self._hien_thi_panel_ct(*cell)

    def double_click_diem_danh(self, event):
        if self.hen_gio_click:
            self.root.after_cancel(self.hen_gio_click)
            self.hen_gio_click = None
        cell = self._xac_dinh_o(event.x, event.y)
        if cell is None: return
        self._doi_trang_thai(*cell)

    def _doi_trang_thai(self, ma, day):
        if not self._tuan_co_the_sua():
            self.thong_bao(
                f"⚠ Tuần {self.tuan_hien_tai} đã khóa (max={self.settings['max_editable_week']})",
                self.DO)
            return
        w = self._du_lieu_tuan(ma)
        if not w: return
        self._snapshot(f"Đổi trạng thái {ma}/{day}")
        d = self.HocSinh[ma]
        new_val = not w["attendance"].get(day, False)
        w["attendance"][day] = new_val
        if new_val:
            w["reasons"][day] = ""
            self.thong_bao(f"✓ {d['name']} — T{self.tuan_hien_tai} {day}: Có mặt", self.XANH_LA)
        else:
            w["reasons"][day] = self.settings["ly_do_mac_dinh"]
            self.thong_bao(f"⊘ {d['name']} — T{self.tuan_hien_tai} {day}: "
                            f"{self.settings['ly_do_mac_dinh']}", self.DO)
        self._cap_nhat_hang_dd(ma)
        self._hien_thi_panel_ct(ma, day)

    def _hien_thi_panel_ct(self, ma, day):
        w = self._du_lieu_tuan(ma)
        if not w: return
        d = self.HocSinh[ma]
        self.o_hien_tai = (ma, day)
        att = w["attendance"].get(day, False)
        reason = w["reasons"].get(day, "")
        err = w["errors"].get(day, "")

        tuan_str = f"Tuần {self.tuan_hien_tai} · {day}"
        if att:
            self.tieu_de_ct.config(
                text=f"👁 {d['name']} — {tuan_str}: CÓ MẶT",
                fg=self.XANH_LA, font=("Segoe UI", 10, "bold"))
            self.bien_ly_do.set("")
            self.o_ly_do.config(state="disabled")
        else:
            if not reason.strip():
                reason = self.settings["ly_do_mac_dinh"]
                w["reasons"][day] = reason
            self.tieu_de_ct.config(
                text=f"👁 {d['name']} ({d['class']}) — {tuan_str}",
                fg=self.XANH_DUONG, font=("Segoe UI", 10, "bold"))
            self.o_ly_do.config(state="normal")
            self.bien_ly_do.set(reason)
            self.o_ly_do.focus_set()
            self.o_ly_do.selection_range(0, "end")

        self.o_loi.delete("1.0", "end")
        if err: self.o_loi.insert("1.0", err)

    def di_chuot_diem_danh(self, event):
        if self.bang_dd.identify("region", event.x, event.y) != "cell":
            self.bang_dd.config(cursor=""); return
        col_id = self.bang_dd.identify_column(event.x)
        col_idx = int(col_id[1:]) - 1
        self.bang_dd.config(cursor="" if col_idx == 0 else "hand2")

    # ═══ Panel chi tiết ═══
    def _xoa_panel_ct(self):
        self.o_hien_tai = None
        self.tieu_de_ct.config(text="1 click vào ô để xem chi tiết...",
                                fg=self.CHU_MO, font=("Segoe UI", 9, "italic"))
        self.bien_ly_do.set("")
        self.o_ly_do.config(state="normal")
        self.o_loi.delete("1.0", "end")

    def luu_ly_do(self):
        if not self.o_hien_tai:
            self.thong_bao("⚠ Chưa chọn ô nào", self.VANG); return
        if not self._tuan_co_the_sua():
            self.thong_bao(f"⚠ Tuần {self.tuan_hien_tai} đã khóa", self.DO); return
        ma, day = self.o_hien_tai
        w = self._du_lieu_tuan(ma)
        if not w: return
        d = self.HocSinh[ma]
        if w["attendance"].get(day, False):
            self.thong_bao("⚠ Ô này là CÓ MẶT, không cần lý do", self.VANG); return
        text = self.bien_ly_do.get().strip() or self.settings["ly_do_mac_dinh"]
        self._snapshot(f"Lý do {ma}/{day}")
        w["reasons"][day] = text
        self._cap_nhat_hang_dd(ma)
        mau = self.DO if text == self.settings["ly_do_mac_dinh"] else self.VANG
        self.thong_bao(f"✓ Đã lưu {d['name']} — T{self.tuan_hien_tai} {day}: {text}", mau)

    def danh_dau_khong_phep(self):
        if not self.o_hien_tai:
            self.thong_bao("⚠ Chưa chọn ô nào", self.VANG); return
        if not self._tuan_co_the_sua():
            self.thong_bao(f"⚠ Tuần {self.tuan_hien_tai} đã khóa", self.DO); return
        ma, day = self.o_hien_tai
        w = self._du_lieu_tuan(ma)
        if not w: return
        d = self.HocSinh[ma]
        if w["attendance"].get(day, False):
            self.thong_bao("⚠ Ô này là CÓ MẶT", self.VANG); return
        self._snapshot(f"Không phép {ma}/{day}")
        w["reasons"][day] = self.settings["ly_do_mac_dinh"]
        self.bien_ly_do.set(self.settings["ly_do_mac_dinh"])
        self._cap_nhat_hang_dd(ma)
        self.thong_bao(f"⊘ {d['name']} — T{self.tuan_hien_tai} {day}: "
                        f"{self.settings['ly_do_mac_dinh']}", self.DO)

    def luu_loi(self):
        if not self.o_hien_tai:
            self.thong_bao("⚠ Chưa chọn ô nào", self.VANG); return
        if not self._tuan_co_the_sua():
            self.thong_bao(f"⚠ Tuần {self.tuan_hien_tai} đã khóa", self.DO); return
        ma, day = self.o_hien_tai
        w = self._du_lieu_tuan(ma)
        if not w: return
        d = self.HocSinh[ma]
        text = self.o_loi.get("1.0", "end-1c").strip()
        self._snapshot(f"Lỗi {ma}/{day}")
        w["errors"][day] = text
        self._cap_nhat_hang_dd(ma)
        if text:
            hien = text if len(text) <= 60 else text[:57] + "..."
            self.thong_bao(f"⚠ Đã lưu lỗi {d['name']} — T{self.tuan_hien_tai} {day}: {hien}", self.CAM)
        else:
            self.thong_bao(f"✓ Đã xóa lỗi {d['name']} — T{self.tuan_hien_tai} {day}", self.XANH_LA)

    def xoa_loi(self):
        if not self.o_hien_tai:
            self.thong_bao("⚠ Chưa chọn ô nào", self.VANG); return
        if not self._tuan_co_the_sua():
            self.thong_bao(f"⚠ Tuần {self.tuan_hien_tai} đã khóa", self.DO); return
        ma, day = self.o_hien_tai
        w = self._du_lieu_tuan(ma)
        if not w: return
        d = self.HocSinh[ma]
        self._snapshot(f"Xóa lỗi {ma}/{day}")
        w["errors"][day] = ""
        self.o_loi.delete("1.0", "end")
        self._cap_nhat_hang_dd(ma)
        self.thong_bao(f"✓ Đã xóa lỗi {d['name']} — T{self.tuan_hien_tai} {day}", self.XANH_LA)

    # ═══ Bulk ═══
    def danh_dau_tat_ca(self):
        if not self._tuan_co_the_sua():
            self.thong_bao(f"⚠ Tuần {self.tuan_hien_tai} đã khóa", self.DO); return
        sel = self.bang.selection()
        ds_ma = [int(self.bang.item(i, "values")[0]) for i in sel] if sel \
                else list(self.HocSinh.keys())
        self._snapshot(f"Bulk có mặt {len(ds_ma)} HS")
        for ma in ds_ma:
            w = self._du_lieu_tuan(ma)
            if w:
                for day in THU:
                    w["attendance"][day] = True
                    w["reasons"][day] = ""
        self.cap_nhat_diem_danh()
        self._xoa_panel_ct()
        self.thong_bao(f"✓ Đã đánh dấu có mặt tuần {self.tuan_hien_tai} "
                        f"cho {len(ds_ma)} HS", self.XANH_LA)

    def bo_danh_dau_tat_ca(self):
        if not self._tuan_co_the_sua():
            self.thong_bao(f"⚠ Tuần {self.tuan_hien_tai} đã khóa", self.DO); return
        sel = self.bang.selection()
        ds_ma = [int(self.bang.item(i, "values")[0]) for i in sel] if sel \
                else list(self.HocSinh.keys())
        self._snapshot(f"Bulk vắng {len(ds_ma)} HS")
        for ma in ds_ma:
            w = self._du_lieu_tuan(ma)
            if w:
                for day in THU:
                    w["attendance"][day] = False
                    w["reasons"][day] = self.settings["ly_do_mac_dinh"]
        self.cap_nhat_diem_danh()
        self._xoa_panel_ct()
        self.thong_bao(f"⊘ Đã đánh dấu vắng tuần {self.tuan_hien_tai} "
                        f"cho {len(ds_ma)} HS", self.DO)

    # ═══ Stats ═══
    def mo_thong_ke(self):
        win = tk.Toplevel(self.root)
        win.title("Báo cáo thống kê")
        win.configure(bg=self.NEN)
        win.geometry("800x600")

        tk.Label(win, text="📊  THỐNG KÊ CHUYÊN CẦN",
                 bg=self.NEN, fg=self.XANH_DUONG,
                 font=("Segoe UI", 14, "bold")).pack(pady=10)

        frame = tk.Frame(win, bg=self.NEN)
        frame.pack(fill="both", expand=True, padx=15, pady=10)

        cols = ("name", "class", "present", "excused", "absent", "rate", "errors")
        tv = ttk.Treeview(frame, columns=cols, show="headings")
        headers = [
            ("name",    "Học sinh",   200),
            ("class",   "Lớp",         80),
            ("present", "Có mặt",      80),
            ("excused", "Có phép",     80),
            ("absent",  "Không phép",  90),
            ("rate",    "Tỉ lệ",        80),
            ("errors",  "Lỗi",          60),
        ]
        for k, txt, w in headers:
            tv.heading(k, text=txt)
            tv.column(k, width=w, anchor="center" if k != "name" else "w")

        scroll = ttk.Scrollbar(frame, orient="vertical", command=tv.yview)
        tv.configure(yscrollcommand=scroll.set)
        tv.pack(side="left", fill="both", expand=True)
        scroll.pack(side="right", fill="y")

        ly_do_md = self.settings["ly_do_mac_dinh"]
        rows = []
        for ma, d in self.HocSinh.items():
            n_present = n_excused = n_absent = n_err = 0
            for t, w in d.get("weeks", {}).items():
                att = w.get("attendance", {})
                rea = w.get("reasons",    {})
                err = w.get("errors",     {})
                for day in THU:
                    if att.get(day, False):
                        n_present += 1
                    else:
                        r = rea.get(day, "").strip()
                        if r and r != ly_do_md:
                            n_excused += 1
                        else:
                            n_absent += 1
                    if err.get(day, "").strip():
                        n_err += 1
            total = n_present + n_excused + n_absent
            rate = (n_present / total * 100) if total else 0
            rows.append((d["name"], d["class"], n_present, n_excused,
                          n_absent, f"{rate:.1f}%", n_err))

        rows.sort(key=lambda r: -r[5].__str__().__len__())  # placeholder
        rows.sort(key=lambda r: float(r[5].rstrip("%")))    # sort by rate asc
        rows.reverse()

        for i, r in enumerate(rows):
            tag = "le" if i % 2 else "chan"
            tv.tag_configure(tag, background=self.NEN2 if i % 2 else self.NEN)
            tv.insert("", "end", values=r, tags=(tag,))

        tk.Button(win, text="Đóng", command=win.destroy,
                  bg=self.NEN3, fg=self.CHU, relief="flat",
                  font=("Segoe UI", 10, "bold"), padx=20, pady=6
                  ).pack(pady=10)

    def xuat_csv(self):
        if not self.HocSinh:
            self.thong_bao("⚠ Không có dữ liệu", self.VANG); return
        path = filedialog.asksaveasfilename(
            defaultextension=".csv",
            filetypes=[("CSV files", "*.csv")],
            initialfile=f"diem_danh_tuan_{self.tuan_hien_tai}.csv")
        if not path: return

        try:
            with open(path, "w", encoding="utf-8-sig", newline="") as f:
                wr = csv.writer(f)
                wr.writerow(["Mã", "Họ tên", "Lớp", "Tuần"] + THU)
                for ma in sorted(self.HocSinh.keys()):
                    d = self.HocSinh[ma]
                    w = self._du_lieu_tuan(ma)
                    ky_hieu = [self._ky_hieu_o(ma, day) for day in THU]
                    wr.writerow([ma, d["name"], d["class"],
                                  f"Tuần {self.tuan_hien_tai}"] + ky_hieu)
            self.thong_bao(f"✓ Đã xuất CSV: {os.path.basename(path)}", self.XANH_LA)
        except Exception as e:
            self.thong_bao(f"✗ Lỗi xuất CSV: {e}", self.DO)

    # ═══ Auto-save ═══
    def _schedule_auto_save(self):
        ms = self.settings["auto_save_interval_s"] * 1000
        self.root.after(ms, self._auto_save_tick)

    def _auto_save_tick(self):
        if self._dirty and not self._saving:
            log_info("Auto-save...")
            self.luu_ngay()
        self._schedule_auto_save()

    # ═══ Status ═══
    def thong_bao(self, msg, mau=None):
        self.thanh_trang_thai.config(text=msg, fg=mau or self.CHU_MO)

    def khi_dong(self):
        if self.hen_gio_click:
            self.root.after_cancel(self.hen_gio_click)
        if self._dirty:
            try:
                ghi_file(self.HocSinh, self.settings["ly_do_mac_dinh"], DATA_FILE)
            except Exception as e:
                log_error(f"Save on close: {e}")
        save_settings(self.settings)
        self.root.destroy()


