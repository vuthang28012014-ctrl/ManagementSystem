def _normalize_simple(raw: dict) -> dict[int, dict]:
    """Normalize dict raw → {sid_int: info} với weeks key int."""
    out = {}
    for sid_str, info in raw.items():
        if sid_str == "_meta":
            continue
        try:
            sid = int(sid_str)
        except (ValueError, TypeError):
            continue
        weeks_int = {}
        for k, v in (info.get("weeks") or {}).items():
            try:
                weeks_int[int(k)] = _chuan_hoa_tuan(v)
            except (ValueError, TypeError):
                pass
        for t in range(1, TONG_TUAN + 1):
            weeks_int.setdefault(t, tuan_moi())
        info["weeks"] = weeks_int
        if "to" not in info:
            info["to"] = ""
        else:
            info["to"] = str(info["to"]).strip()
        out[sid] = info
    return out


def diff_data(old_raw: dict, new_raw: dict) -> list[str]:
    """
    So sánh 2 dataset.
    Trả về list các dòng mô tả thay đổi.
    """
    changes = []
    old_ids = set(old_raw.keys())
    new_ids = set(new_raw.keys())

    for sid in sorted(old_ids - new_ids):
        changes.append(f"➖ Xóa HS [{sid}] {old_raw[sid].get('name','')}")

    for sid in sorted(new_ids - old_ids):
        changes.append(f"➕ Thêm HS [{sid}] {new_raw[sid].get('name','')}")

    for sid in sorted(old_ids & new_ids):
        o = old_raw[sid]; n = new_raw[sid]
        name = n.get("name", "")
        if o.get("name") != n.get("name"):
            changes.append(
                f"✏️  [{sid}] Đổi tên: '{o.get('name','')}' → '{n.get('name','')}'")
        if o.get("class") != n.get("class"):
            changes.append(
                f"✏️  [{sid}] Đổi lớp: '{o.get('class','')}' → '{n.get('class','')}'")

        ow = o.get("weeks", {})
        nw = n.get("weeks", {})
        for t in range(1, TONG_TUAN + 1):
            ow_t = ow.get(t) or {}
            nw_t = nw.get(t) or {}
            if ow_t == nw_t:
                continue

            oatt = ow_t.get("attendance", {})
            natt = nw_t.get("attendance", {})
            orea = ow_t.get("reasons", {})
            nrea = nw_t.get("reasons", {})
            oerr = ow_t.get("errors", {})
            nerr = nw_t.get("errors", {})

            for day in THU:
                if oatt.get(day) != natt.get(day):
                    arrow = "✓ → ⊘" if oatt.get(day) else "⊘ → ✓"
                    changes.append(
                        f"  [{sid}] {name} · Tuần {t} {day} · điểm danh: {arrow}")
                if orea.get(day, "") != nrea.get(day, ""):
                    changes.append(
                        f"  [{sid}] {name} · Tuần {t} {day} · lý do: "
                        f"'{orea.get(day,'')}' → '{nrea.get(day,'')}'")
                if oerr.get(day, "") != nerr.get(day, ""):
                    changes.append(
                        f"  [{sid}] {name} · Tuần {t} {day} · lỗi: "
                        f"'{oerr.get(day,'')}' → '{nerr.get(day,'')}'")

    return changes

def _merge_week(local_w: dict, remote_w: dict) -> dict:
    """
    Union merge 1 tuần:
      - attendance: OR (ai true thì true)
      - reasons:    local nếu có, ngược lại remote
      - errors:     local nếu có, ngược lại remote
    """
    merged = {"attendance": {}, "reasons": {}, "errors": {}}
    for day in THU:
        la = bool(local_w.get("attendance", {}).get(day, False))
        ra = bool(remote_w.get("attendance", {}).get(day, False))
        merged["attendance"][day] = la or ra

        lr = (local_w.get("reasons",  {}).get(day, "") or "").strip()
        rr = (remote_w.get("reasons", {}).get(day, "") or "").strip()
        merged["reasons"][day] = lr if lr else rr

        le = (local_w.get("errors",  {}).get(day, "") or "").strip()
        re_ = (remote_w.get("errors", {}).get(day, "") or "").strip()
        merged["errors"][day] = le if le else re_
    return merged


def _merge_hs(local_hs: dict, remote_hs: dict) -> dict:
    merged = {
        "name":  local_hs.get("name")  or remote_hs.get("name",  ""),
        "class": local_hs.get("class") or remote_hs.get("class", ""),
        "to":    local_hs.get("to")    or remote_hs.get("to",    ""),
        "weeks": {},
    }

    # ── FIX: normalize cả 2 bên về int key ──
    def _norm(w):
        out = {}
        for k, v in (w or {}).items():
            try:
                out[int(k)] = v
            except (ValueError, TypeError):
                continue
        return out

    lw = _norm(local_hs.get("weeks"))
    rw = _norm(remote_hs.get("weeks"))

    all_weeks = set(lw.keys()) | set(rw.keys())    # int keys
    for wk in all_weeks:
        l_val = lw.get(wk)
        r_val = rw.get(wk)
        if l_val and r_val:
            merged["weeks"][wk] = _merge_week(l_val, r_val)
        elif l_val:
            merged["weeks"][wk] = l_val
        else:
            merged["weeks"][wk] = r_val

    for t in range(1, TONG_TUAN + 1):
        merged["weeks"].setdefault(t, tuan_moi())
    return merged


def _pick3(l_val, r_val, b_val):
    """Merge 3 chiều cho 1 giá trị: bên nào đổi so với base thì lấy bên đó."""
    if l_val == r_val:
        return l_val
    if l_val == b_val:      # local không đổi -> lấy remote
        return r_val
    return l_val            # local đổi (hoặc cả hai đổi) -> local thắng


def _int_keys(d):
    out = {}
    for k, v in (d or {}).items():
        try:
            out[int(k)] = v
        except (ValueError, TypeError):
            continue
    return out


def _merge_week3(local_w, remote_w, base_w):
    local_w = local_w or {}
    remote_w = remote_w or {}
    base_w = base_w or {}
    merged = {"attendance": {}, "reasons": {}, "errors": {}}
    for day in THU:
        la = bool(local_w.get("attendance", {}).get(day, False))
        ra = bool(remote_w.get("attendance", {}).get(day, False))
        ba = bool(base_w.get("attendance", {}).get(day, False))
        merged["attendance"][day] = _pick3(la, ra, ba)
        for key in ("reasons", "errors"):
            lv = (local_w.get(key, {}).get(day, "") or "").strip()
            rv = (remote_w.get(key, {}).get(day, "") or "").strip()
            bv = (base_w.get(key, {}).get(day, "") or "").strip()
            merged[key][day] = _pick3(lv, rv, bv)
    return merged


def _merge_hs3(local_hs, remote_hs, base_hs):
    base_hs = base_hs or {}
    merged = {}
    for key in ("name", "class", "to"):
        lv = str(local_hs.get(key, "") or "")
        rv = str(remote_hs.get(key, "") or "")
        bv = str(base_hs.get(key, "") or "")
        merged[key] = _pick3(lv, rv, bv)
    lw = _int_keys(local_hs.get("weeks"))
    rw = _int_keys(remote_hs.get("weeks"))
    bw = _int_keys(base_hs.get("weeks"))
    merged["weeks"] = {}
    for t in set(lw) | set(rw):
        merged["weeks"][t] = _merge_week3(lw.get(t), rw.get(t), bw.get(t))
    for t in range(1, TONG_TUAN + 1):
        merged["weeks"].setdefault(t, tuan_moi())
    return merged


def merge_data(local_data: dict, remote_data: dict,
               base_data: Optional[dict] = None) -> dict[int, dict]:
    """
    Merge 3 chiều: local / remote / base (bản đã đồng bộ lần trước).
    - Ô nào chỉ remote đổi -> lấy remote; chỉ local đổi -> lấy local;
      cả hai đổi -> local thắng.
    - HS bị xóa ở một bên được xóa theo nếu bên kia không sửa gì.
    - base = None (chưa biết lịch sử) -> không xóa HS nào, ô local có dữ liệu thắng.
    """
    l = _int_keys(local_data)
    r = _int_keys(remote_data)
    b = _int_keys(base_data)
    merged = {}
    for sid in set(l) | set(r):
        l_hs = l.get(sid)
        r_hs = r.get(sid)
        b_hs = b.get(sid)
        if l_hs is not None and r_hs is not None:
            merged[sid] = _merge_hs3(l_hs, r_hs, b_hs)
        elif l_hs is not None:
            # Chỉ local có: remote đã xóa nếu base từng có và local không sửa
            if b_hs is not None and l_hs == b_hs:
                continue
            merged[sid] = l_hs
        else:
            # Chỉ remote có: local đã xóa nếu base từng có và remote không sửa
            if b_hs is not None and r_hs == b_hs:
                continue
            merged[sid] = r_hs
    return merged


def _merge_data_cu_co_the_xoa(local_data: dict, remote_data: dict) -> dict[int, dict]:
    # ── FIX: normalize sid về int ──
    def _norm_ids(d):
        out = {}
        for k, v in d.items():
            try:
                out[int(k)] = v
            except (ValueError, TypeError):
                continue
        return out

    l = _norm_ids(local_data)
    r = _norm_ids(remote_data)

    merged = {}
    for sid in set(l.keys()) | set(r.keys()):
        l_hs = l.get(sid); r_hs = r.get(sid)
        if l_hs and r_hs:
            merged[sid] = _merge_hs(l_hs, r_hs)
        elif l_hs:
            merged[sid] = l_hs
        else:
            merged[sid] = r_hs
    return merged

def ghi_file(HocSinh: dict, ly_do_mac_dinh: str,
             filename: str = DATA_FILE,
             backup_count: int = 5,
             base: Optional[dict] = None
             ) -> tuple[bool, bool, Optional[str], Optional[dict]]:
    """
    Pull -> merge 3 chiều (local / remote / base) -> push đúng SHA vừa pull.
    Push conflict -> pull lại + merge lại + push, tối đa 3 lần.
    Không đọc được remote -> KHÔNG push (tránh ghi đè dữ liệu người khác).
    Trả (ok_local, ok_gh, err, merged_dict_or_None).
    """
    remote_sha = None
    skip_push = False
    backed_up = False

    local_data = {int(k): v for k, v in HocSinh.items()}
    merged_dict = None
    content = None
    ok_local = False
    last_err = None

    MAX_RETRY = 3
    for attempt in range(MAX_RETRY):
        # ── PULL + MERGE ──
        if GH_CONFIG:
            log_info(f"Pull lần {attempt+1}...")
            skip_push = False
            merged_dict = None
            status, remote_raw, remote_sha = github_fetch_ex(GH_CONFIG)
            if status == "ok" and remote_raw and remote_raw.strip():
                try:
                    parsed_raw = json.loads(
                        remote_raw,
                        object_pairs_hook=_object_pairs_hook_clean,
                    )
                    remote_data = _normalize_remote(parsed_raw)
                    merged_dict = merge_data(local_data, remote_data, base)
                    log_info(f"✓ Merge OK — {len(merged_dict)} HS "
                             f"(local {len(local_data)} / remote {len(remote_data)})")
                except Exception as e:
                    log_error(f"Merge fail: {e} — hủy push")
                    skip_push = True
                    last_err = f"Dữ liệu GitHub không đọc được: {e}"
            elif status in ("ok", "missing"):
                log_info("GitHub chưa có dữ liệu — push bản local")
            else:
                skip_push = True
                last_err = "Không đọc được GitHub nên hủy push để tránh ghi đè"
                log_warn(last_err)

        # ── ĐÓNG GÓI ──
        source = merged_dict if merged_dict is not None else HocSinh
        payload = {
            "_meta": {"updated_at": datetime.now(timezone.utc).isoformat()},
        }
        for k, v in source.items():
            payload[str(k)] = _rut_gon_hs(v)
        content = json.dumps(payload, ensure_ascii=False,
                             separators=(",", ":"))

        # ── GHI LOCAL (chỉ lần đầu) ──
        if content:
            if not backed_up:
                _backup_file(filename, keep=backup_count)
                backed_up = True
            try:
                tmp = filename + ".tmp"
                with open(tmp, "w", encoding="utf-8") as f:
                    f.write(content)
                    f.flush()
                    os.fsync(f.fileno())
                os.replace(tmp, filename)
                ok_local = True
                if GH_CONFIG:
                    _set_pending(True)    # local đã ghi nhưng chưa chắc push xong
                log_info("✓ Ghi local OK")
            except Exception as e:
                log_error(f"Ghi local lỗi: {e}")

        # ── PUSH ──
        if GH_CONFIG:
            if skip_push:
                return ok_local, False, last_err, None
            ok_gh, err, conflict = github_push_ex(GH_CONFIG, content,
                                                  sha=remote_sha)
            if ok_gh:
                log_info(f"✓ Push GitHub OK (lần {attempt+1})")
                _save_base_text(content)
                _set_pending(False)
                return ok_local, True, None, merged_dict

            last_err = err
            if conflict and attempt < MAX_RETRY - 1:
                log_warn(f"⚠ Conflict — pull lại + merge lại "
                         f"({attempt+1}/{MAX_RETRY})")
                _time.sleep(1.2)
                # reset merged để pull lại
                merged_dict = None
                continue
            else:
                log_error(f"✗ Push GitHub fail: {err}")
                return ok_local, False, err, merged_dict
        else:
            return ok_local, False, "no config", merged_dict

    return ok_local, False, last_err or "Conflict sau nhiều lần", merged_dict


