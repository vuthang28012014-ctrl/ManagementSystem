def _object_pairs_hook_clean(pairs: list, warnings: Optional[list] = None) -> dict:
    seen = {}
    for k, v in pairs:
        if k in seen:
            msg = f"Duplicate key '{k}' trong JSON — giữ bản cuối"
            log_warn(msg)
            if warnings is not None:
                warnings.append(msg)
        seen[k] = v
    return seen


def _backup_file(path: str, keep: int = 5) -> None:
    """Backup file với timestamp. Giữ N bản mới nhất."""
    if not os.path.exists(path):
        return
    try:
        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        bak = f"{path}.bak.{ts}"
        with open(path, "rb") as src, open(bak, "wb") as dst:
            dst.write(src.read())
        # Dọn backup cũ
        parent = os.path.dirname(path) or "."
        base = os.path.basename(path) + ".bak."
        baks = sorted(
            [os.path.join(parent, f) for f in os.listdir(parent) if f.startswith(base)],
            key=os.path.getmtime
        )
        for old in baks[:-keep]:
            try:
                os.remove(old)
            except OSError as e:
                log_warn(f"Không xoá được backup cũ {old}: {e}")
    except Exception as e:
        log_warn(f"Backup thất bại: {e}")

def _build_xlsx_all(hoc_sinh, path, ly_do_md, period="year"):
    """
    Xuất toàn bộ các tuần vào 1 file .xlsx (openpyxl).
    Sheet 1: Tổng hợp — Sheet 2..N: mỗi tuần 1 sheet.
    Trả True nếu OK. Chạy trong thread — KHÔNG chạm Tk.
    """
    if not OPENPYXL_OK:
        return False
    try:
        WEEKS = _get_weeks_for_period(period)
        P_LABEL = _period_label(period)
        wb = Workbook()
        wb.remove(wb.active)

        # ── Styles dùng chung ──
        thin = Side(border_style="thin", color="999999")
        border = Border(left=thin, right=thin, top=thin, bottom=thin)
        header_fill = PatternFill("solid", fgColor="4472C4")
        header_font = Font(bold=True, color="FFFFFF", size=11)
        center = Alignment(horizontal="center", vertical="center")
        left   = Alignment(horizontal="left",   vertical="center")
        total_fill = PatternFill("solid", fgColor="D9E1F2")

        fill_cm  = PatternFill("solid", fgColor="C6EFCE")
        fill_vp  = PatternFill("solid", fgColor="FFEB9C")
        fill_vkp = PatternFill("solid", fgColor="FFC7CE")
        fill_err = PatternFill("solid", fgColor="FFD4A3")

        # ── Dùng compute_stats dùng chung ──
        # stats_year: dùng cho sheet Tổng hợp (cả năm)
        # stats_period: dùng cho sheet _data_charts (đúng số tuần theo period)
        if not WEEKS:
            WEEKS = list(range(1, TONG_TUAN + 1))
        stats_year = compute_stats(hoc_sinh, WEEKS, ly_do_md)
        hs_order = stats_year["hs_order"]

        # ══════════════════════════════════════════════════
        # SHEET 1 — TỔNG HỢP CẢ NĂM
        # ══════════════════════════════════════════════════
        ws_sum = wb.create_sheet("Tổng hợp")
        sum_headers = ["STT", "Mã", "Họ tên", "Lớp", "Tổ",
                       "Có mặt", "Vắng phép", "Vắng KP", "Lỗi", "Tỉ lệ"]
        ncol = len(sum_headers)

        ws_sum["A1"] = f"BẢNG TỔNG HỢP CHUYÊN CẦN — {P_LABEL}"
        ws_sum["A1"].font = Font(bold=True, size=14, color="1F3864")
        ws_sum["A1"].alignment = Alignment(horizontal="center")

        ws_sum["A2"] = (f"Ngày xuất: "
                        f"{datetime.now().strftime('%d/%m/%Y %H:%M')}"
                        f"  ·  Tổng số tuần: {len(WEEKS)}"
                        f"  ·  {len(hoc_sinh)} học sinh")
        ws_sum["A2"].font = Font(italic=True, color="666666")
        ws_sum["A2"].alignment = Alignment(horizontal="center")

        ws_sum.merge_cells(start_row=1, start_column=1,
                           end_row=1, end_column=ncol)
        ws_sum.merge_cells(start_row=2, start_column=1,
                           end_row=2, end_column=ncol)

        hdr_row = 4
        for col, h in enumerate(sum_headers, 1):
            c = ws_sum.cell(row=hdr_row, column=col, value=h)
            c.fill = header_fill; c.font = header_font
            c.alignment = center; c.border = border

        tong_cm  = stats_year["totals"]["cm"]
        tong_vp  = stats_year["totals"]["vp"]
        tong_vkp = stats_year["totals"]["vkp"]
        tong_loi = stats_year["totals"]["loi"]

        row_i = hdr_row + 1
        for stt, r in enumerate(stats_year["hs_rows"], 1):
            vals = [stt, r["ma"], r["name"], r["class"], r["to"],
                    r["cm"], r["vp"], r["vkp"], r["loi"],
                    f"{r['rate']:.1f}%"]
            for col, val in enumerate(vals, 1):
                c = ws_sum.cell(row=row_i, column=col, value=val)
                c.border = border
                c.alignment = left if col == 3 else center

            if r["rate"] is None:
                pass                     # chưa có dữ liệu → không tô màu
            elif r["rate"] >= 90:
                ws_sum.cell(row=row_i, column=10).fill = fill_cm
            elif r["rate"] >= 75:
                ws_sum.cell(row=row_i, column=10).fill = fill_vp
            else:
                ws_sum.cell(row=row_i, column=10).fill = fill_vkp
            row_i += 1

        # Dòng tổng
        row_i += 1
        ws_sum.cell(row=row_i, column=2, value="TỔNG").font = Font(bold=True)
        ws_sum.cell(row=row_i, column=3,
                    value=f"{len(hoc_sinh)} HS").font = Font(bold=True)
        for col, val in [(6, tong_cm), (7, tong_vp),
                         (8, tong_vkp), (9, tong_loi)]:
            c = ws_sum.cell(row=row_i, column=col, value=val)
            c.font = Font(bold=True); c.alignment = center
        for col in range(1, ncol + 1):
            ws_sum.cell(row=row_i, column=col).fill = total_fill

        for i, wd in enumerate([5, 8, 22, 8, 6, 10, 12, 10, 6, 10], 1):
            ws_sum.column_dimensions[get_column_letter(i)].width = wd
        ws_sum.freeze_panes = ws_sum.cell(row=hdr_row + 1, column=1)

        # ══════════════════════════════════════════════════
        # SHEETS 2..N — MỖI TUẦN 1 SHEET
        # ══════════════════════════════════════════════════
        week_headers = (["STT", "Mã", "Họ tên", "Lớp", "Tổ"]
                        + THU
                        + ["Có mặt", "Vắng phép", "Vắng KP", "Lỗi"])
        wcol = len(week_headers)
        first_ky_col = 6
        last_ky_col  = 5 + len(THU)

        for tuan in WEEKS:
            ws = wb.create_sheet(f"Tuần {tuan}")

            ws["A1"] = f"BẢNG ĐIỂM DANH — TUẦN {tuan}"
            ws["A1"].font = Font(bold=True, size=14, color="1F3864")
            ws["A1"].alignment = Alignment(horizontal="center")
            ws.merge_cells(start_row=1, start_column=1,
                           end_row=1, end_column=wcol)

            ws["A2"] = f"Ngày xuất: {datetime.now().strftime('%d/%m/%Y %H:%M')}"
            ws["A2"].font = Font(italic=True, color="666666")
            ws["A2"].alignment = Alignment(horizontal="center")
            ws.merge_cells(start_row=2, start_column=1,
                           end_row=2, end_column=wcol)

            hdr_row = 4
            for col, h in enumerate(week_headers, 1):
                c = ws.cell(row=hdr_row, column=col, value=h)
                c.fill = header_fill; c.font = header_font
                c.alignment = center; c.border = border

            tong_cm = tong_vp = tong_vkp = tong_loi = 0
            row_i = hdr_row + 1
            for stt, ma in enumerate(hs_order, 1):
                d = hoc_sinh[ma]
                w = d.get("weeks", {}).get(tuan) or {}
                att = w.get("attendance", {})
                rea = w.get("reasons", {})
                err = w.get("errors", {})

                n_cm = n_vp = n_vkp = n_loi = 0
                ky_list = []
                for day in THU:
                    loai = phan_loai_o(att.get(day, False),
                                       rea.get(day, ""), ly_do_md)
                    if loai == "cm":
                        base = "✓"; n_cm += 1
                    elif loai == "vp":
                        base = "✗"; n_vp += 1
                    elif loai == "vkp":
                        base = "⊘"; n_vkp += 1
                    else:
                        base = "·"
                    if (err.get(day, "") or "").strip():
                        base += "!"; n_loi += 1
                    ky_list.append(base)

                vals = ([stt, ma, d["name"], d["class"],
                         d.get("to", "") or "—"]
                        + ky_list
                        + [n_cm, n_vp, n_vkp, n_loi])
                for col, val in enumerate(vals, 1):
                    c = ws.cell(row=row_i, column=col, value=val)
                    c.border = border
                    c.alignment = left if col == 3 else center

                    if first_ky_col <= col <= last_ky_col:
                        ky = str(val)
                        if ky.startswith("✓"):   c.fill = fill_cm
                        elif ky.startswith("✗"): c.fill = fill_vp
                        elif ky.startswith("⊘"): c.fill = fill_vkp
                        if "!" in ky:
                            c.fill = fill_err
                            c.font = Font(bold=True, color="C2410C")

                tong_cm += n_cm; tong_vp += n_vp
                tong_vkp += n_vkp; tong_loi += n_loi
                row_i += 1

            row_i += 1
            ws.cell(row=row_i, column=2, value="TỔNG").font = Font(bold=True)
            ws.cell(row=row_i, column=3,
                    value=f"{len(hoc_sinh)} HS").font = Font(bold=True)
            for col, val in enumerate(
                    [tong_cm, tong_vp, tong_vkp, tong_loi],
                    start=last_ky_col + 1):
                c = ws.cell(row=row_i, column=col, value=val)
                c.font = Font(bold=True); c.alignment = center
            for col in range(1, wcol + 1):
