                 font=("Segoe UI", 9)).pack(side="left")
        limit_var = tk.StringVar(value="30")
        limit_cbb = ttk.Combobox(ctrl, textvariable=limit_var,
                                  values=["10", "30", "50", "100"],
                                  width=5, state="readonly")
        limit_cbb.pack(side="left", padx=(4, 12))
        tk.Label(ctrl, text="Tác giả:", bg=self.NEN2, fg=self.CHU_MO,
                 font=("Segoe UI", 9)).pack(side="left")
        author_var = tk.StringVar(value="Tất cả")
        author_cbb = ttk.Combobox(ctrl, textvariable=author_var,
                                   values=["Tất cả"],
                                   width=22, state="readonly")
        author_cbb.pack(side="left", padx=(4, 12))
        refresh_btn = tk.Button(ctrl, text="🔄 Tải lại",
                                 bg=self.XANH_DUONG, fg="#1e1e2e",
                                 relief="flat",
                                 font=("Segoe UI", 9, "bold"),
                                 padx=12, pady=3, cursor="hand2")
        refresh_btn.pack(side="left", padx=4)

        # ── Treeview ──
        tv_frame = tk.Frame(card, bg=self.NEN)
        tv_frame.pack(fill="x", expand=False, padx=10, pady=(0, 6))
        cols = ("time", "author", "msg", "sha")
        tv = ttk.Treeview(tv_frame, columns=cols,
                          show="headings", height=9)
        tv.heading("time",   text="Thời gian")
        tv.heading("author", text="Người sửa")
        tv.heading("msg",    text="Ghi chú")
        tv.heading("sha",    text="SHA")
        tv.column("time",   width=160, anchor="w")
        tv.column("author", width=160, anchor="w")
        tv.column("msg",    width=460, anchor="w")
        tv.column("sha",    width=80,  anchor="center")
        sc = ttk.Scrollbar(tv_frame, orient="vertical", command=tv.yview)
        tv.configure(yscrollcommand=sc.set)
        tv.pack(side="left", fill="both", expand=True)
        sc.pack(side="right", fill="y")

        # ── Diff panel ──
        tk.Label(card, text="Chi tiết thay đổi:",
                 bg=self.NEN, fg=self.XANH_DUONG,
                 font=("Segoe UI", 10, "bold")).pack(anchor="w", padx=10)
        diff_frame = tk.Frame(card, bg=self.NEN)
        diff_frame.pack(fill="both", expand=True, padx=10, pady=(0, 10))
        diff_txt = tk.Text(diff_frame, bg=self.NEN2, fg=self.CHU,
                           insertbackground=self.CHU, relief="flat",
                           font=("Consolas", 9), wrap="word",
                           padx=8, pady=6)
        diff_sc = ttk.Scrollbar(diff_frame, orient="vertical",
                                 command=diff_txt.yview)
        diff_txt.configure(yscrollcommand=diff_sc.set)
        diff_txt.pack(side="left", fill="both", expand=True)
        diff_sc.pack(side="right", fill="y")
        diff_txt.tag_configure("add",  foreground=self.XANH_LA)
        diff_txt.tag_configure("del",  foreground=self.DO)
        diff_txt.tag_configure("mod",  foreground=self.VANG)
        diff_txt.tag_configure("info", foreground=self.CHU_MO)
        diff_txt.config(state="disabled")

        # ── Safe wrapper: callback async check panel còn sống ──
        def safe(fn):
            def w(*a, **kw):
                try:
                    if not card.winfo_exists(): return
                except Exception:
                    return
                try:
                    fn(*a, **kw)
                except tk.TclError:
                    pass
                except Exception as e:
                    log_error(f"History callback fail: {e}\n{traceback.format_exc()}")
            return w

        state = {"commits": [], "loading": False}

        @safe
        def render_diff(lines):
            diff_txt.config(state="normal")
            diff_txt.delete("1.0", "end")
            if not lines:
                diff_txt.insert("end", "(Chưa chọn commit)\n", "info")
            else:
                for ln in lines:
                    if ln.startswith("➕"):   tag = "add"
                    elif ln.startswith("➖"): tag = "del"
                    elif ln.startswith("✏️"):  tag = "mod"
                    elif ln.startswith("  "):   tag = "mod"
                    else:                       tag = "info"
                    diff_txt.insert("end", ln + "\n", tag)
            diff_txt.config(state="disabled")

        @safe
        def populate_tv():
            for i in tv.get_children(): tv.delete(i)
            a = author_var.get()
            for i, c in enumerate(state["commits"]):
                if a != "Tất cả" and c["author"] != a: continue
                tv.insert("", "end", iid=str(i), values=(
                    c["date"].replace("T", " ").replace("Z", "")[:19],
                    c["author"],
                    c["msg"].split("\n")[0],
                    c["short"],
                ))

        def load_commits():
            if state["loading"]: return
            state["loading"] = True
            try: status.config(text="Đang tải commits...", fg=self.XANH_DUONG)
            except tk.TclError: return

            def task():
                return github_commits(GH_CONFIG, limit=int(limit_var.get()))

            @safe
            def done(commits):
                state["commits"] = commits
                authors = sorted({c["author"] for c in commits})
                author_cbb["values"] = ["Tất cả"] + authors
                if author_var.get() not in author_cbb["values"]:
                    author_var.set("Tất cả")
                populate_tv()
                status.config(text=f"✓ {len(commits)} commit",
                              fg=self.XANH_LA)
                state["loading"] = False

            @safe
            def err(e):
                status.config(text=f"✗ Lỗi: {e}", fg=self.DO)
                state["loading"] = False

            self._async(task, on_success=done, on_error=err)

        def on_select(event):
            sel = tv.selection()
            if not sel: return
            idx = int(sel[0])
            if idx >= len(state["commits"]): return
            commit = state["commits"][idx]
            parent = state["commits"][idx + 1] \
                     if idx + 1 < len(state["commits"]) else None
            try:
                status.config(text=f"Đang tải diff {commit['short']}...",
                              fg=self.XANH_DUONG)
            except tk.TclError:
                return

            def task():
                new_c = github_content_at_sha(GH_CONFIG, commit["sha"])
                old_c = github_content_at_sha(GH_CONFIG, parent["sha"]) \
                        if parent else "{}"
                return (new_c, old_c, commit, parent)

            @safe
            def done(res):
                new_c, old_c, c, p = res
                if not new_c:
                    render_diff([f"⚠ Không tải được nội dung {c['short']}"])
                    status.config(text="✗ Fetch fail", fg=self.DO)
                    return
                try:
                    new_raw = json.loads(new_c) if new_c else {}
                    old_raw = json.loads(old_c) if old_c else {}
                except Exception as ex:
                    render_diff([f"⚠ JSON lỗi: {ex}"])
                    status.config(text="✗ Parse fail", fg=self.DO)
                    return
                new_d = _normalize_simple(new_raw)
                old_d = _normalize_simple(old_raw) if old_raw else {}
                diffs = diff_data(old_d, new_d)
                head = (f"Commit {c['short']} bởi {c['author']} "
                        f"· {c['date'][:19]}")
                head += f"\nSo với {p['short']}" if p else "\n(commit đầu tiên)"
                head += f"\n{'-'*60}"
                render_diff([head] + diffs)
                status.config(text=f"✓ {len(diffs)} thay đổi",
                              fg=self.XANH_LA)

            @safe
            def err(e):
                render_diff([f"⚠ Lỗi: {e}"])
                status.config(text="✗ Lỗi", fg=self.DO)

            self._async(task, on_success=done, on_error=err)

        refresh_btn.config(command=load_commits)
        limit_cbb.bind("<<ComboboxSelected>>", lambda e: load_commits())
        author_cbb.bind("<<ComboboxSelected>>", lambda e: populate_tv())
        tv.bind("<<TreeviewSelect>>", on_select)

        render_diff([])
        load_commits()
    
    def _finish_close(self):
        try:
            save_settings(self.settings)
        except Exception as e:
            log_warn(f"Save settings on close: {e}")
        self.root.destroy()

    def khi_dong(self):
        if getattr(self, "_closing", False):
            return
        # Đang có lần lưu khác → chờ nó xong (tối đa 15s) rồi mới đóng
        if self._saving:
            if not hasattr(self, "_close_t0"):
                self._close_t0 = _time.time()
            if _time.time() - self._close_t0 < 15:
                self.root.after(200, self.khi_dong)
                return

        # Nếu đang load dở → đợi tối đa 1.5s
        if not getattr(self, "_data_loaded", True):
            for _ in range(15):
                if self._data_loaded:
                    break
                _time.sleep(0.1)

        for attr in ("_settings_cover", "_settings_overlay",
                     "_settings_shadow", "_settings_blur"):
            w = getattr(self, attr, None)
            if w is not None:
                try: w.destroy()
                except Exception: pass
                setattr(self, attr, None)
        if self.hen_gio_click:
            try: self.root.after_cancel(self.hen_gio_click)
            except Exception: pass

        # Chỉ ghi output.txt khi CÓ quyền ghi VÀ có thay đổi chưa lưu
        if self._dirty and not getattr(self, "read_only", False):
            self._closing = True
            self._saving = True          # chặn sửa/lưu chồng trong lúc đóng
            self.thong_bao("💾 Đang lưu trước khi thoát...", self.XANH_DUONG)
            self._start_progress()
            done = {"ok": False}
            snap_close = deepcopy(self.HocSinh)
            base_close = deepcopy(getattr(self, "_base", None))

            def _save():
                try:
                    ghi_file(snap_close, self.settings["ly_do_mac_dinh"],
                             DATA_FILE,
                             backup_count=self.settings["backup_count"],
                             base=base_close)
                except Exception as e:
                    log_error(f"Save on close: {e}")
                finally:
                    done["ok"] = True

            threading.Thread(target=_save, daemon=True).start()
            t0 = _time.time()

            def _wait():
                if done["ok"]:
                    self._finish_close()
                elif _time.time() - t0 > 15:
                    log_warn("Save on close timeout — đóng app ngay")
                    self._finish_close()
                else:
                    self.root.after(100, _wait)   # UI vẫn mượt, không join()
            _wait()
            return

        self._finish_close()


