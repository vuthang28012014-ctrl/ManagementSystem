    def cap_nhat_diem_danh(self):
        for item in self.bang_dd.get_children(): self.bang_dd.delete(item)
        ds_ma = sorted(self.HocSinh.keys(),
                       key=lambda s: self.HocSinh[s]["name"].lower())
        sel = self.bang.selection()
        ma_da_chon = [int(self.bang.item(i, "values")[0]) for i in sel] if sel else None

        for ma in ds_ma:
            d = self.HocSinh[ma]
            ten_hien = d["name"]
            to_str = f"T{d['to']} · " if d.get("to") else ""
