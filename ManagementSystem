    def _slide_up_panel_ct(self):
        if not self.settings.get("enable_animation", True): return
        if getattr(self, "_slide_busy", False): return
        self._slide_busy = True

        spacer = self.khung_ct_spacer
        steps = 8
        try:
            spacer.configure(height=28)
        except Exception:
            self._slide_busy = False
            return

        def step(i):
            try:
                if i > steps:
                    spacer.configure(height=0)
                    self._slide_busy = False
                    return
                k = i / steps
                k = 1 - (1 - k) ** 3
                spacer.configure(height=int(_lerp(28, 0, k)))
                spacer.after(16, lambda: step(i + 1))
            except Exception:
                self._slide_busy = False
        step(1)

    def _pulse_locked(self, ma=None):
        if not self.settings.get("enable_animation", True): return

        if ma is not None:
            for i in range(3):
                self.bang_dd.after(
                    i * 140,
                    lambda m=ma: flash_row(self.bang_dd, str(m),
                                            color="#5b2d3f", duration=120)
                )
        try:
            orig = self.khung_tuan.cget("bg")
            pulse = "#5b2d3f"
            def do_pulse():
                animate_color(self.khung_tuan, orig, pulse,
                              duration=100, steps=5, attr="bg",
                              on_done=lambda: animate_color(
                                  self.khung_tuan, pulse, orig,
                                  duration=220, steps=7, attr="bg"))
            self.khung_tuan.after(1, do_pulse)
        except Exception:
            pass

    def _spawn_confetti(self, count=90):
        if not self.settings.get("enable_confetti", True): return
        if not self.settings.get("enable_animation", True): return

        try:
            root = self.root
            root.update_idletasks()
            rx, ry = root.winfo_rootx(), root.winfo_rooty()
            rw, rh = root.winfo_width(), root.winfo_height()
        except Exception:
            return

        try:
            overlay = tk.Toplevel(root)
            overlay.overrideredirect(True)
            overlay.geometry(f"{rw}x{rh}+{rx}+{ry}")
            overlay.attributes("-topmost", True)
            overlay.attributes("-transparentcolor", "#010101")
            overlay.configure(bg="#010101")
        except Exception:
            try: overlay.destroy()
            except Exception: pass
            return   # Linux/macOS không hỗ trợ → bỏ qua

        canvas = tk.Canvas(overlay, bg="#010101",
                            highlightthickness=0, bd=0)
        canvas.pack(fill="both", expand=True)

        colors = ["#f38ba8", "#a6e3a1", "#89b4fa", "#f9e2af",
                  "#cba6f7", "#fab387", "#74c7ec", "#eba0ac"]

        particles = []
        for _ in range(count):
            x = rw // 2 + random.randint(-rw//3, rw//3)
            y = rh // 3 + random.randint(-rh//6, rh//6)
            size = random.randint(5, 12)
            try:
                pid = canvas.create_rectangle(
                    x, y, x+size, y+size,
                    fill=random.choice(colors), outline="")
            except Exception:
                continue
            particles.append({
                "id": pid, "x": x, "y": y,
                "vx": random.uniform(-7, 7),
                "vy": random.uniform(-16, -5),
                "size": size,
                "life": 0,
                "max_life": random.randint(70, 130),
            })

        if not particles:
            try: overlay.destroy()
            except Exception: pass
            return

        def animate():
            alive = 0
            for p in particles:
                p["life"] += 1
                if p["life"] > p["max_life"]:
                    try: canvas.delete(p["id"])
                    except Exception: pass
                    continue
                p["vy"] += 0.5
                p["vx"] *= 0.995
                p["x"] += p["vx"]
                p["y"] += p["vy"]
                if p["y"] > rh + 60:
                    try: canvas.delete(p["id"])
                    except Exception: pass
                    continue
                try:
                    canvas.coords(p["id"],
                                  p["x"], p["y"],
                                  p["x"]+p["size"], p["y"]+p["size"])
                    if p["life"] % 10 == 0:
                        canvas.itemconfigure(p["id"],
                                              fill=random.choice(colors))
                except Exception:
                    continue
                alive += 1
            if alive > 0:
                overlay.after(16, animate)
            else:
                try: overlay.destroy()
                except Exception: pass

        def _auto_kill():
            try:
                if overlay.winfo_exists(): overlay.destroy()
            except Exception: pass
        overlay.after(6000, _auto_kill)
        animate()

