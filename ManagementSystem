def _chia_tin_nhan(text, limit=1800):
    """Chia tin dài thành nhiều phần <= limit ký tự, cắt theo dòng.
    (Giới hạn độ dài của Zalo Bot mình chưa kiểm chứng; 1800 là mức đặt an toàn.)"""
    parts, cur = [], ""
    for line in text.split("\n"):
        while len(line) > limit:
            if cur:
                parts.append(cur)
                cur = ""
            parts.append(line[:limit])
            line = line[limit:]
        if cur and len(cur) + 1 + len(line) > limit:
            parts.append(cur)
            cur = line
        else:
            cur = line if not cur else cur + "\n" + line
    if cur.strip():
        parts.append(cur)
    return parts or [text]


def _build_zalo_absent_message(hoc_sinh, tuan, ly_do_md, min_absent=1):
    """Tạo tin nhắn thông báo HS vắng cho Zalo."""
    vang = []
    for ma, d in hoc_sinh.items():
        w = d.get("weeks", {}).get(tuan) or {}
        att = w.get("attendance", {})
        rea = w.get("reasons", {})
        n_vang = 0
        chi_tiet = []
        for day in THU:
            lo = phan_loai_o(att.get(day, False), rea.get(day, ""), ly_do_md)
            if lo in ("vp", "vkp"):
                r = (rea.get(day, "") or "").strip()
                loai = "✗" if lo == "vp" else "⊘"
                n_vang += 1
                chi_tiet.append(f"  {loai} {day} ({_html.escape(r)})")
        if n_vang >= min_absent:
            vang.append({
                "ma": ma,
                "name": _html.escape(str(d["name"])),
                "class": _html.escape(str(d["class"])),
                "to": _html.escape(str(d.get("to", "") or "")) or "—",
                "n_vang": n_vang, "chi_tiet": chi_tiet,
            })

    if not vang:
        return ""

    vang.sort(key=lambda x: (-x["n_vang"], x["name"].lower()))

    # Zalo Bot hỗ trợ HTML: <b>, <i>, <u>, <s>, <code>
    lines = [
        f"⚠️ <b>THÔNG BÁO VẮNG — TUẦN {tuan}</b>",
        f"Thời gian: {datetime.now().strftime('%d/%m/%Y %H:%M')}",
        f"Số HS vắng: <b>{len(vang)}</b>",
        "",
    ]
    for i, v in enumerate(vang, 1):
        to = f" · Tổ {v['to']}" if v["to"] != "—" else ""
        lines.append(
            f"<b>{i}. {v['name']}</b> — Mã {v['ma']} · Lớp {v['class']}{to} "
            f"— vắng <b>{v['n_vang']}</b> buổi")
        for ct in v["chi_tiet"]:
            lines.append(ct)
        lines.append("")
    return "\n".join(lines)
