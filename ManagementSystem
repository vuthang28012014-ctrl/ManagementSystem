# DỮ LIỆU
# ═══════════════════════════════════════════════════════════════
HocSinh = {}
TEN_FILE = "output.txt"
THU = ["T2", "T3", "T4", "T5", "T6", "T7", "CN"]
COT_DIEMDANH = ["ten"] + THU
LY_DO_MAC_DINH = "Không phép"
DO_TRE_CLICK_DUP = 220

TONG_TUAN = 35
TUAN_HK1 = 18
TUAN_HK2 = 17


def diem_danh_moi(): return {d: False for d in THU}
def ly_do_moi():     return {d: "" for d in THU}
def loi_moi():       return {d: "" for d in THU}

def tuan_moi():
    return {"attendance": diem_danh_moi(),
            "reasons": ly_do_moi(),
            "errors": loi_moi()}

def tao_du_lieu_tat_ca_tuan():
    return {t: tuan_moi() for t in range(1, TONG_TUAN + 1)}

def ten_hoc_ky(tuan):
    return "Học kỳ 1" if tuan <= TUAN_HK1 else "Học kỳ 2"


def _chuan_hoa_tuan(w):
    if not isinstance(w, dict): w = {}
    w.setdefault("attendance", diem_danh_moi())
    w.setdefault("reasons", ly_do_moi())
    w.setdefault("errors", loi_moi())
    for d in THU:
        w["attendance"].setdefault(d, False)
        w["reasons"].setdefault(d, "")
        w["errors"].setdefault(d, "")
    return w


