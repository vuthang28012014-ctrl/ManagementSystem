    # GITHUB ACTIONS
    # ═══════════════════════════════════════════════════════════
    def keo_github(self):
        """Nút Tải từ GitHub — fetch data mới, hỏi trước khi ghi đè."""
        global GH_CONFIG
        if not GH_CONFIG:
            self.thong_bao("⚠ Chưa có github_config.json", self.VANG)
            return

        if HocSinh:
            ok = messagebox.askyesno(
                "Xác nhận tải",
                "Tải data mới từ GitHub sẽ GHI ĐÈ data hiện tại.\n"
                "Mọi thay đổi chưa Save sẽ MẤT.\n\n"
                "Tiếp tục?")
            if not ok:
                return

        self.thong_bao("☁ Đang tải từ GitHub...", self.XANH_DUONG)
        self.root.update()

        content = github_fetch(GH_CONFIG)
        if not content:
            self.thong_bao("✗ Không tải được từ GitHub", self.DO)
            return

        # Xóa data cũ + parse mới
        HocSinh.clear()
        try:
            raw = json.loads(content)
        except Exception as e:
            self.thong_bao(f"✗ Data GitHub hỏng: {e}", self.DO)
            return

        for sid_str, info in raw.items():
            sid = int(sid_str)
            if "weeks" not in info:
                info["weeks"] = tao_du_lieu_tat_ca_tuan()
                info["weeks"][1]["attendance"] = info.get("attendance", diem_danh_moi())
                info["weeks"][1]["reasons"]    = info.get("reasons", ly_do_moi())
                info["weeks"][1]["errors"]     = info.get("errors", loi_moi())
                for k in ("attendance", "reasons", "errors"):
                    info.pop(k, None)
            for t in range(1, TONG_TUAN + 1):
                if t not in info["weeks"]:
                    info["weeks"][t] = tuan_moi()
                else:
                    info["weeks"][t] = _chuan_hoa_tuan(info["weeks"][t])
            HocSinh[sid] = info

        # Lưu local luôn
        try:
            with open(TEN_FILE, "w", encoding="utf-8") as f:
                f.write(content)
        except Exception:
            pass

        self.cap_nhat_bang()
        self.cap_nhat_diem_danh()
        self._xoa_panel_ct()
        self.thong_bao(f"✓ Đã tải {len(HocSinh)} HS từ GitHub", self.XANH_LA)

    # ═══════════════════════════════════════════════════════════
    # TUẦN
    # ═══════════════════════════════════════════════════════════
    def _khi_doi_tuan(self, event=None):
        s = self.bien_tuan.get()
        try:
            t = int(s.split()[1])
        except Exception:
            return
        self.tuan_hien_tai = t
        self.nhan_hk.config(text=ten_hoc_ky(t))
        self.o_hien_tai = None
        self._xoa_panel_ct()
        self.cap_nhat_diem_danh()
        self.thong_bao(f"Đang xem Tuần {t} — {ten_hoc_ky(t)}", self.XANH_DUONG)

    def _tuan_truoc(self):
        t = max(1, self.tuan_hien_tai - 1)
        self.bien_tuan.set(f"Tuần {t}")
        self._khi_doi_tuan()

    def _tuan_sau(self):
        t = min(TONG_TUAN, self.tuan_hien_tai + 1)
        self.bien_tuan.set(f"Tuần {t}")
        self._khi_doi_tuan()

    def _du_lieu_tuan(self, ma, tuan=None):
        d = HocSinh.get(ma)
        if not d: return None
        t = tuan if tuan is not None else self.tuan_hien_tai
        weeks = d.setdefault("weeks", tao_du_lieu_tat_ca_tuan())
        if t not in weeks:
            weeks[t] = tuan_moi()
        else:
            weeks[t] = _chuan_hoa_tuan(weeks[t])
        return weeks[t]

    # ────── Thao tác học sinh ──────
    def them_hoc_sinh(self):
        ma_str = self.o_ma.get().strip()
        ten    = self.o_ten.get().strip()
        lop    = self.o_lop.get().strip()
        if not ma_str or not ten or not lop:
            self.thong_bao("⚠ Vui lòng nhập đầy đủ Mã, Họ tên và Lớp", self.VANG); return
        try:
            ma = int(ma_str)
        except ValueError:
            self.thong_bao("⚠ Mã học sinh phải là số nguyên", self.DO)
            self.o_ma.focus_set(); return
        if ma in HocSinh:
            self.thong_bao(f"⚠ Mã {ma} đã tồn tại", self.DO)
            self.o_ma.focus_set(); return
        HocSinh[ma] = {
            "name": ten, "class": lop,
            "weeks": tao_du_lieu_tat_ca_tuan(),
        }
        self.xoa_form()
        self.cap_nhat_bang()
        self.cap_nhat_diem_danh()
        self.thong_bao(f"✓ Đã thêm: {ten} (Mã {ma}, {lop})", self.XANH_LA)

    def xoa_da_chon(self):
        sel = self.bang.selection()
        if not sel:
            self.thong_bao("⚠ Chưa chọn học sinh nào để xóa", self.VANG); return
        ds_ma = [int(self.bang.item(i, "values")[0]) for i in sel]
        ds_ten = [HocSinh[s]["name"] for s in ds_ma if s in HocSinh]
        if not messagebox.askyesno("Xác nhận xóa",
            f"Xóa {len(ds_ma)} học sinh?\n\n" + "\n".join(f"• {n}" for n in ds_ten)):
            return
        for ma in ds_ma: HocSinh.pop(ma, None)
        self.cap_nhat_bang(); self.cap_nhat_diem_danh(); self._xoa_panel_ct()
        self.thong_bao(f"✓ Đã xóa {len(ds_ma)} học sinh", self.XANH_LA)

