        def _move_indicator(old_key, new_key):
            # Hủy animation đang chạy
            if _ind_anim["job"]:
                try: self.root.after_cancel(_ind_anim["job"])
                except Exception: pass
                _ind_anim["job"] = None

            if new_key not in tab_btns:
                return

            n = tab_btns[new_key]
            nx = n["x"] + n["w"] // 2
            ny = n["y"] + n["h"] // 2
            nw = n["w"]
            nh = n["h"]

            # Lần đầu hoặc không có tab cũ → hiện ngay
            if old_key is None or old_key not in tab_btns:
                try:
                    tab_bar.coords(indicator_id, *_rr_coords(
                        nx - nw / 2, ny - nh / 2,
                        nx + nw / 2, ny + nh / 2,
                    ))
                except Exception:
                    pass
                _set_text_colors(new_key)
                return

            o = tab_btns[old_key]
            ox = o["x"] + o["w"] // 2
            oy = o["y"] + o["h"] // 2
            ow = o["w"]
            oh = o["h"]

            # Đổi màu text cũ ngay, text mới sau khi anim xong
            try:
                tab_bar.itemconfigure(o["text_id"], fill=self.CHU_MO)
            except Exception:
                pass

            total = 16
            def _step(i):
                if i > total:
                    _ind_anim["job"] = None
                    # Đảm bảo vị trí cuối chính xác
                    try:
                        tab_bar.coords(indicator_id, *_rr_coords(
                            nx - nw / 2, ny - nh / 2,
                            nx + nw / 2, ny + nh / 2,
                        ))
                    except Exception:
                        pass
                    _set_text_colors(new_key)
                    return
                t = i / total
                # Ease-out cubic cho mượt
                k = 1 - (1 - t) ** 3
                cx = ox + (nx - ox) * k
                cy = oy + (ny - oy) * k
                cw = ow + (nw - ow) * k
                ch = oh + (nh - oh) * k
                try:
                    tab_bar.coords(indicator_id, *_rr_coords(
                        cx - cw / 2, cy - ch / 2,
                        cx + cw / 2, cy + ch / 2,
                    ))
                except Exception:
                    return
                _ind_anim["job"] = self.root.after(16,
                                                    lambda: _step(i + 1))

            _step(0)

