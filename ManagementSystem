            ws_chart.column_dimensions[col_letter].width = 12

        # ═══ SẮP XẾP SHEET ═══
        # Thứ tự mong muốn: Tổng hợp | Biểu đồ | Tuần 1..N | _data_charts
        # 1. Đưa "Biểu đồ" lên ngay sau "Tổng hợp"
        wb.move_sheet("Biểu đồ", offset=-(len(wb.sheetnames) - 2))
        # 2. Đưa "_data_charts" xuống cuối
        wb.move_sheet("_data_charts", offset=1000)

        wb.save(path)
        log_info(f"✓ Xuất Excel all: {path} ({TONG_TUAN} tuần)")
        return True
    except Exception as e:
        log_error(f"Xuất xlsx-all fail: {e}\n{traceback.format_exc()}")
        return False

def _build_html_report(hoc_sinh, path, ly_do_md, tuan=None, for_word=False, period=None):
    """
    Xuất báo cáo HTML. Chạy trong thread.
    - tuan: nếu có → xuất riêng 1 tuần
    - period: "year" | "hk1" | "hk2" | "month_N" → xuất theo kỳ
    Trả True nếu OK.
    """
    try:
        def esc(s):
            return (str(s).replace("&", "&amp;")
                           .replace("<", "&lt;")
                           .replace(">", "&gt;"))

        if period:
            WEEKS = _get_weeks_for_period(period)
        else:
            WEEKS = list(range(1, TONG_TUAN + 1))
        if not WEEKS:
            WEEKS = list(range(1, TONG_TUAN + 1))

        weeks_used = [tuan] if tuan else WEEKS
        stats = compute_stats(hoc_sinh, weeks_used, ly_do_md)
        hs_order = stats["hs_order"]

        if tuan:
            title = f"BÁO CÁO CHUYÊN CẦN — TUẦN {tuan}"
