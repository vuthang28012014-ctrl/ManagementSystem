            header, textvariable=period_var,
            values=[lbl for _, lbl in period_labels],
            state="readonly", width=12, font=("Segoe UI", 10))
        period_cbb.pack(side="left", padx=(0, 10))
        # Sync label → value
        lbl_to_val = {lbl: val for val, lbl in period_labels}
        val_to_lbl = {val: lbl for val, lbl in period_labels}
        period_cbb.set(val_to_lbl[period_var.get()])

        tk.Label(header,
                 text=f"{len(self.HocSinh)} học sinh",
                 bg=self.NEN2, fg=self.CHU_MO,
                 font=("Segoe UI", 10)).pack(side="left", padx=(0, 10))

