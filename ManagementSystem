    def _tao_nut(self, parent, text, cmd, bg, hover):
        fg = "#1e1e2e" if bg not in (self.NEN3, self.NEN2) else self.CHU
        b = tk.Button(parent, text=text, command=cmd,
                      bg=bg, fg=fg, activebackground=hover, activeforeground=fg,
                      relief="flat", cursor="hand2",
                      font=("Segoe UI", 10, "bold"), bd=0)

        anim_on = self.settings.get("enable_animation", True)

        if not anim_on:
            b.bind("<Enter>", lambda e: b.configure(bg=hover))
            b.bind("<Leave>", lambda e: b.configure(bg=bg))
            return b

        def on_enter(e):
            if getattr(b, "_anim_busy", False): return
            b._anim_busy = True
            animate_color(b, bg, hover, duration=140, steps=7, attr="bg",
                          on_done=lambda: setattr(b, "_anim_busy", False))

        def on_leave(e):
            if getattr(b, "_anim_busy", False): return
            b._anim_busy = True
            animate_color(b, hover, bg, duration=180, steps=7, attr="bg",
                          on_done=lambda: setattr(b, "_anim_busy", False))

        b.bind("<Enter>", on_enter)
        b.bind("<Leave>", on_leave)
        return b

    # ═══ Undo/Redo ═══
    def _snapshot(self, label):
        snap = deepcopy(self.HocSinh)
        self.undo_stack.push(snap, label)
        self._dirty = True

    def undo(self):
        if not self.undo_stack.can_undo():
            self.thong_bao("Không có gì để undo", self.CHU_MO); return
        cur_snap = deepcopy(self.HocSinh)
        snap, label, _ = self.undo_stack.do_undo()
        self.undo_stack.push_redo(cur_snap, label)
        self.HocSinh = snap
        self._xoa_panel_ct()
        self.cap_nhat_bang()
        self.cap_nhat_diem_danh()
        self.thong_bao(f"↩ Undo: {label}", self.VANG)

    def redo(self):
        if not self.undo_stack.can_redo():
            self.thong_bao("Không có gì để redo", self.CHU_MO); return
        cur_snap = deepcopy(self.HocSinh)
        snap, label, _ = self.undo_stack.do_redo()
        self.undo_stack.push(cur_snap, label)
        self.HocSinh = snap
        self._xoa_panel_ct()
        self.cap_nhat_bang()
        self.cap_nhat_diem_danh()
        self.thong_bao(f"↪ Redo: {label}", self.XANH_LA)

    # ═══ GitHub Actions ═══
    def keo_github(self):
        if not self._can_write(): return          # ← THÊM DÒNG NÀY
        global GH_CONFIG
        if not GH_CONFIG:
            self.thong_bao("⚠ Chưa có github_config.json", self.VANG); return

        if self.HocSinh:
            ok = messagebox.askyesno(
                "Xác nhận",
                "Tải data mới từ GitHub sẽ GHI ĐÈ data hiện tại.\n"
                "Mọi thay đổi chưa Save sẽ MẤT.\n\nTiếp tục?")
            if not ok: return

        self.thong_bao("☁ Đang tải từ GitHub...", self.XANH_DUONG)

        def task():
            return github_fetch(GH_CONFIG)

        def on_done(content):
            if not content:
                self.thong_bao("✗ Không tải được từ GitHub", self.DO); return
            try:
                raw = json.loads(content)
            except Exception as e:
                self.thong_bao(f"✗ Data GitHub hỏng: {e}", self.DO); return

            # Backup trước khi ghi đè
            _backup_file(DATA_FILE, keep=self.settings["backup_count"])

            self._snapshot("Pull GitHub")
            self.HocSinh.clear()

            for sid_str, info in raw.items():
                if sid_str == "_meta":
                    continue
                try: sid = int(sid_str)
                except ValueError: continue
                if "weeks" not in info:
                    info["weeks"] = tao_du_lieu_tat_ca_tuan()
                    info["weeks"][1]["attendance"] = info.get("attendance", diem_danh_moi())
                    info["weeks"][1]["reasons"]    = info.get("reasons",    ly_do_moi())
                    info["weeks"][1]["errors"]     = info.get("errors",     loi_moi())
                    for k in ("attendance", "reasons", "errors"):
                        info.pop(k, None)
                weeks_int = {}
                for k, v in info["weeks"].items():
                    try:
                        t_int = int(k)
                    except (ValueError, TypeError):
                        continue
                    weeks_int[t_int] = _chuan_hoa_tuan(v)

                for t in range(1, TONG_TUAN + 1):
                    if t not in weeks_int:
                        weeks_int[t] = tuan_moi()

                info["weeks"] = weeks_int
                if not validate_hs_info(info):
                    info["name"]  = str(info.get("name",  ""))
                    info["class"] = str(info.get("class", ""))
                self.HocSinh[sid] = info

            try:
                with open(DATA_FILE, "w", encoding="utf-8") as f:
                    f.write(content)
            except Exception:
                pass

            self.cap_nhat_bang()
            self.cap_nhat_diem_danh()
            self._xoa_panel_ct()
            self.thong_bao(f"✓ Đã tải {len(self.HocSinh)} HS từ GitHub", self.XANH_LA)

        self._async(task, on_success=on_done)

    # ═══ Tuần ═══
    def _khi_doi_tuan(self, event=None):
        s = self.bien_tuan.get()
        try: t = int(s.split()[1])
        except Exception: return
        self.tuan_hien_tai = t
        self.nhan_hk.config(text=ten_hoc_ky(t))
        self.o_hien_tai = None
        self._xoa_panel_ct()
        self.cap_nhat_diem_danh()
        self.thong_bao(f"Đang xem Tuần {t} — {ten_hoc_ky(t)}", self.XANH_DUONG)

    def _tuan_truoc(self):
        t = max(1, self.tuan_hien_tai - 1)
        self.bien_tuan.set(f"Tuần {t}")
        self._khi_doi_tuan()

    def _tuan_sau(self):
        t = min(TONG_TUAN, self.tuan_hien_tai + 1)
        self.bien_tuan.set(f"Tuần {t}")
        self._khi_doi_tuan()

    def _du_lieu_tuan(self, ma, tuan=None):
        d = self.HocSinh.get(ma)
        if not d: return None
        t = tuan if tuan is not None else self.tuan_hien_tai
        weeks = d.setdefault("weeks", tao_du_lieu_tat_ca_tuan())

        # ── FIX: nếu lỡ có key string thì normalize về int ──
        if weeks and any(isinstance(k, str) for k in weeks.keys()):
            weeks_int = {}
            for k, v in weeks.items():
                try:
                    weeks_int[int(k)] = _chuan_hoa_tuan(v)
                except (ValueError, TypeError):
                    continue
            for ti in range(1, TONG_TUAN + 1):
                weeks_int.setdefault(ti, tuan_moi())
            d["weeks"] = weeks_int
            weeks = weeks_int

        if t not in weeks:
            weeks[t] = tuan_moi()
        else:
            weeks[t] = _chuan_hoa_tuan(weeks[t])
        return weeks[t]

    def _tuan_co_the_sua(self, tuan=None):
        t = tuan if tuan is not None else self.tuan_hien_tai
        return t <= self.settings["max_editable_week"]

    def _set_form_mode(self, mode="add"):
        """Đổi nút Thêm/Sửa tuỳ mode."""
        if not hasattr(self, "nut_them_sua"): return
        if mode == "edit":
            self.nut_them_sua.config(
                text="💾  Cập nhật học sinh",
                bg=self.CAM, fg="#1e1e2e")
        else:  # add
            self.nut_them_sua.config(
                text="➕  Thêm học sinh",
                bg=self.XANH_DUONG, fg="#1e1e2e")

        # Fix lại bind hover (nếu có animation)
        anim_on = self.settings.get("enable_animation", True)
        if anim_on:
            hover = "#f5a76c" if mode == "edit" else self.XANH_DUONG_H
            base  = self.CAM     if mode == "edit" else self.XANH_DUONG
            self.nut_them_sua.unbind("<Enter>")
            self.nut_them_sua.unbind("<Leave>")
            def _on(e, b=base, h=hover):
                if getattr(self.nut_them_sua, "_anim_busy", False): return
                self.nut_them_sua._anim_busy = True
                animate_color(self.nut_them_sua, b, h,
                              duration=140, steps=7, attr="bg",
                              on_done=lambda: setattr(
                                  self.nut_them_sua, "_anim_busy", False))
            def _off(e, b=base, h=hover):
                if getattr(self.nut_them_sua, "_anim_busy", False): return
                self.nut_them_sua._anim_busy = True
                animate_color(self.nut_them_sua, h, b,
                              duration=180, steps=7, attr="bg",
                              on_done=lambda: setattr(
                                  self.nut_them_sua, "_anim_busy", False))
            self.nut_them_sua.bind("<Enter>", _on)
            self.nut_them_sua.bind("<Leave>", _off)

    # ═══ HS CRUD ═══
    def them_hoc_sinh(self):
        """Thêm mới nếu Mã chưa có, cập nhật nếu Mã đã tồn tại."""
        if not self._can_write(): return          # ← THÊM DÒNG NÀY
        ma_str = self.o_ma.get().strip()
        ten    = self.o_ten.get().strip()
        lop    = self.o_lop.get().strip()
        to     = self.o_to.get().strip()

        if not ma_str or not ten or not lop:
            self.thong_bao("⚠ Nhập đầy đủ Mã, Tên, Lớp", self.VANG)
            return
        try:
            ma = int(ma_str)
        except ValueError:
            self.thong_bao("⚠ Mã phải là số nguyên", self.DO)
            self.o_ma.focus_set()
            return

        # Chuẩn hóa tổ
        if to and to not in ("1", "2", "3", "4"):
            self.thong_bao("⚠ Tổ phải là 1, 2, 3, 4 hoặc để trống", self.VANG)
            self.o_to.focus_set()
            return

        to_str = f", Tổ {to}" if to else ""

        # ── TRƯỜNG HỢP 1: ĐÃ TỒN TẠI → SỬA ──
        if ma in self.HocSinh:
            d = self.HocSinh[ma]
            old_name  = d.get("name",  "")
            old_class = d.get("class", "")
            old_to    = d.get("to",    "")

            # Không có gì đổi → thoát
            if old_name == ten and old_class == lop and old_to == to:
                self.thong_bao("⚠ Không có gì thay đổi", self.CHU_MO)
                return

            self._snapshot(f"Sửa HS {ma}")

            # Cập nhật từng field
            d["name"]  = ten
            d["class"] = lop
            d["to"]    = to

            self.xoa_form()
            self.cap_nhat_bang()
            self.cap_nhat_diem_danh()

            # Thông báo chi tiết cái gì đổi
            changes = []
            if old_name  != ten: changes.append(f"tên '{old_name}' → '{ten}'")
            if old_class != lop: changes.append(f"lớp '{old_class}' → '{lop}'")
            if old_to    != to:
                o = old_to if old_to else "∅"
                n = to      if to      else "∅"
                changes.append(f"tổ {o} → {n}")

            detail = " · ".join(changes) if changes else "cập nhật"
            self.thong_bao(f"✓ Đã sửa mã {ma}: {detail}", self.CAM)

            # Flash row vừa sửa
            if self.settings.get("enable_animation", True):
                self.bang.after(50, lambda: flash_row(
                    self.bang, str(ma), color="#5a5a3f", duration=500))
                self.bang_dd.after(50, lambda: flash_row(
                    self.bang_dd, str(ma), color="#5a5a3f", duration=500))
            return

        # ── TRƯỜNG HỢP 2: CHƯA TỒN TẠI → THÊM MỚI ──
        self._snapshot(f"Thêm HS {ma}")
        self.HocSinh[ma] = {
            "name": ten, "class": lop, "to": to,
            "weeks": tao_du_lieu_tat_ca_tuan(),
        }
        self.xoa_form()
        self.cap_nhat_bang()
        self.cap_nhat_diem_danh()
        self.thong_bao(
            f"✓ Đã thêm: {ten} (Mã {ma}, {lop}{to_str})", self.XANH_LA)

        # Flash row mới
        if self.settings.get("enable_animation", True):
            self.bang.after(50, lambda: flash_row(
                self.bang, str(ma), color="#3f5a3f", duration=500))

    def xoa_da_chon(self):
        if not self._can_write(): return          # ← THÊM DÒNG NÀY
        sel = self.bang.selection()
        if not sel:
            self.thong_bao("⚠ Chưa chọn HS nào", self.VANG); return
        ds_ma = []
        for i in sel:
            try:
                ds_ma.append(int(self.bang.item(i, "values")[0]))
            except (ValueError, IndexError, TypeError):
                continue
        if not ds_ma:
            self.thong_bao("⚠ Không đọc được mã HS", self.DO); return
        ds_ten = [self.HocSinh[s]["name"] for s in ds_ma if s in self.HocSinh]
        if not messagebox.askyesno("Xác nhận xóa",
            f"Xóa {len(ds_ma)} học sinh?\n\n" + "\n".join(f"• {n}" for n in ds_ten)):
            return
        self._snapshot(f"Xóa {len(ds_ma)} HS")
        for ma in ds_ma: self.HocSinh.pop(ma, None)
        self.cap_nhat_bang()
        self.cap_nhat_diem_danh()
        self._xoa_panel_ct()
        self.thong_bao(f"✓ Đã xóa {len(ds_ma)} HS (Ctrl+Z để hoàn tác)", self.XANH_LA)

    def luu_ngay(self):
        if not self._can_write(): return          # ← THÊM DÒNG NÀY
        if self._saving:
            self.thong_bao("⏳ Đang lưu...", self.VANG)
            return
        self._saving = True
        self.thong_bao("💾 Đang pull → merge → push...", self.XANH_DUONG)
        self._start_progress()          # ← THÊM DÒNG NÀY

        # Snapshot để thread dùng (tránh race condition)
        local_snapshot = deepcopy(self.HocSinh)
        ly_do_md = self.settings["ly_do_mac_dinh"]

        # Snapshot tham chiếu SAU auto-fill (giống ghi_file sẽ làm)
        # để so sánh chính xác, tránh false positive
        local_ref = deepcopy(local_snapshot)
        for sid_r, d_r in local_ref.items():
            for t_r, w_r in d_r.get("weeks", {}).items():
                att_r = w_r.get("attendance", {})
                rea_r = w_r.setdefault("reasons", {})
                for day_r in THU:
                    if (not att_r.get(day_r, False)
                            and not rea_r.get(day_r, "").strip()):
                        rea_r[day_r] = ly_do_md

        def task():
            return ghi_file(local_snapshot, ly_do_md, DATA_FILE,
                            backup_count=self.settings["backup_count"])

        def on_done(res):
            ok_local, ok_gh, err, merged = res
            self._saving = False

            # ── So sánh để cảnh báo máy khác đã sửa ──
            if merged is not None:
                try:
                    local_int = {int(k): v for k, v in local_ref.items()}
                    warn = _diff_for_warning(local_int, merged)
                    total = (len(warn["new_hs"])
                             + warn["att_changes"]
                             + warn["reason_changes"]
                             + warn["error_changes"])
                    if total > 0:
                        lines = ["🔄 Phát hiện thay đổi từ máy khác "
                                 "— đã tự động merge:\n"]
                        if warn["new_hs"]:
                            names = warn["new_hs"][:10]
                            lines.append(
                                f"➕ {len(warn['new_hs'])} HS mới:")
                            for n in names:
                                lines.append(f"   • {n}")
                            if len(warn["new_hs"]) > 10:
                                lines.append(
                                    f"   ... và {len(warn['new_hs'])-10} HS khác")
                        if warn["deleted_hs"]:
                            lines.append(
                                f"➖ {len(warn['deleted_hs'])} HS bị xóa")
                        if warn["att_changes"]:
                            lines.append(
                                f"✓ {warn['att_changes']} ô điểm danh thay đổi")
                        if warn["reason_changes"]:
                            lines.append(
                                f"✏ {warn['reason_changes']} lý do thay đổi")
                        if warn["error_changes"]:
                            lines.append(
                                f"⚠ {warn['error_changes']} lỗi thay đổi")
                        lines.append("\nDữ liệu đã được cập nhật "
                                     "— kiểm tra lại nếu cần.")
                        self.root.after(200, lambda: messagebox.showinfo(
                            "Đã merge với máy khác", "\n".join(lines)))
                except Exception as e:
                    log_warn(f"Diff warning fail: {e}")
            self._progress_running = False
            self._progress_pos     = 0
            if self._tw_job:
                try: self.root.after_cancel(self._tw_job)
                except Exception: pass
                self._tw_job = None
            self._slide_busy       = False
            self._dirty = False
            self._stop_progress()

            # Update UI với bản merged (nếu có)
            if merged is not None:
                self.HocSinh.clear()
                for k, v in merged.items():
                    self.HocSinh[k] = v
                self.cap_nhat_bang()
                self.cap_nhat_diem_danh()
                log_info(f"UI refresh với {len(self.HocSinh)} HS sau merge")

            n = len(self.HocSinh)
            if ok_local and ok_gh:
                self.thong_bao(f"✓ Pull-merge-push {n} HS lên GitHub", self.XANH_LA)
                self._spawn_confetti()
            elif ok_local:
                msg = f"✓ Local OK ({n} HS)"
                if GH_CONFIG:
                    msg += f" · ⚠ GitHub: {err or 'fail'}"
                self.thong_bao(msg, self.VANG)
            else:
                self.thong_bao("✗ Lỗi lưu — xem app.log", self.DO)

        def on_err(e):
            self._saving = False
            self._progress_running = False
            self._progress_pos     = 0
            if self._tw_job:
                try: self.root.after_cancel(self._tw_job)
                except Exception: pass
                self._tw_job = None
            self._slide_busy       = False
            self._dirty = False
            self._stop_progress()
            self.thong_bao(f"✗ Lỗi: {e}", self.DO)

        self._async(task, on_success=on_done, on_error=on_err)

    def xoa_form(self):
