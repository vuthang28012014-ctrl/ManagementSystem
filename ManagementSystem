    # ═══ Tìm kiếm ═══
    def _schedule_filter(self):
        if self._debounce_job:
            self.root.after_cancel(self._debounce_job)
        ms = self.settings["filter_debounce_ms"]
        self._debounce_job = self.root.after(ms, self._apply_filter)

    def _apply_filter(self):
        self._debounce_job = None
        self.cap_nhat_bang()

    def _thoa_filter(self, ma, d):
        q = self.bien_tim_kiem.get().strip().lower()
        if q:
            if not (q in str(ma).lower()
                    or q in str(d["name"]).lower()
                    or q in str(d["class"]).lower()):
                return False
        if self.bien_tim_ma is not None:
            m = self.bien_tim_ma.get().strip()
            if m and m not in str(ma): return False
        if self.bien_tim_ten is not None:
            t = self.bien_tim_ten.get().strip().lower()
            if t and t not in str(d["name"]).lower(): return False
        if self.bien_tim_lop is not None:
            l = self.bien_tim_lop.get().strip().lower()
            if l and l not in str(d["class"]).lower(): return False
        return True

    def _co_filter(self):
        return bool(
            self.bien_tim_kiem.get().strip()
            or (self.bien_tim_ma  and self.bien_tim_ma.get().strip())
            or (self.bien_tim_ten and self.bien_tim_ten.get().strip())
            or (self.bien_tim_lop and self.bien_tim_lop.get().strip())
        )

    def tim_kiem(self):
        self._apply_filter()
        ds_khop = [ma for ma, d in self.HocSinh.items() if self._thoa_filter(ma, d)]

        if not ds_khop:
            self.thong_bao("⚠ Không tìm thấy HS nào khớp", self.VANG)
            try: self.bang.selection_remove(self.bang.selection())
            except Exception: pass
            try: self.bang_dd.selection_remove(self.bang_dd.selection())
            except Exception: pass
            self.cap_nhat_diem_danh()
            return

        iids = [str(ma) for ma in ds_khop]
        try: self.bang.selection_set(iids)
        except Exception: pass
        first = ds_khop[0]
        try:
            self.bang.see(str(first)); self.bang.focus(str(first))
        except Exception: pass

        self.cap_nhat_diem_danh()

        try: self.bang_dd.selection_set(iids)
        except Exception: pass
        try:
            self.bang_dd.see(str(first)); self.bang_dd.focus(str(first))
        except Exception: pass

        if len(ds_khop) == 1:
            d = self.HocSinh[first]
            self.tieu_de_ct.config(
                text=f"👁 Đã chọn: {d['name']} ({d['class']}) — Mã {first}",
                fg=self.XANH_DUONG, font=("Segoe UI", 10, "bold"))
        else:
            self.tieu_de_ct.config(
                text=f"👁 Tìm thấy {len(ds_khop)} HS. Đã chọn tất cả.",
                fg=self.XANH_DUONG, font=("Segoe UI", 10, "bold"))

        if len(ds_khop) == 1:
            self.thong_bao(f"✓ Đã chọn: {self.HocSinh[first]['name']}", self.XANH_LA)
        else:
            self.thong_bao(f"✓ Đã chọn {len(ds_khop)} HS ở cả 2 bảng", self.XANH_LA)

    def xoa_loc(self):
        self.bien_tim_kiem.set("")
        if self.bien_tim_ma:  self.bien_tim_ma.set("")
