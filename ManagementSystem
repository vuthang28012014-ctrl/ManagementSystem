            min_col=1, max_col=1,
            min_row=2, max_row=1 + TONG_TUAN)

        s_line = Series(line_data, title_from_data=True)

        # ── Style đường ──
        try:
            s_line.graphicalProperties = GraphicalProperties()
            s_line.graphicalProperties.line = LineProperties(
                solidFill="1E66F5",       # xanh dương đậm
                w=28000)                  # độ dày ~2.8pt
            s_line.smooth = True          # đường cong mượt
            s_line.marker = Marker(symbol="none")  # TẮT marker
        except Exception as e:
            log_warn(f"Line style fail: {e}")

        line.series.append(s_line)
        line.set_categories(line_cats)

        # ── Đường mốc 90% (reference line) ──
        # Thêm 1 series phụ, tất cả điểm = 90%
        try:
            ref_data_rows = []
            for i in range(1, TONG_TUAN + 1):
                ws_data.cell(row=1 + i, column=10, value=90)   # cột J
            ref_data = Reference(
                ws_data,
                min_col=10, max_col=10,
                min_row=1, max_row=1 + TONG_TUAN)
