def diem_danh_moi(): return {d: False for d in THU}
def ly_do_moi():     return {d: "" for d in THU}
def loi_moi():       return {d: "" for d in THU}

def tuan_moi():
    return {"attendance": diem_danh_moi(),
            "reasons":    ly_do_moi(),
            "errors":     loi_moi()}

def tao_du_lieu_tat_ca_tuan():
    return {t: tuan_moi() for t in range(1, TONG_TUAN + 1)}

def ten_hoc_ky(tuan):
    return "Học kỳ 1" if tuan <= TUAN_HK1 else "Học kỳ 2"

def _chuan_hoa_tuan(w):
    if not isinstance(w, dict):
        w = {}
    att = w.get("attendance")
    rea = w.get("reasons")
    err = w.get("errors")
    if not isinstance(att, dict): att = {}
    if not isinstance(rea, dict): rea = {}
    if not isinstance(err, dict): err = {}
    for d in THU:
        att.setdefault(d, False)
        rea.setdefault(d, "")
        err.setdefault(d, "")
    w["attendance"] = att
    w["reasons"]    = rea
    w["errors"]     = err
    return w


def validate_hs_info(info):
    """Trả True nếu info đúng schema. Không sửa info."""
    if not isinstance(info, dict):
        return False
    if not isinstance(info.get("name"),  str): return False
    if not isinstance(info.get("class"), str): return False
    if not isinstance(info.get("weeks"), dict): return False
    return True


