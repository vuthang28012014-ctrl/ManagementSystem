        self.o_ten.delete(0, "end"); self.o_ten.insert(0, vals[1])
        self.o_lop.delete(0, "end"); self.o_lop.insert(0, vals[2])
        self.thong_bao(f"Đã tải mã {vals[0]} vào form.", self.CHU_MO)

    # ═══════════════════════════════════════════════════════════
    # TÌM KIẾM
    # ═══════════════════════════════════════════════════════════
    def _thoa_filter(self, ma, d):
        q = self.bien_tim_kiem.get().strip().lower()
        if q:
            if not (q in str(ma).lower()
                    or q in d["name"].lower()
                    or q in d["class"].lower()):
                return False
        if self.bien_tim_ma is not None:
            m = self.bien_tim_ma.get().strip()
            if m and m not in str(ma):
                return False
        if self.bien_tim_ten is not None:
            t = self.bien_tim_ten.get().strip().lower()
            if t and t not in d["name"].lower():
                return False
        return True

    def _co_filter(self):
        if self.bien_tim_kiem.get().strip(): return True
        if self.bien_tim_ma is not None and self.bien_tim_ma.get().strip(): return True
        if self.bien_tim_ten is not None and self.bien_tim_ten.get().strip(): return True
        return False

    def tim_kiem(self):
        self.cap_nhat_bang()

        ds_khop = []
        for ma, d in HocSinh.items():
            if self._thoa_filter(ma, d):
                ds_khop.append(ma)

        if not ds_khop:
            self.thong_bao("⚠ Không tìm thấy học sinh nào khớp", self.VANG)
            try:
                self.bang.selection_remove(self.bang.selection())
            except Exception:
                pass
            try:
                self.bang_dd.selection_remove(self.bang_dd.selection())
            except Exception:
                pass
            self.cap_nhat_diem_danh()
            return

        ds_iid = [str(ma) for ma in ds_khop]

        # Select bảng danh sách
        try:
            self.bang.selection_set(ds_iid)
        except Exception:
            pass

        first_ma = ds_khop[0]
        try:
            self.bang.see(str(first_ma))
            self.bang.focus(str(first_ma))
        except Exception:
            pass

        # Refresh bảng điểm danh
        self.cap_nhat_diem_danh()

        # Select bảng điểm danh (SAU khi refresh)
        try:
            self.bang_dd.selection_set(ds_iid)
        except Exception:
            pass

        try:
            self.bang_dd.see(str(first_ma))
            self.bang_dd.focus(str(first_ma))
        except Exception:
            pass

        # Panel chi tiết
        if len(ds_khop) == 1:
            d = HocSinh[first_ma]
            self.tieu_de_ct.config(
                text=f"👁 Đã chọn: {d['name']} ({d['class']}) — Mã {first_ma}. Click vào ô để xem chi tiết.",
                fg=self.XANH_DUONG, font=("Segoe UI", 10, "bold"))
        else:
            self.tieu_de_ct.config(
                text=f"👁 Tìm thấy {len(ds_khop)} học sinh. Đã chọn tất cả.",
                fg=self.XANH_DUONG, font=("Segoe UI", 10, "bold"))

        if len(ds_khop) == 1:
            self.thong_bao(f"✓ Đã chọn: {HocSinh[first_ma]['name']}", self.XANH_LA)
        else:
            self.thong_bao(f"✓ Đã chọn {len(ds_khop)} học sinh ở cả 2 bảng", self.XANH_LA)

    def xoa_loc(self):
        self.bien_tim_kiem.set("")
        if self.bien_tim_ma is not None:
            self.bien_tim_ma.set("")
        if self.bien_tim_ten is not None:
            self.bien_tim_ten.set("")
        self.cap_nhat_bang()
        self.thong_bao("Đã xóa filter", self.CHU_MO)

    # ═══════════════════════════════════════════════════════════
    # BẢNG HỌC SINH
    # ═══════════════════════════════════════════════════════════
    def cap_nhat_bang(self):
        for item in self.bang.get_children(): self.bang.delete(item)

        rows = []
        for ma, d in HocSinh.items():
            if not self._thoa_filter(ma, d):
                continue
            rows.append((ma, d["name"], d["class"]))

        key = self.khoa_sap_xep
        if key == "ma": rows.sort(key=lambda r: r[0], reverse=self.dao_sap_xep)
        elif key == "ten": rows.sort(key=lambda r: r[1].lower(), reverse=self.dao_sap_xep)
        else: rows.sort(key=lambda r: r[2].lower(), reverse=self.dao_sap_xep)

        for i, (ma, ten, lop) in enumerate(rows):
            tag = "le" if i % 2 else "chan"
            self.bang.insert("", "end", iid=str(ma), values=(ma, ten, lop), tags=(tag,))

        self.nhan_tong.config(text=f"Tổng: {len(HocSinh)}")

        if self.nhan_ket_qua is not None:
            if self._co_filter():
                self.nhan_ket_qua.config(
                    text=f"Tìm thấy: {len(rows)}/{len(HocSinh)} học sinh",
                    fg=self.XANH_LA)
            else:
                self.nhan_ket_qua.config(text="")

    def sap_xep(self, key):
        if self.khoa_sap_xep == key:
            self.dao_sap_xep = not self.dao_sap_xep
        else:
            self.khoa_sap_xep = key; self.dao_sap_xep = False
        self.cap_nhat_bang()

    # ────── Ký hiệu ô ──────
    def _ky_hieu_o(self, ma, day):
        w = self._du_lieu_tuan(ma)
        if not w: return ""
        if w["attendance"].get(day, False):
            base = "✓"
        else:
            reason = w["reasons"].get(day, "").strip()
            base = "✗" if (reason and reason != LY_DO_MAC_DINH) else "⊘"
        err = w["errors"].get(day, "").strip()
        return f"{base}!" if err else base

    def cap_nhat_diem_danh(self):
        for item in self.bang_dd.get_children(): self.bang_dd.delete(item)
        ds_ma = sorted(HocSinh.keys(), key=lambda s: HocSinh[s]["name"].lower())
        sel = self.bang.selection()
        ma_da_chon = [int(self.bang.item(i, "values")[0]) for i in sel] if sel else None
        for ma in ds_ma:
            d = HocSinh[ma]
            ten_hien = d["name"]
            if ma_da_chon and ma not in ma_da_chon:
                ten_hien = f"· {d['name']}"
            vals = [f"{ten_hien} ({d['class']})"] + [self._ky_hieu_o(ma, day) for day in THU]
            self.bang_dd.insert("", "end", iid=str(ma), values=vals)
        tong = len(ds_ma)
        if ma_da_chon:
            self.nhan_tom_tat.config(text=f"Đang xem {len(ma_da_chon)}/{tong} · Tuần {self.tuan_hien_tai}")
        else:
            self.nhan_tom_tat.config(text=f"{tong} học sinh · Tuần {self.tuan_hien_tai}")

    def _cap_nhat_hang_dd(self, ma):
        d = HocSinh.get(ma)
        if not d: return
        vals = [f"{d['name']} ({d['class']})"] + [self._ky_hieu_o(ma, day) for day in THU]
        try:
            self.bang_dd.item(str(ma), values=vals)
        except Exception:
            pass

    # ═══════════════════════════════════════════════════════════
    # CLICK HANDLERS
    # ═══════════════════════════════════════════════════════════
    def _xac_dinh_o(self, x, y):
        region = self.bang_dd.identify("region", x, y)
        if region != "cell": return None
        row_id = self.bang_dd.identify_row(y)
        if not row_id: return None
        col_id = self.bang_dd.identify_column(x)
        col_idx = int(col_id[1:]) - 1
        col_name = COT_DIEMDANH[col_idx]
        if col_name == "ten": return None
        return (int(row_id), col_name)

    def click_diem_danh(self, event):
        x, y = event.x, event.y
        if self.hen_gio_click:
            self.root.after_cancel(self.hen_gio_click)
            self.hen_gio_click = None
        self.hen_gio_click = self.root.after(
            DO_TRE_CLICK_DUP,
            lambda: self._xu_ly_click_don(x, y)
        )

    def _xu_ly_click_don(self, x, y):
        self.hen_gio_click = None
        cell = self._xac_dinh_o(x, y)
        if cell is None: return
        ma, day = cell
        self._hien_thi_panel_ct(ma, day)

    def double_click_diem_danh(self, event):
        if self.hen_gio_click:
            self.root.after_cancel(self.hen_gio_click)
            self.hen_gio_click = None
        cell = self._xac_dinh_o(event.x, event.y)
        if cell is None: return
        ma, day = cell
        self._doi_trang_thai(ma, day)

    def _doi_trang_thai(self, ma, day):
        w = self._du_lieu_tuan(ma)
        if not w: return
        d = HocSinh[ma]
        gia_tri_moi = not w["attendance"].get(day, False)
        w["attendance"][day] = gia_tri_moi
        if gia_tri_moi:
            w["reasons"][day] = ""
            self.thong_bao(f"✓ {d['name']} — T{self.tuan_hien_tai} {day}: Có mặt", self.XANH_LA)
        else:
            w["reasons"][day] = LY_DO_MAC_DINH
            self.thong_bao(f"⊘ {d['name']} — T{self.tuan_hien_tai} {day}: {LY_DO_MAC_DINH}", self.DO)
        self._cap_nhat_hang_dd(ma)
        self._hien_thi_panel_ct(ma, day)

    def _hien_thi_panel_ct(self, ma, day):
        w = self._du_lieu_tuan(ma)
        if not w: return
        d = HocSinh[ma]
        self.o_hien_tai = (ma, day)
        att = w["attendance"].get(day, False)
        reason = w["reasons"].get(day, "")
        err = w["errors"].get(day, "")

        tuan_str = f"Tuần {self.tuan_hien_tai} · {day}"
        if att:
            self.tieu_de_ct.config(
                text=f"👁 {d['name']} — {tuan_str}: CÓ MẶT",
                fg=self.XANH_LA, font=("Segoe UI", 10, "bold"))
            self.bien_ly_do.set("")
            self.o_ly_do.config(state="disabled")
        else:
            if not reason.strip():
                reason = LY_DO_MAC_DINH
                w["reasons"][day] = reason
            self.tieu_de_ct.config(
                text=f"👁 {d['name']} ({d['class']}) — {tuan_str}",
                fg=self.XANH_DUONG, font=("Segoe UI", 10, "bold"))
            self.o_ly_do.config(state="normal")
            self.bien_ly_do.set(reason)
            self.o_ly_do.focus_set()
            self.o_ly_do.selection_range(0, "end")

        self.o_loi.delete("1.0", "end")
        if err:
            self.o_loi.insert("1.0", err)

    def di_chuot_diem_danh(self, event):
        region = self.bang_dd.identify("region", event.x, event.y)
        if region != "cell":
            self.bang_dd.config(cursor=""); return
        col_id = self.bang_dd.identify_column(event.x)
        col_idx = int(col_id[1:]) - 1
        self.bang_dd.config(cursor="" if col_idx == 0 else "hand2")

    # ────── Panel chi tiết ──────
    def _xoa_panel_ct(self):
        self.o_hien_tai = None
        self.tieu_de_ct.config(
            text="1 click vào ô để xem chi tiết...",
            fg=self.CHU_MO, font=("Segoe UI", 9, "italic"))
        self.bien_ly_do.set("")
        self.o_ly_do.config(state="normal")
        self.o_loi.delete("1.0", "end")

    def luu_ly_do(self):
        if not self.o_hien_tai:
            self.thong_bao("⚠ Chưa chọn ô nào để ghi lý do", self.VANG); return
        ma, day = self.o_hien_tai
        w = self._du_lieu_tuan(ma)
        if not w: return
        d = HocSinh[ma]
        if w["attendance"].get(day, False):
            self.thong_bao("⚠ Ô này là CÓ MẶT, không cần lý do", self.VANG); return
        text = self.bien_ly_do.get().strip()
        if not text: text = LY_DO_MAC_DINH
        w["reasons"][day] = text
        self._cap_nhat_hang_dd(ma)
        mau = self.DO if text == LY_DO_MAC_DINH else self.VANG
        self.thong_bao(f"✓ Đã lưu {d['name']} — T{self.tuan_hien_tai} {day}: {text}", mau)

    def danh_dau_khong_phep(self):
        if not self.o_hien_tai:
            self.thong_bao("⚠ Chưa chọn ô nào", self.VANG); return
        ma, day = self.o_hien_tai
        w = self._du_lieu_tuan(ma)
        if not w: return
        d = HocSinh[ma]
        if w["attendance"].get(day, False):
            self.thong_bao("⚠ Ô này là CÓ MẶT", self.VANG); return
        w["reasons"][day] = LY_DO_MAC_DINH
        self.bien_ly_do.set(LY_DO_MAC_DINH)
        self._cap_nhat_hang_dd(ma)
        self.thong_bao(f"⊘ {d['name']} — T{self.tuan_hien_tai} {day}: {LY_DO_MAC_DINH}", self.DO)

    def luu_loi(self):
        if not self.o_hien_tai:
            self.thong_bao("⚠ Chưa chọn ô nào để ghi lỗi", self.VANG); return
        ma, day = self.o_hien_tai
        w = self._du_lieu_tuan(ma)
        if not w: return
        d = HocSinh[ma]
        text = self.o_loi.get("1.0", "end-1c").strip()
        w["errors"][day] = text
        self._cap_nhat_hang_dd(ma)
        if text:
            hien = text if len(text) <= 60 else text[:57] + "..."
            self.thong_bao(f"⚠ Đã lưu lỗi {d['name']} — T{self.tuan_hien_tai} {day}: {hien}", self.CAM)
        else:
            self.thong_bao(f"✓ Đã xóa lỗi {d['name']} — T{self.tuan_hien_tai} {day}", self.XANH_LA)

    def xoa_loi(self):
        if not self.o_hien_tai:
            self.thong_bao("⚠ Chưa chọn ô nào", self.VANG); return
        ma, day = self.o_hien_tai
        w = self._du_lieu_tuan(ma)
        if not w: return
        d = HocSinh[ma]
        w["errors"][day] = ""
        self.o_loi.delete("1.0", "end")
        self._cap_nhat_hang_dd(ma)
        self.thong_bao(f"✓ Đã xóa lỗi {d['name']} — T{self.tuan_hien_tai} {day}", self.XANH_LA)

    # ────── Hàng loạt ──────
    def danh_dau_tat_ca(self):
        sel = self.bang.selection()
        ds_ma = [int(self.bang.item(i, "values")[0]) for i in sel] if sel else list(HocSinh.keys())
        for ma in ds_ma:
            w = self._du_lieu_tuan(ma)
            if w:
                for day in THU:
                    w["attendance"][day] = True
                    w["reasons"][day] = ""
        self.cap_nhat_diem_danh(); self._xoa_panel_ct()
        self.thong_bao(f"✓ Đã đánh dấu có mặt tuần {self.tuan_hien_tai} cho {len(ds_ma)} học sinh", self.XANH_LA)

    def bo_danh_dau_tat_ca(self):
        sel = self.bang.selection()
        ds_ma = [int(self.bang.item(i, "values")[0]) for i in sel] if sel else list(HocSinh.keys())
        for ma in ds_ma:
            w = self._du_lieu_tuan(ma)
            if w:
                for day in THU:
                    w["attendance"][day] = False
                    w["reasons"][day] = LY_DO_MAC_DINH
        self.cap_nhat_diem_danh(); self._xoa_panel_ct()
        self.thong_bao(f"⊘ Đã đánh dấu vắng tuần {self.tuan_hien_tai} cho {len(ds_ma)} học sinh", self.DO)

    def thong_bao(self, msg, mau=None):
        self.thanh_trang_thai.config(text=msg, fg=mau or self.CHU_MO)

    def khi_dong(self):
        if self.hen_gio_click:
            self.root.after_cancel(self.hen_gio_click)
        try:
            if GH_CONFIG:
                print("\n[Close] Đang lưu + push GitHub...")
            ghi_file()
        except Exception:
            pass
        self.root.destroy()


