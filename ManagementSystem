def _load_gh_config():
    """Ưu tiên ENV GITHUB_TOKEN, fallback file config."""
    cfg = None
    if os.path.exists(GH_CONFIG_FILE):
        try:
            with open(GH_CONFIG_FILE, "r", encoding="utf-8") as f:
                cfg = json.load(f)
        except Exception as e:
            log_error(f"Config GitHub hỏng: {e}")
            return None

    if not cfg:
        # Thử build config từ ENV
        env_token = os.environ.get("GITHUB_TOKEN", "").strip()
        env_owner = os.environ.get("GITHUB_OWNER", "").strip()
        env_repo  = os.environ.get("GITHUB_REPO",  "").strip()
        if env_token and env_owner and env_repo:
            cfg = {
                "owner": env_owner,
                "repo":  env_repo,
                "token": env_token,
                "branch": os.environ.get("GITHUB_BRANCH", "main"),
                "path":   os.environ.get("GITHUB_PATH",   "output.txt"),
            }
        else:
            return None

    # Override bằng ENV nếu có
    for k, env_k in (("token","GITHUB_TOKEN"), ("owner","GITHUB_OWNER"),
                     ("repo","GITHUB_REPO"), ("branch","GITHUB_BRANCH"),
                     ("path","GITHUB_PATH")):
        v = os.environ.get(env_k, "").strip()
        if v:
            cfg[k] = v

    for k in ("owner", "repo", "token"):
        if not cfg.get(k):
            log_warn(f"GitHub config thiếu key: {k}")
            return None
    cfg.setdefault("branch", "main")
    cfg.setdefault("path",   "output.txt")
    return cfg


def github_fetch_ex(config, timeout=15):
    """
    Tải file bằng Contents API (có token nên đọc được repo private).
    Trả (status, content, sha):
      "ok"      -> content là chuỗi, sha là SHA của file
      "missing" -> file chưa tồn tại
      "error"   -> lỗi mạng / quyền / rate limit (content = None)
    """
    if not URLLIB_OK or not config:
        return "error", None, None
    api_url = (f"https://api.github.com/repos/{config['owner']}/"
               f"{config['repo']}/contents/{config['path']}"
               f"?ref={config['branch']}")
    headers = {
        "Accept":        "application/vnd.github.v3+json",
        "User-Agent":    "ManagementSystem/2.5",
        "Cache-Control": "no-cache",
    }
    if config.get("token"):
        headers["Authorization"] = f"token {config['token']}"
    try:
        req = urllib.request.Request(api_url, headers=headers)
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            meta = json.loads(resp.read().decode("utf-8"))
        sha = meta.get("sha")
        if meta.get("encoding") == "base64" and meta.get("content"):
            return "ok", base64.b64decode(meta["content"]).decode("utf-8"), sha
        # File lớn hơn 1MB: Contents API không trả content -> tải bản raw
        raw_headers = dict(headers)
        raw_headers["Accept"] = "application/vnd.github.v3.raw"
        req2 = urllib.request.Request(api_url, headers=raw_headers)
        with urllib.request.urlopen(req2, timeout=timeout) as resp2:
            return "ok", resp2.read().decode("utf-8"), sha
    except urllib.error.HTTPError as e:
        if e.code == 404:
            try:
                msg = json.loads(e.read().decode("utf-8")).get("message", "")
            except Exception:
                msg = ""
            if "No commit found" in msg:
                log_error("GitHub: sai tên branch")
                return "error", None, None
            log_info("GitHub: file chưa tồn tại")
            return "missing", None, None
        if e.code in (401, 403):
            log_error(f"GitHub: HTTP {e.code} (token sai hoặc rate limit)")
            return "error", None, None
        log_error(f"GitHub fetch HTTP {e.code}")
        return "error", None, None
    except Exception as e:
        log_error(f"GitHub fetch: {e}")
        return "error", None, None


def github_fetch(config, timeout=15):
    """Tải file từ GitHub. Trả string, hoặc None nếu không có file / lỗi."""
    status, content, _sha = github_fetch_ex(config, timeout)
    if status == "ok":
        return content
    return None


def github_push(config, content, commit_msg=None):
    """Push file. Retry 3 lần khi conflict. Trả (ok, err_msg)."""
    if not URLLIB_OK or not config:
        return False, "Không có config GitHub"

    if not commit_msg:
        commit_msg = f"Cập nhật lúc {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}"

    api_url = (f"https://api.github.com/repos/{config['owner']}/"
               f"{config['repo']}/contents/{config['path']}")
    headers = {
        "Authorization": f"token {config['token']}",
        "Accept":        "application/vnd.github.v3+json",
        "User-Agent":    "ManagementSystem/2.0",
    }

    def get_sha():
        try:
            req = urllib.request.Request(api_url + f"?ref={config['branch']}",
                                          headers=headers)
            with urllib.request.urlopen(req, timeout=10) as resp:
                return json.loads(resp.read().decode("utf-8")).get("sha")
        except urllib.error.HTTPError as e:
            if e.code == 404:
                return None
            log_error(f"GitHub lấy SHA HTTP {e.code}")
            return None
        except Exception as e:
            log_error(f"GitHub lấy SHA: {e}")
            return None

    sha = get_sha()

    for attempt in range(3):
        body = {
            "message": commit_msg,
            "content": base64.b64encode(content.encode("utf-8")).decode("ascii"),
            "branch":  config["branch"],
        }
        if sha:
            body["sha"] = sha

        try:
            req = urllib.request.Request(
                api_url,
                data=json.dumps(body).encode("utf-8"),
                headers={**headers, "Content-Type": "application/json"},
                method="PUT",
            )
            with urllib.request.urlopen(req, timeout=20) as resp:
                if resp.status in (200, 201):
                    return True, None
        except urllib.error.HTTPError as e:
            if e.code in (409, 422):
                log_warn(f"GitHub conflict — thử lại {attempt+1}/3")
                _time.sleep(1)
                sha = get_sha()
                continue
            if e.code == 403:
                return False, "403 – token hết hạn hoặc rate limit"
            return False, f"HTTP {e.code}"
        except Exception as e:
            return False, str(e)

    return False, "Conflict sau 3 lần thử"

_SHA_AUTO = object()


def github_push_ex(config, content, commit_msg=None, sha=_SHA_AUTO):
    """
    Giống github_push nhưng trả (ok, err, conflict).
    conflict=True → caller nên pull lại và merge rồi thử lại.
    """
    if not URLLIB_OK or not config:
        return False, "Không có config GitHub", False

    if not commit_msg:
        commit_msg = f"Cập nhật lúc {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}"

    api_url = (f"https://api.github.com/repos/{config['owner']}/"
               f"{config['repo']}/contents/{config['path']}")
    headers = {
        "Authorization": f"token {config['token']}",
        "Accept":        "application/vnd.github.v3+json",
        "User-Agent":    "ManagementSystem/2.0",
    }

    def get_sha():
        try:
            req = urllib.request.Request(
                api_url + f"?ref={config['branch']}", headers=headers)
            with urllib.request.urlopen(req, timeout=10) as resp:
                return json.loads(resp.read().decode("utf-8")).get("sha")
        except urllib.error.HTTPError as e:
            if e.code == 404:
                return None
            log_error(f"GitHub lấy SHA HTTP {e.code}")
            return None
        except Exception as e:
            log_error(f"GitHub lấy SHA: {e}")
            return None

    if sha is _SHA_AUTO:
        sha = get_sha()
    body = {
        "message": commit_msg,
        "content": base64.b64encode(content.encode("utf-8")).decode("ascii"),
        "branch":  config["branch"],
    }
    if sha:
        body["sha"] = sha

    try:
        req = urllib.request.Request(
            api_url,
            data=json.dumps(body).encode("utf-8"),
            headers={**headers, "Content-Type": "application/json"},
            method="PUT",
        )
        with urllib.request.urlopen(req, timeout=20) as resp:
            if resp.status in (200, 201):
                return True, None, False
    except urllib.error.HTTPError as e:
        if e.code in (409, 422):
            return False, f"Conflict HTTP {e.code}", True
        if e.code == 403:
            return False, "403 – token hết hạn hoặc rate limit", False
        return False, f"HTTP {e.code}", False
    except Exception as e:
        return False, str(e), False

    return False, "unknown", False

