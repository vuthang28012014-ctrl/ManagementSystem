            parts.append(f'<td class="name">{esc(r["name"])}</td>')
            parts.append(f'<td>{esc(r["class"])}</td>')
            parts.append(f'<td>{esc(r["to"])}</td>')
            parts.append(f'<td>{r["cm"]}</td>')
            parts.append(f'<td>{r["vp"]}</td>')
            parts.append(f'<td>{r["vkp"]}</td>')
            parts.append(f'<td>{r["loi"]}</td>')
            parts.append(f'<td class="{cls_rate}">{_fmt_rate(r["rate"])}</td>')
            parts.append('</tr>')
        parts.append('</table>')

        parts.append('<div class="footer">'
                     f'Hệ Thống Quản Lý Học Sinh v{APP_VERSION} — '
                     'in bằng Ctrl+P hoặc nút phía trên</div>')
        parts.append('</div></body></html>')

        with open(path, "w", encoding="utf-8") as f:
            f.write("".join(parts))
        log_info(f"✓ Xuất HTML: {path}")
        return True
    except Exception as e:
        log_error(f"Xuất HTML fail: {e}\n{traceback.format_exc()}")
        return False

def _build_word_report(hoc_sinh, path, ly_do_md, period="year"):
    """
    Xuất báo cáo Word (.doc) — dùng HTML tables thay vì SVG.
    Word KHÔNG render inline SVG đúng (text dồn về góc), nên biểu đồ
    được vẽ bằng table với ô bgcolor.
    """
    try:
        WEEKS = _get_weeks_for_period(period)
        P_LABEL = _period_label(period)

        def esc(s):
            return (str(s).replace("&", "&amp;")
                           .replace("<", "&lt;")
                           .replace(">", "&gt;"))

        def color_of(rate):
            if rate is None: return "#EEEEEE", "#666666"
            if rate >= 90:   return "#C6EFCE", "#1a5c1a"
            elif rate >= 75: return "#FFEB9C", "#7a5a00"
            else:            return "#FFC7CE", "#8b1a2a"

        # ── Dùng compute_stats ──
        if not WEEKS:
            WEEKS = list(range(1, TONG_TUAN + 1))
        stats = compute_stats(hoc_sinh, WEEKS, ly_do_md)
        rows       = stats["hs_rows"]
        all_cm     = stats["totals"]["cm"]
        all_vp     = stats["totals"]["vp"]
        all_vkp    = stats["totals"]["vkp"]
        all_loi    = stats["totals"]["loi"]
        total_all  = stats["totals"]["total"]
        rate_all   = stats["totals"]["rate"]
        week_data  = [(t, r) for t, r in stats["week_data"] if r is not None]
        class_data = [c for c in stats["class_data"] if c[1] is not None]
        err_data   = stats["err_week_data"]

        # ── Build HTML ──
        parts = []
        parts.append(
            '<html xmlns:o="urn:schemas-microsoft-com:office:office" '
            'xmlns:w="urn:schemas-microsoft-com:office:word" '
            'xmlns="http://www.w3.org/TR/REC-html40">')
        parts.append('<head><meta charset="UTF-8">')
        parts.append(f'<title>BÁO CÁO CHUYÊN CẦN — {P_LABEL}</title>')
        parts.append('<!--[if gte mso 9]><xml><w:WordDocument>'
                     '<w:View>Print</w:View><w:Zoom>100</w:Zoom>'
                     '</w:WordDocument></xml><![endif]-->')
        parts.append('<style>')
        parts.append('''
            @page { size: A4 portrait; margin: 1.5cm 1.2cm; }
            body { font-family: 'Times New Roman', Calibri, serif;
                   font-size: 11pt; color: #1a1a1a; }
            h1 { color: #1F3864; font-size: 18pt; text-align: center;
                 margin: 0 0 6pt 0; }
            h2 { color: #1F3864; font-size: 14pt; margin: 14pt 0 6pt 0;
                 border-bottom: 1pt solid #4472C4; padding-bottom: 3pt; }
            .meta { color: #666; font-style: italic; font-size: 10pt;
                    text-align: center; margin-bottom: 12pt; }
            table { border-collapse: collapse; width: 100%; }
            th { background: #4472C4; color: white; padding: 4pt 6pt;
                 border: 1pt solid #345a9e; text-align: center;
                 font-size: 10pt; font-weight: bold; }
            td { padding: 3pt 5pt; border: 1pt solid #999;
                 font-size: 10pt; text-align: center; }
            td.name { text-align: left; }
            .summary-table td { border: 1pt solid #ccc; padding: 8pt;
                                text-align: center; }
            .summary-label { color: #666; font-size: 9pt;
                             text-transform: uppercase; }
            .summary-value { color: #1F3864; font-size: 16pt;
                             font-weight: bold; }
        ''')
        parts.append('</style></head><body>')

        # Header
        parts.append(f'<h1>BÁO CÁO CHUYÊN CẦN — {P_LABEL}</h1>')
        parts.append(f'<div class="meta">Ngày xuất: '
                     f'{datetime.now().strftime("%d/%m/%Y %H:%M")} '
                     f'&middot; {len(hoc_sinh)} học sinh '
                     f'&middot; {len(WEEKS)} tuần</div>')

        # Summary
        parts.append('<table class="summary-table" cellpadding="6" '
                     'cellspacing="0"><tr>')
        for label, value in [
            ("Tổng buổi",   f"{total_all:,}".replace(",", ".")),
            ("Có mặt",      f"{all_cm:,}".replace(",", ".")),
            ("Vắng phép",   f"{all_vp:,}".replace(",", ".")),
            ("Vắng KP",     f"{all_vkp:,}".replace(",", ".")),
            ("Tỉ lệ chung", f"{rate_all:.1f}%"),
        ]:
            parts.append(
                f'<td><div class="summary-label">{esc(label)}</div>'
                f'<div class="summary-value">{esc(value)}</div></td>')
        parts.append('</tr></table>')

        # ── Chuyên cần theo lớp ──
        parts.append('<h2>📊 Chuyên cần theo lớp</h2>')
        parts.append('<table cellpadding="4" cellspacing="0" '
                     'style="width:100%">')
        parts.append('<tr><th style="width:22%">Lớp</th>'
                     '<th style="width:63%">Mức chuyên cần</th>'
                     '<th style="width:15%">Tỉ lệ</th></tr>')
        for cls, rate, p, tt in class_data:
            bg, fg = color_of(rate)
            bar_w = max(1, min(100, rate))
            rest_w = 100 - bar_w
            parts.append(
                f'<tr>'
                f'<td class="name" style="width:22%">'
                f'{esc(cls)} <span style="color:#666;font-size:9pt">'
                f'({p}/{tt})</span></td>'
                f'<td style="width:63%;padding:2pt 6pt">'
                f'<table cellpadding="0" cellspacing="0" '
                f'style="border:none;width:100%"><tr>'
                f'<td width="{bar_w}%" bgcolor="{bg}" '
                f'style="background:{bg};height:12pt;border:none">'
                f'&nbsp;</td>'
                f'<td width="{rest_w}%" style="border:none">&nbsp;</td>'
                f'</tr></table></td>'
                f'<td style="width:15%;font-weight:bold;color:{fg}">'
                f'{rate:.1f}%</td></tr>')
        parts.append('</table>')

        # ── Chuyên cần theo tuần ──
        parts.append('<h2>📈 Tỉ lệ có mặt theo tuần</h2>')
        for chunk_start in range(0, len(week_data), 10):
            chunk = week_data[chunk_start:chunk_start + 10]
            parts.append('<table cellpadding="3" cellspacing="0" '
                         'style="width:100%;margin:4pt 0">')
            parts.append('<tr><th style="width:15%">Tuần</th>'
                         '<th style="width:70%">Tỉ lệ</th>'
                         '<th style="width:15%">%</th></tr>')
            for t, rate in chunk:
                bg, fg = color_of(rate)
                bar_w = max(1, min(100, rate))
                rest_w = 100 - bar_w
                parts.append(
                    f'<tr><td style="width:15%;font-weight:bold">'
                    f'T{t}</td>'
                    f'<td style="width:70%;padding:2pt 6pt">'
                    f'<table cellpadding="0" cellspacing="0" '
                    f'style="border:none;width:100%"><tr>'
                    f'<td width="{bar_w}%" bgcolor="{bg}" '
                    f'style="background:{bg};height:10pt;border:none">'
                    f'&nbsp;</td>'
                    f'<td width="{rest_w}%" style="border:none">'
                    f'&nbsp;</td></tr></table></td>'
                    f'<td style="width:15%;font-weight:bold;color:{fg}">'
                    f'{rate:.1f}%</td></tr>')
            parts.append('</table>')

        # ── Tỉ lệ HS có lỗi theo tuần ──
        parts.append('<h2>⚠ Tỉ lệ HS có lỗi theo tuần</h2>')
        for chunk_start in range(0, len(WEEKS), 10):
            chunk = err_data[chunk_start:chunk_start + 10]
            parts.append('<table cellpadding="3" cellspacing="0" '
                         'style="width:100%;margin:4pt 0">')
            parts.append('<tr><th style="width:15%">Tuần</th>'
                         '<th style="width:70%">Tỉ lệ</th>'
                         '<th style="width:15%">%</th></tr>')
            for t, rate in chunk:
                bar_w = max(0, min(100, rate))
                rest_w = 100 - bar_w
                parts.append(
                    f'<tr><td style="width:15%;font-weight:bold">'
                    f'T{t}</td>'
                    f'<td style="width:70%;padding:2pt 6pt">'
                    f'<table cellpadding="0" cellspacing="0" '
                    f'style="border:none;width:100%"><tr>'
                    f'<td width="{bar_w}%" bgcolor="#F97316" '
                    f'style="background:#F97316;height:10pt;'
                    f'border:none">&nbsp;</td>'
                    f'<td width="{rest_w}%" style="border:none">'
                    f'&nbsp;</td></tr></table></td>'
                    f'<td style="width:15%;font-weight:bold;'
                    f'color:#C2410C">{rate:.1f}%</td></tr>')
            parts.append('</table>')

        # ── Bảng chi tiết ──
        parts.append('<h2>📋 Bảng chi tiết học sinh</h2>')
        rows.sort(key=lambda r: _rate_sort(r["rate"]))
        parts.append('<table cellpadding="3" cellspacing="0" '
                     'style="width:100%">')
        parts.append('<tr>'
                     '<th style="width:5%">STT</th>'
                     '<th style="width:7%">Mã</th>'
                     '<th style="width:26%">Họ tên</th>'
                     '<th style="width:8%">Lớp</th>'
                     '<th style="width:6%">Tổ</th>'
                     '<th style="width:9%">Có mặt</th>'
                     '<th style="width:9%">Vắng phép</th>'
                     '<th style="width:9%">Vắng KP</th>'
                     '<th style="width:7%">Lỗi</th>'
                     '<th style="width:14%">Tỉ lệ</th>'
                     '</tr>')
        for stt, r in enumerate(rows, 1):
            bg, fg = color_of(r["rate"])
            parts.append(
                f'<tr>'
                f'<td>{stt}</td>'
                f'<td>{esc(r["ma"])}</td>'
                f'<td class="name">{esc(r["name"])}</td>'
                f'<td>{esc(r["class"])}</td>'
                f'<td>{esc(r["to"])}</td>'
                f'<td>{r["cm"]}</td>'
                f'<td>{r["vp"]}</td>'
                f'<td>{r["vkp"]}</td>'
                f'<td>{r["loi"]}</td>'
                f'<td style="background:{bg};color:{fg};font-weight:bold">'
                f'{_fmt_rate(r["rate"])}</td>'
                f'</tr>')
        parts.append('</table>')

        # Footer
        parts.append('<p style="text-align:center;color:#888;'
                     'font-size:9pt;margin-top:16pt">'
                     f'Hệ Thống Quản Lý Học Sinh v{APP_VERSION} — xuất Word</p>')
        parts.append('</body></html>')

        with open(path, "w", encoding="utf-8", newline="\n") as f:
            f.write("".join(parts))
        log_info(f"✓ Xuất Word: {path}")
        return True
    except Exception as e:
        log_error(f"Xuất Word fail: {e}\n{traceback.format_exc()}")
        return False

def _build_pdf_report(hoc_sinh, path, ly_do_md, period="year"):
    """
    Xuất báo cáo PDF bằng reportlab. Chạy trong thread — KHÔNG chạm Tk.
    period: "year" | "hk1" | "hk2" | "month_1".."month_12"
    Trả True nếu OK.
    """
    if not REPORTLAB_OK:
        log_error("Chưa cài reportlab — pip install reportlab")
        return False
    try:
        # ── Xác định tập tuần theo period ──
        WEEKS = _get_weeks_for_period(period)
        if not WEEKS:
            log_warn(f"PDF: period '{period}' rỗng — fallback cả năm")
            WEEKS = list(range(1, TONG_TUAN + 1))

        period_label = {
            "year": "CẢ NĂM",
            "hk1":  "HỌC KỲ 1",
            "hk2":  "HỌC KỲ 2",
        }.get(period)
        if period_label is None and period.startswith("month_"):
            period_label = _period_label(period)
        if period_label is None:
            period_label = "CẢ NĂM"

        # ── Styles ──
        styles = getSampleStyleSheet()
        st_title = ParagraphStyle(
            "VNTitle", parent=styles["Title"],
            fontName=_VN_FONT_BOLD, fontSize=18, textColor=rl_colors.HexColor("#1F3864"),
            alignment=TA_CENTER, spaceAfter=6,
        )
        st_meta = ParagraphStyle(
            "VNMeta", parent=styles["Normal"],
            fontName=_VN_FONT_REG, fontSize=10, textColor=rl_colors.HexColor("#666666"),
            alignment=TA_CENTER, spaceAfter=14,
        )
        st_h2 = ParagraphStyle(
            "VNH2", parent=styles["Heading2"],
            fontName=_VN_FONT_BOLD, fontSize=13, textColor=rl_colors.HexColor("#1F3864"),
            spaceBefore=14, spaceAfter=8,
        )
        st_cell = ParagraphStyle(
            "VMCell", parent=styles["Normal"],
            fontName=_VN_FONT_REG, fontSize=9, alignment=TA_LEFT,
        )
        st_cell_c = ParagraphStyle(
            "VMCellC", parent=styles["Normal"],
            fontName=_VN_FONT_REG, fontSize=9, alignment=TA_CENTER,
        )
        st_cell_b = ParagraphStyle(
            "VMCellB", parent=styles["Normal"],
            fontName=_VN_FONT_BOLD, fontSize=9, alignment=TA_LEFT,
        )

        # ── Dùng compute_stats ──
        stats = compute_stats(hoc_sinh, WEEKS, ly_do_md)
        rows = [{
            "ma": h["ma"], "name": h["name"], "class": h["class"],
            "to": h["to"], "cm": h["cm"], "vp": h["vp"],
            "vkp": h["vkp"], "loi": h["loi"],
            "rate": h["rate"], "tt": h["total"],
        } for h in stats["hs_rows"]]

        all_cm  = stats["totals"]["cm"]
        all_vp  = stats["totals"]["vp"]
        all_vkp = stats["totals"]["vkp"]
        all_loi = stats["totals"]["loi"]
        all_tt  = stats["totals"]["total"]
        rate_all = stats["totals"]["rate"]

        # ── Build PDF ──
        doc = SimpleDocTemplate(
            path, pagesize=A4,
            leftMargin=1.2 * cm, rightMargin=1.2 * cm,
            topMargin=1.4 * cm, bottomMargin=1.4 * cm,
            title=f"Báo cáo chuyên cần — {period_label}",
        )
        story = []

        # Title
        story.append(Paragraph(f"BÁO CÁO CHUYÊN CẦN — {period_label}", st_title))
        story.append(Paragraph(
            f"Ngày xuất: {datetime.now().strftime('%d/%m/%Y %H:%M')} · "
            f"{len(hoc_sinh)} học sinh · {len(WEEKS)} tuần",
            st_meta))

        # ── Summary table ──
        summary_data = [[
            Paragraph("Tổng buổi", st_cell_c),
            Paragraph("Có mặt", st_cell_c),
            Paragraph("Vắng phép", st_cell_c),
            Paragraph("Vắng KP", st_cell_c),
            Paragraph("Tỉ lệ chung", st_cell_c),
        ], [
            Paragraph(f"<b>{all_tt}</b>", st_cell_c),
            Paragraph(f"<b>{all_cm}</b>", st_cell_c),
            Paragraph(f"<b>{all_vp}</b>", st_cell_c),
            Paragraph(f"<b>{all_vkp}</b>", st_cell_c),
            Paragraph(f"<b>{rate_all:.1f}%</b>", st_cell_c),
        ]]
        t_sum = Table(summary_data, colWidths=[3.5 * cm] * 5)
        t_sum.setStyle(TableStyle([
            ("BACKGROUND", (0, 0), (-1, 0), rl_colors.HexColor("#4472C4")),
            ("TEXTCOLOR",  (0, 0), (-1, 0), rl_colors.white),
            ("BACKGROUND", (0, 1), (-1, 1), rl_colors.HexColor("#F0F4FA")),
            ("GRID",       (0, 0), (-1, -1), 0.5, rl_colors.HexColor("#999999")),
            ("VALIGN",     (0, 0), (-1, -1), "MIDDLE"),
            ("TOPPADDING", (0, 0), (-1, -1), 8),
            ("BOTTOMPADDING", (0, 0), (-1, -1), 8),
        ]))
        story.append(t_sum)

        # ── Chuyên cần theo lớp ──
        story.append(Paragraph("Chuyên cần theo lớp", st_h2))
        class_items = stats["class_data"]

        cdata = [[
            Paragraph("<b>Lớp</b>", st_cell_c),
            Paragraph("<b>Số buổi</b>", st_cell_c),
            Paragraph("<b>Có mặt</b>", st_cell_c),
            Paragraph("<b>Tỉ lệ</b>", st_cell_c),
        ]]
        for cls, rate, p, tt in class_items:
            cdata.append([
                Paragraph(xml_escape(str(cls)), st_cell_b),
                Paragraph(str(tt), st_cell_c),
                Paragraph(str(p), st_cell_c),
                Paragraph(f"<b>{_fmt_rate(rate)}</b>", st_cell_c),
            ])
        t_cls = Table(cdata, colWidths=[5 * cm, 3 * cm, 3 * cm, 3 * cm])
        cls_styles = [
            ("BACKGROUND", (0, 0), (-1, 0), rl_colors.HexColor("#4472C4")),
            ("TEXTCOLOR",  (0, 0), (-1, 0), rl_colors.white),
            ("GRID",       (0, 0), (-1, -1), 0.4, rl_colors.HexColor("#999999")),
            ("VALIGN",     (0, 0), (-1, -1), "MIDDLE"),
            ("TOPPADDING", (0, 0), (-1, -1), 5),
            ("BOTTOMPADDING", (0, 0), (-1, -1), 5),
        ]
        for i, (_, rate, _, _) in enumerate(class_items, start=1):
            if rate is None:
                continue
            if rate >= 90:
                cls_styles.append(("BACKGROUND", (3, i), (3, i),
                                    rl_colors.HexColor("#C6EFCE")))
            elif rate >= 75:
                cls_styles.append(("BACKGROUND", (3, i), (3, i),
                                    rl_colors.HexColor("#FFEB9C")))
            else:
                cls_styles.append(("BACKGROUND", (3, i), (3, i),
                                    rl_colors.HexColor("#FFC7CE")))
        t_cls.setStyle(TableStyle(cls_styles))
        story.append(t_cls)

        # ── Chi tiết HS ──
        story.append(Paragraph("Bảng chi tiết học sinh", st_h2))
        rows_sorted = sorted(rows, key=lambda r: _rate_sort(r["rate"]))
        hdr = [
            Paragraph("<b>STT</b>", st_cell_c),
            Paragraph("<b>Mã</b>", st_cell_c),
            Paragraph("<b>Họ tên</b>", st_cell_c),
            Paragraph("<b>Lớp</b>", st_cell_c),
            Paragraph("<b>Tổ</b>", st_cell_c),
            Paragraph("<b>Có mặt</b>", st_cell_c),
            Paragraph("<b>V.P</b>", st_cell_c),
            Paragraph("<b>V.KP</b>", st_cell_c),
            Paragraph("<b>Lỗi</b>", st_cell_c),
            Paragraph("<b>Tỉ lệ</b>", st_cell_c),
        ]
        detail_data = [hdr]
        for stt, r in enumerate(rows_sorted, 1):
            detail_data.append([
                Paragraph(str(stt), st_cell_c),
                Paragraph(str(r["ma"]), st_cell_c),
                Paragraph(xml_escape(str(r["name"])), st_cell),
                Paragraph(xml_escape(str(r["class"])), st_cell_c),
                Paragraph(xml_escape(str(r["to"])), st_cell_c),
                Paragraph(str(r["cm"]), st_cell_c),
                Paragraph(str(r["vp"]), st_cell_c),
                Paragraph(str(r["vkp"]), st_cell_c),
                Paragraph(str(r["loi"]), st_cell_c),
                Paragraph(f"<b>{_fmt_rate(r['rate'])}</b>", st_cell_c),
            ])
        t_det = Table(detail_data,
                       colWidths=[1.1 * cm, 1.4 * cm, 5.5 * cm, 1.6 * cm,
                                   1.2 * cm, 1.6 * cm, 1.3 * cm, 1.3 * cm,
                                   1.1 * cm, 1.8 * cm],
                       repeatRows=1)
        det_styles = [
            ("BACKGROUND", (0, 0), (-1, 0), rl_colors.HexColor("#4472C4")),
            ("TEXTCOLOR",  (0, 0), (-1, 0), rl_colors.white),
            ("GRID",       (0, 0), (-1, -1), 0.3, rl_colors.HexColor("#999999")),
            ("VALIGN",     (0, 0), (-1, -1), "MIDDLE"),
            ("TOPPADDING", (0, 0), (-1, -1), 3),
            ("BOTTOMPADDING", (0, 0), (-1, -1), 3),
        ]
        for i, r in enumerate(rows_sorted, start=1):
            if i % 2 == 0:
                det_styles.append(("BACKGROUND", (0, i), (-1, i),
                                    rl_colors.HexColor("#F5F7FA")))
            if r["rate"] is None:
                continue
            if r["rate"] >= 90:
                det_styles.append(("BACKGROUND", (9, i), (9, i),
                                    rl_colors.HexColor("#C6EFCE")))
            elif r["rate"] >= 75:
                det_styles.append(("BACKGROUND", (9, i), (9, i),
                                    rl_colors.HexColor("#FFEB9C")))
            else:
                det_styles.append(("BACKGROUND", (9, i), (9, i),
                                    rl_colors.HexColor("#FFC7CE")))
        t_det.setStyle(TableStyle(det_styles))
        story.append(t_det)

        # Footer
        story.append(Spacer(1, 12))
        story.append(Paragraph(
            f"Hệ Thống Quản Lý Học Sinh v{APP_VERSION} — xuất PDF",
            ParagraphStyle("Foot", parent=st_cell_c, fontSize=8,
                            textColor=rl_colors.HexColor("#888888"))))

        doc.build(story)
        log_info(f"✓ Xuất PDF: {path} ({period_label})")
        return True
    except Exception as e:
        log_error(f"Xuất PDF fail: {e}\n{traceback.format_exc()}")
        return False

def _diff_for_warning(local_data, merged_data):
    """
    So sánh local (trước save) với merged (sau merge với remote).
    Chỉ trả về những gì REMOTE đã thay đổi mà local không có.
    """
    result = {
        "new_hs":         [],
        "deleted_hs":     [],
        "att_changes":    0,
        "reason_changes": 0,
        "error_changes":  0,
    }
    local_ids  = set(local_data.keys())
    merged_ids = set(merged_data.keys())

    # HS có trong merged (remote thêm) mà local không có
    for sid in merged_ids - local_ids:
        result["new_hs"].append(
            merged_data[sid].get("name", f"Mã {sid}"))

    # HS local có mà merged không (hiếm khi xảy ra với union)
    for sid in local_ids - merged_ids:
        result["deleted_hs"].append(
            local_data[sid].get("name", f"Mã {sid}"))

    # Chi tiết cho HS chung
    for sid in local_ids & merged_ids:
        lw = local_data[sid].get("weeks", {})
        mw = merged_data[sid].get("weeks", {})
        for t in set(lw.keys()) | set(mw.keys()):
            l_t = lw.get(t) or {}
            m_t = mw.get(t) or {}
            if l_t == m_t:
                continue
            la = l_t.get("attendance", {}); ma = m_t.get("attendance", {})
            lr = l_t.get("reasons",    {}); mr = m_t.get("reasons",    {})
            le = l_t.get("errors",     {}); me = m_t.get("errors",     {})
            for day in THU:
                if bool(la.get(day, False)) != bool(ma.get(day, False)):
                    result["att_changes"] += 1
                if (lr.get(day, "") or "").strip() != (mr.get(day, "") or "").strip():
                    result["reason_changes"] += 1
                if (le.get(day, "") or "").strip() != (me.get(day, "") or "").strip():
                    result["error_changes"] += 1
    return result

