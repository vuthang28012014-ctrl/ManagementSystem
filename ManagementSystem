    # ═══ Threading helpers ═══
    def _drain_ui_queue(self):
        """Chạy trong main thread: thực thi callback do thread phụ xếp hàng."""
        try:
            while True:
                cb, arg = self._ui_queue.get_nowait()
                try:
                    cb(arg)
                except Exception as e:
                    log_error(f"UI callback fail: {e}\n{traceback.format_exc()}")
        except queue.Empty:
            pass
        try:
            self.root.after(40, self._drain_ui_queue)
        except Exception:
            pass

    def _async(self, fn, on_success=None, on_error=None):
        def _safe_call(cb, arg):
            # Không chạm Tk từ thread phụ, chỉ xếp hàng cho main thread
            self._ui_queue.put((cb, arg))

        def worker():
            try:
                result = fn()
                if on_success:
                    _safe_call(on_success, result)
            except Exception as e:
                tb = traceback.format_exc()
                log_error(f"Async task fail: {e}\n{tb}")
                if on_error:
                    _safe_call(on_error, e)
        threading.Thread(target=worker, daemon=True).start()

