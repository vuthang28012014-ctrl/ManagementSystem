def github_commits(config, limit=30):
    """Lấy list commits của path. Trả list dict hoặc []."""
    if not URLLIB_OK or not config:
        return []
    owner, repo, branch, path = (config["owner"], config["repo"],
                                 config["branch"], config["path"])
    url = (f"https://api.github.com/repos/{owner}/{repo}/commits"
           f"?path={path}&sha={branch}&per_page={limit}")
    headers = {
        "Authorization": f"token {config['token']}",
        "Accept": "application/vnd.github.v3+json",
        "User-Agent": "ManagementSystem/2.0",
    }
    try:
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        out = []
        for c in data:
            out.append({
                "sha":    c["sha"],
                "short":  c["sha"][:7],
                "msg":    c["commit"]["message"],
                "author": c["commit"]["author"]["name"],
                "email":  c["commit"]["author"]["email"],
                "date":   c["commit"]["author"]["date"],
            })
        return out
    except urllib.error.HTTPError as e:
        log_error(f"Fetch commits HTTP {e.code}")
        return []
    except Exception as e:
        log_error(f"Fetch commits fail: {e}")
        return []


def github_content_at_sha(config, sha):
    """Lấy content file tại 1 commit. Trả string hoặc None."""
    if not URLLIB_OK or not config:
        return None
    owner, repo, path = config["owner"], config["repo"], config["path"]
    url = f"https://api.github.com/repos/{owner}/{repo}/contents/{path}?ref={sha}"
    headers = {
        "Authorization": f"token {config['token']}",
        "Accept": "application/vnd.github.v3+json",
        "User-Agent": "ManagementSystem/2.0",
    }
    try:
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        if data.get("content"):
            return base64.b64decode(data["content"]).decode("utf-8")
        raw_headers = dict(headers)
        raw_headers["Accept"] = "application/vnd.github.v3.raw"
        req2 = urllib.request.Request(url, headers=raw_headers)
        with urllib.request.urlopen(req2, timeout=30) as resp2:
            return resp2.read().decode("utf-8")
    except Exception as e:
        log_error(f"Fetch content @{sha[:7]} fail: {e}")
        return None

def github_health_check(config, need_push=True):
    """Trả (ok, msg). Chạy trong thread."""
    if not config:
        return False, "no config"
    try:
        url = (f"https://api.github.com/repos/{config['owner']}/{config['repo']}")
        req = urllib.request.Request(url, headers={
            "Authorization": f"token {config['token']}",
            "User-Agent":    "ManagementSystem/2.0",
        })
        with urllib.request.urlopen(req, timeout=10) as resp:
            if resp.status == 200:
                data = json.loads(resp.read().decode("utf-8"))
                if not data.get("private", True):
                    return False, "Repo đang PUBLIC — dữ liệu HS bị lộ!"
                if not need_push or data.get("permissions", {}).get("push"):
                    return True, "OK"
                return False, "Không có quyền push"
    except urllib.error.HTTPError as e:
        if e.code == 401:
            return False, "Token không hợp lệ"
        if e.code == 404:
            return False, "Repo không tồn tại"
        return False, f"HTTP {e.code}"
    except Exception as e:
        return False, str(e)
    return False, "unknown"


