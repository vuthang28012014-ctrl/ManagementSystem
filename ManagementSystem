                ry = self.root.winfo_rooty()
                rw = self.root.winfo_width()
                rh = self.root.winfo_height()

                # Chụp cửa sổ
                img = ImageGrab.grab(bbox=(rx, ry, rx + rw, ry + rh))

                # Làm mờ Gauss
                img = img.filter(ImageFilter.GaussianBlur(radius=12))

                # Phủ lớp tối nhẹ để card nổi hơn
