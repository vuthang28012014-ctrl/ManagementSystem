        def on_err(e):
            self._stop_progress()
            self.thong_bao(f"✗ Lỗi: {e}", self.DO)

        self._async(task, on_success=on_done, on_error=on_err)

    def _mo_file_bang_os(self, path):
        """Mở file bằng app mặc định của OS."""
        try:
            if sys.platform == "win32":
                os.startfile(path)
            elif sys.platform == "darwin":
                import subprocess
                subprocess.Popen(["open", path])
            else:
                import subprocess
                subprocess.Popen(["xdg-open", path])
        except Exception as e:
            log_warn(f"Không mở được file: {e}")

