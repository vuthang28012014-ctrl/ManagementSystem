    def _tuan_truoc(self):
        t = max(1, self.tuan_hien_tai - 1)
        self.bien_tuan.set(f"Tuần {t}")
        self._khi_doi_tuan()

    def _tuan_sau(self):
        t = min(TONG_TUAN, self.tuan_hien_tai + 1)
        self.bien_tuan.set(f"Tuần {t}")
        self._khi_doi_tuan()

    def _du_lieu_tuan(self, ma, tuan=None):
        d = self.HocSinh.get(ma)
        if not d: return None
        t = tuan if tuan is not None else self.tuan_hien_tai
        weeks = d.setdefault("weeks", tao_du_lieu_tat_ca_tuan())

        # ── FIX: nếu lỡ có key string thì normalize về int ──
        if weeks and any(isinstance(k, str) for k in weeks.keys()):
            weeks_int = {}
            for k, v in weeks.items():
                try:
                    weeks_int[int(k)] = _chuan_hoa_tuan(v)
                except (ValueError, TypeError):
                    continue
            for ti in range(1, TONG_TUAN + 1):
                weeks_int.setdefault(ti, tuan_moi())
            d["weeks"] = weeks_int
            weeks = weeks_int

        if t not in weeks:
            weeks[t] = tuan_moi()
        else:
            weeks[t] = _chuan_hoa_tuan(weeks[t])
        return weeks[t]

    def _tuan_co_the_sua(self, tuan=None):
        t = tuan if tuan is not None else self.tuan_hien_tai
        return t <= self.settings["max_editable_week"]

