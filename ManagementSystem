        to_str = f"T{d['to']} · " if d.get("to") else ""
        vals = [f"{to_str}{d['name']} ({d['class']})"] + \
               [self._ky_hieu_o(ma, day) for day in THU]
        try: self.bang_dd.item(str(ma), values=vals)
        except Exception: pass

