# UNDO / REDO STACK
# ═══════════════════════════════════════════════════════════════
class UndoStack:
    def __init__(self, size=30):
        self.undo = deque(maxlen=size)
        self.redo = deque(maxlen=size)

    def push(self, snapshot, label=""):
        self.undo.append((snapshot, label, _time.time()))
        self.redo.clear()

    def do_undo(self):
        if not self.undo: return None
        return self.undo.pop()

    def do_redo(self):
        if not self.redo: return None
        return self.redo.pop()

    def push_redo(self, snapshot, label):
        self.redo.append((snapshot, label, _time.time()))

    def clear(self):
        self.undo.clear(); self.redo.clear()

    def can_undo(self): return bool(self.undo)
    def can_redo(self): return bool(self.redo)


