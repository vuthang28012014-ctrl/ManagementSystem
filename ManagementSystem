    # ═══ HS CRUD ═══
    def them_hoc_sinh(self):
        """Thêm mới nếu Mã chưa có, cập nhật nếu Mã đã tồn tại."""
        ma_str = self.o_ma.get().strip()
        ten    = self.o_ten.get().strip()
        lop    = self.o_lop.get().strip()
        to     = self.o_to.get().strip()

        if not ma_str or not ten or not lop:
            self.thong_bao("⚠ Nhập đầy đủ Mã, Tên, Lớp", self.VANG)
            return
        try:
            ma = int(ma_str)
        except ValueError:
            self.thong_bao("⚠ Mã phải là số nguyên", self.DO)
            self.o_ma.focus_set()
            return

        # Chuẩn hóa tổ
        if to and to not in ("1", "2", "3", "4"):
            self.thong_bao("⚠ Tổ phải là 1, 2, 3, 4 hoặc để trống", self.VANG)
            self.o_to.focus_set()
            return

        to_str = f", Tổ {to}" if to else ""

        # ── TRƯỜNG HỢP 1: ĐÃ TỒN TẠI → SỬA ──
        if ma in self.HocSinh:
            d = self.HocSinh[ma]
            old_name  = d.get("name",  "")
            old_class = d.get("class", "")
            old_to    = d.get("to",    "")

            # Không có gì đổi → thoát
            if old_name == ten and old_class == lop and old_to == to:
                self.thong_bao("⚠ Không có gì thay đổi", self.CHU_MO)
                return

            self._snapshot(f"Sửa HS {ma}")

            # Cập nhật từng field
            d["name"]  = ten
            d["class"] = lop
            d["to"]    = to

            self.xoa_form()
            self.cap_nhat_bang()
            self.cap_nhat_diem_danh()

            # Thông báo chi tiết cái gì đổi
            changes = []
            if old_name  != ten: changes.append(f"tên '{old_name}' → '{ten}'")
            if old_class != lop: changes.append(f"lớp '{old_class}' → '{lop}'")
            if old_to    != to:
                o = old_to if old_to else "∅"
                n = to      if to      else "∅"
                changes.append(f"tổ {o} → {n}")

            detail = " · ".join(changes) if changes else "cập nhật"
            self.thong_bao(f"✓ Đã sửa mã {ma}: {detail}", self.CAM)

            # Flash row vừa sửa
            if self.settings.get("enable_animation", True):
                self.bang.after(50, lambda: flash_row(
                    self.bang, str(ma), color="#5a5a3f", duration=500))
                self.bang_dd.after(50, lambda: flash_row(
                    self.bang_dd, str(ma), color="#5a5a3f", duration=500))
            return

        # ── TRƯỜNG HỢP 2: CHƯA TỒN TẠI → THÊM MỚI ──
        self._snapshot(f"Thêm HS {ma}")
        self.HocSinh[ma] = {
            "name": ten, "class": lop, "to": to,
            "weeks": tao_du_lieu_tat_ca_tuan(),
        }
        self.xoa_form()
        self.cap_nhat_bang()
        self.cap_nhat_diem_danh()
        self.thong_bao(
            f"✓ Đã thêm: {ten} (Mã {ma}, {lop}{to_str})", self.XANH_LA)

        # Flash row mới
        if self.settings.get("enable_animation", True):
            self.bang.after(50, lambda: flash_row(
                self.bang, str(ma), color="#3f5a3f", duration=500))

    def xoa_da_chon(self):
        sel = self.bang.selection()
        if not sel:
            self.thong_bao("⚠ Chưa chọn HS nào", self.VANG); return
