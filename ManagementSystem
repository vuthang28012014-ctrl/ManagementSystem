        INDICATOR_RADIUS = 10          # bán kính bo góc (px)

        def _rr_coords(x1, y1, x2, y2, r=INDICATOR_RADIUS):
            """Trả list toạ độ cho rounded rectangle (polygon smooth=True)."""
            # Giới hạn r không vượt nửa width/height
            max_r = min(abs(x2 - x1) / 2, abs(y2 - y1) / 2)
            r = min(r, max_r)
            # 20 điểm, mỗi góc có 2 điểm trùng để bo cong
            return (
                x1+r, y1,
                x1+r, y1,
                x2-r, y1,
                x2-r, y1,
                x2, y1,
                x2, y1+r,
                x2, y1+r,
                x2, y2-r,
                x2, y2-r,
                x2, y2,
                x2-r, y2,
                x2-r, y2,
                x1+r, y2,
                x1+r, y2,
                x1, y2,
                x1, y2-r,
                x1, y2-r,
                x1, y1+r,
                x1, y1+r,
                x1, y1,
            )

        indicator_id = tab_bar.create_polygon(
