                        try: w.destroy()
                        except Exception: pass
                        setattr(self, attr, None)
                # Force cập nhật UI để widget biến mất ngay
                try: self.root.update_idletasks()
                except Exception: pass

            # Fade out — chụp card rồi blend với màu nền
            if self.settings.get("enable_animation", True) and PIL_OK:
                try:
                    cw = getattr(self, "_settings_card_w", 620)
                    ch = getattr(self, "_settings_card_h", 660)
                    card_obj = getattr(self, "_settings_overlay", None)

                    # Xóa cover cũ nếu đang có
                    old_cover = getattr(self, "_settings_cover", None)
                    if old_cover is not None:
                        try: old_cover.destroy()
                        except Exception: pass
                        self._settings_cover = None

                    # Chụp card
                    img_card = None
                    if card_obj is not None:
                        try:
                            card_obj.update_idletasks()
                            self.root.update()
                        except Exception:
                            pass
                        img_card = _grab_widget_image(card_obj, cw, ch)

                    if img_card is not None:
                        # Ẩn card thật
                        try: card_obj.place_forget()
                        except Exception: pass

                        cover = tk.Label(self.root, borderwidth=0, bg=self.NEN)
                        cover.place(relx=0.5, rely=0.5, anchor="center",
                                    width=cw, height=ch)
                        cover.lift()
                        blur = getattr(self, "_settings_blur", None)
                        if blur is not None:
                            try: blur.lift()
                            except Exception: pass
                        cover.lift()
                        self._settings_cover = cover

                        total = 12
                        def _fade_out_step(i):
                            if i > total:
                                try: cover.destroy()
                                except Exception: pass
                                self._settings_cover = None
                                _do_destroy()
                                return
                            t = i / total
                            k = t * t * (3 - 2 * t)
                            # alpha card: 1 → 0
                            alpha = 1.0 - k
                            photo = _blend_card_with_bg(
                                img_card, cw, ch, alpha, self.NEN)
                            if photo:
                                cover.configure(image=photo)
                                cover.image = photo
                            self.root.after(14, lambda: _fade_out_step(i + 1))

                        self.root.after(0, lambda: _fade_out_step(0))
                        return
                except Exception as e:
                    log_warn(f"Fade out fail: {e}")

            # Fallback: destroy ngay
            _do_destroy()
        
        # ═══ Blur overlay — chụp màn hình + làm mờ bằng Pillow ═══
