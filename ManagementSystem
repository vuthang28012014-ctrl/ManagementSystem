            UPDATE_URL,
            headers={
                "User-Agent": f"ManagementSystem/{APP_VERSION}",
                "Cache-Control": "no-cache",
            })
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.read().decode("utf-8", errors="replace")
    except urllib.error.HTTPError as e:
        log_warn(f"Fetch update HTTP {e.code}")
        return None
    except Exception as e:
        log_warn(f"Fetch update fail: {e}")
        return None

def _fix_double_newlines(text):
    """
    Gộp dòng trống xen kẽ sinh ra do copy từ Word / web chat / markdown render.
    Chỉ gọi khi đã xác định file bị lỗi (ratio dòng trống > 35%).
    
    Logic: nếu dòng hiện tại KHÔNG trống, dòng ngay sau TRỐNG, 
    và dòng sau nữa KHÔNG trống → bỏ dòng trống đó.
    Dòng trống giữa các block (2+ dòng trống liên tiếp) sẽ được giữ.
    """
    lines = text.split("\n")
    result = []
    i = 0
    n = len(lines)
    while i < n:
        result.append(lines[i])
        if (i + 2 < n
                and lines[i].strip() != ""
                and lines[i + 1].strip() == ""
                and lines[i + 2].strip() != ""):
            i += 2   # bỏ dòng trống xen kẽ
        else:
            i += 1
    cleaned = "\n".join(result)
    # Gộp 3+ dòng trống liên tiếp thành 2 (chuẩn PEP8)
    import re as _re
    cleaned = _re.sub(r"\n{4,}", "\n\n\n", cleaned)
    return cleaned

def doc_file(HocSinh, filename=DATA_FILE):
    """Load data — ưu tiên GitHub, fallback local.
    Trả về (số_hs, warnings_list)."""
    warnings = []
    content  = None

    if GH_CONFIG:
        log_info(f"Đang tải từ GitHub {GH_CONFIG['owner']}/{GH_CONFIG['repo']}...")
        gh = github_fetch(GH_CONFIG)
        if gh:
            content = gh
            try:
                with open(filename, "w", encoding="utf-8") as f:
                    f.write(content)
                log_info("✓ Đã đồng bộ từ GitHub")
            except Exception as e:
                log_warn(f"Không ghi local: {e}")
        else:
            log_warn("GitHub không có — fallback local")

    if content is None:
        if not os.path.exists(filename):
            return 0, warnings
        try:
            with open(filename, "r", encoding="utf-8") as f:
                content = f.read().strip()
        except Exception as e:
            log_error(f"Đọc file lỗi: {e}")
            return 0, warnings

    if not content:
        return 0, warnings

    try:
        raw = json.loads(
            content,
            object_pairs_hook=lambda p: _object_pairs_hook_clean(p, warnings)
        )
    except json.JSONDecodeError as e:
        log_error(f"JSON lỗi: {e} — thử format text cũ")
        for line in content.splitlines():
            line = line.strip()
            if not line: continue
            parts = line.split("|")
            if len(parts) != 3: continue
            try:
                sid = int(parts[0])
                HocSinh[sid] = {
                    "name": parts[1], "class": parts[2],
                    "weeks": tao_du_lieu_tat_ca_tuan(),
                }
            except ValueError:
                continue
        return len(HocSinh), warnings

    # Migrate + validate
    bad_count = 0
    for sid_str, info in raw.items():
        try:
            sid = int(sid_str)
        except ValueError:
            bad_count += 1; continue

        # Migration: format cũ top-level attendance/reasons/errors → weeks[1]
        if "weeks" not in info:
            info["weeks"] = tao_du_lieu_tat_ca_tuan()
            info["weeks"][1]["attendance"] = info.get("attendance", diem_danh_moi())
            info["weeks"][1]["reasons"]    = info.get("reasons",    ly_do_moi())
            info["weeks"][1]["errors"]     = info.get("errors",     loi_moi())
            for k in ("attendance", "reasons", "errors"):
                info.pop(k, None)

        # ── Chuẩn hóa key int + điền tuần thiếu ──
        weeks_int = {}
        for k, v in info["weeks"].items():
            try:
                t_int = int(k)
            except (ValueError, TypeError):
                continue
            weeks_int[t_int] = _chuan_hoa_tuan(v)

        for t in range(1, TONG_TUAN + 1):
            if t not in weeks_int:
                weeks_int[t] = tuan_moi()

        info["weeks"] = weeks_int

        # Đảm bảo có field "to" (tổ)
        if "to" not in info:
            info["to"] = ""
        else:
            info["to"] = str(info["to"]).strip()

        # Validate schema
        if not validate_hs_info(info):
            log_warn(f"HS {sid} sai schema — chuyển name/class thành str")
            info["name"]  = str(info.get("name",  ""))
            info["class"] = str(info.get("class", ""))

        HocSinh[sid] = info

    if bad_count:
        warnings.append(f"{bad_count} HS có mã không hợp lệ đã bị bỏ qua")

    return len(HocSinh), warnings

