# GITHUB SYNC MODULE
# ═══════════════════════════════════════════════════════════════
try:
    import urllib.request
    import urllib.error
    URLLIB_OK = True
except ImportError:
    URLLIB_OK = False

GH_CONFIG_FILE = "github_config.json"

# Biến global — được gán trong __init__
GH_CONFIG = None          # dict config hoặc None
GH_LAST_SYNC = 0.0        # timestamp lần sync gần nhất


def _load_gh_config():
    """Đọc file github_config.json. Trả None nếu không có/lỗi."""
    if not os.path.exists(GH_CONFIG_FILE):
        return None
    try:
        with open(GH_CONFIG_FILE, "r", encoding="utf-8") as f:
            cfg = json.load(f)
        for k in ("owner", "repo", "token"):
            if not cfg.get(k):
                print(f"[GitHub] Config thiếu key: {k}")
                return None
        cfg.setdefault("branch", "main")
        cfg.setdefault("path", "output.txt")
        return cfg
    except Exception as e:
        print(f"[GitHub] Không đọc được config: {e}")
        return None


def github_fetch(config):
    """Tải file từ GitHub. Trả về string hoặc None."""
    if not URLLIB_OK or not config:
        return None
    owner = config["owner"]
    repo = config["repo"]
    branch = config["branch"]
    path = config["path"]
    # cache-buster để lấy bản mới
    url = (f"https://raw.githubusercontent.com/{owner}/{repo}/"
           f"{branch}/{path}?t={int(_time.time())}")
    try:
        req = urllib.request.Request(url, headers={
            "User-Agent": "ManagementSystem",
            "Cache-Control": "no-cache",
        })
        with urllib.request.urlopen(req, timeout=15) as resp:
            return resp.read().decode("utf-8")
    except urllib.error.HTTPError as e:
        if e.code == 404:
            print("[GitHub] File chưa có trên GitHub → bắt đầu rỗng")
            return "{}"
        print(f"[GitHub] Fetch lỗi HTTP {e.code}")
        return None
    except Exception as e:
        print(f"[GitHub] Fetch thất bại: {e}")
        return None


def github_push(config, content, commit_msg="Cập nhật dữ liệu học sinh"):
    """Đẩy file lên GitHub. Trả True/False."""
    if not URLLIB_OK or not config:
        return False
    owner = config["owner"]
    repo = config["repo"]
    branch = config["branch"]
    path = config["path"]
    token = config["token"]

    api_url = f"https://api.github.com/repos/{owner}/{repo}/contents/{path}"
    headers = {
        "Authorization": f"token {token}",
        "Accept": "application/vnd.github.v3+json",
        "User-Agent": "ManagementSystem",
    }

    # Lấy SHA hiện tại (bắt buộc khi update)
    sha = None
    try:
        req = urllib.request.Request(api_url + f"?ref={branch}", headers=headers)
        with urllib.request.urlopen(req, timeout=10) as resp:
            sha = json.loads(resp.read().decode("utf-8")).get("sha")
    except urllib.error.HTTPError as e:
        if e.code == 404:
            sha = None
        else:
            print(f"[GitHub] Lỗi lấy SHA: HTTP {e.code}")
            return False
    except Exception as e:
        print(f"[GitHub] Lỗi lấy SHA: {e}")
        return False

    # Push — thử lại 3 lần nếu conflict
    for attempt in range(3):
        body = {
            "message": commit_msg,
            "content": base64.b64encode(content.encode("utf-8")).decode("ascii"),
            "branch": branch,
        }
        if sha:
            body["sha"] = sha

        try:
            req = urllib.request.Request(
                api_url,
                data=json.dumps(body).encode("utf-8"),
                headers={**headers, "Content-Type": "application/json"},
                method="PUT",
            )
            with urllib.request.urlopen(req, timeout=20) as resp:
                if resp.status in (200, 201):
                    return True
        except urllib.error.HTTPError as e:
            if e.code in (409, 422):
                print(f"[GitHub] Conflict — thử lại {attempt+1}/3")
                _time.sleep(1)
                try:
                    req2 = urllib.request.Request(api_url + f"?ref={branch}",
                                                    headers=headers)
                    with urllib.request.urlopen(req2, timeout=10) as resp2:
                        sha = json.loads(resp2.read().decode("utf-8")).get("sha")
                except Exception:
                    pass
                continue
            else:
                print(f"[GitHub] Push HTTP {e.code}")
                return False
        except Exception as e:
            print(f"[GitHub] Push lỗi: {e}")
            return False

    print("[GitHub] Push thất bại sau 3 lần")
    return False


