                 bg=self.NEN2, fg=self.CHU_MO,
                 font=("Segoe UI", 8, "italic")).pack(side="left", padx=15)
        tk.Button(footer, text="Đóng", command=lambda: close_settings(),
                  bg=self.XANH_DUONG, fg="#1e1e2e",
                  activebackground=self.XANH_DUONG_H,
                  relief="flat", cursor="hand2",
                  font=("Segoe UI", 9, "bold"),
                  padx=20, pady=5, bd=0
                  ).pack(side="right", padx=15, pady=10)

        close_btn.config(command=close_settings)

        # Mở tab mặc định
        switch_tab("effects")

        # ═══ GLOW-IN — viền card sáng dần từ NEN → XANH_DUONG ═══
        if self.settings.get("enable_animation", True):
            card.configure(highlightbackground=self.NEN)

            _from_rgb = _hex_to_rgb(self.NEN)
            _to_rgb   = _hex_to_rgb(self.XANH_DUONG)

            def _glow_step(i=0, total=14):
                if i > total:
                    try:
                        card.configure(highlightbackground=self.XANH_DUONG)
                    except Exception:
                        pass
                    return
                k = i / total
                k = 1 - (1 - k) ** 3        # ease-out cubic
                try:
                    rgb = tuple(_lerp(_from_rgb[j], _to_rgb[j], k)
                                for j in range(3))
                    card.configure(highlightbackground=_rgb_to_hex(rgb))
                except Exception:
                    return
                self.root.after(16, lambda: _glow_step(i + 1, total))

            self.root.after(30, lambda: _glow_step(0))

        # Lưu hàm đóng để Esc gọi
        self._close_settings_fn = close_settings

