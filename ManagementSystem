    def _tuan_moi_nhat_co_du_lieu(self):
        """Tuần lớn nhất có ít nhất 1 ô đã điểm danh/ghi lý do. None nếu chưa có."""
        best = None
        for d in self.HocSinh.values():
            for t, w in (d.get("weeks") or {}).items():
                if best is not None and t <= best:
                    continue
                if not _tuan_rong(w):
                    best = t
        return best

