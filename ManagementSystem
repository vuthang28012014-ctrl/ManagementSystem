    def xuat_excel_all(self):
        """Xuất cả năm theo định dạng đã chọn trong Settings."""
        if not self.HocSinh:
            self.thong_bao("⚠ Không có dữ liệu", self.VANG); return

        fmt = self.settings.get("export_format", "excel")
        if fmt == "word":
            self._xuat_word_all()
            return

        # Mặc định: Excel
        if not OPENPYXL_OK:
            messagebox.showwarning(
                "Cần openpyxl",
                "Tính năng xuất nhiều sheet cần thư viện openpyxl.\n\n"
                "Cài đặt: pip install openpyxl")
            return

        path = filedialog.asksaveasfilename(
            defaultextension=".xlsx",
            filetypes=[("Excel files", "*.xlsx"), ("All files", "*.*")],
            initialfile="diem_danh_ca_nam.xlsx")
        if not path: return

        # Snapshot để thread đọc — tránh race condition
        hs_snapshot = deepcopy(self.HocSinh)
        ly_do_md = self.settings["ly_do_mac_dinh"]

