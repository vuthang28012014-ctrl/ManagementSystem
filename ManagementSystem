        err_chart.y_axis.scaling.min = 0
        err_chart.y_axis.scaling.max = 100
        err_chart.x_axis.title = "Tuần"
        err_chart.height = 10
        err_chart.width = 22
        err_chart.x_axis.delete = False
        err_chart.y_axis.delete = False
