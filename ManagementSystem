ZALO_API_BASE = "https://bot-api.zaloplatforms.com"


def zalo_send(bot_token, chat_id, text, timeout=12, parse_mode="html"):
    """Gửi Zalo; nếu HTTP 400 khi dùng parse_mode thì gửi lại dạng text thuần."""
    ok, err = _zalo_send_once(bot_token, chat_id, text, timeout, parse_mode)
    if not ok and parse_mode and str(err).startswith("HTTP 400"):
        plain = _html.unescape(re.sub(r"<[^>]+>", "", text))
        return _zalo_send_once(bot_token, chat_id, plain, timeout, None)
    return ok, err


def _zalo_send_once(bot_token, chat_id, text, timeout=12, parse_mode="html"):
    """Gửi 1 lần qua Zalo Bot Platform. Trả (ok, err)."""
    if not URLLIB_OK:
        return False, "Thiếu urllib"
    if not bot_token or not chat_id:
        return False, "Thiếu token/chat_id"
    try:
        url = f"{ZALO_API_BASE}/bot{bot_token.strip()}/sendMessage"
        payload = {
            "chat_id": str(chat_id).strip(),
            "text": text,
        }
        if parse_mode:
            payload["parse_mode"] = parse_mode
        body = json.dumps(payload).encode("utf-8")
        req = urllib.request.Request(
            url, data=body,
            headers={"Content-Type": "application/json; charset=utf-8"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            if resp.status == 200:
                data = json.loads(resp.read().decode("utf-8"))
                if data.get("ok", True):
                    return True, None
                return False, data.get("description", "unknown error")
            return False, f"HTTP {resp.status}"
    except urllib.error.HTTPError as e:
        try:
            err_body = e.read().decode("utf-8", errors="replace")
            return False, f"HTTP {e.code}: {err_body[:150]}"
        except Exception:
            return False, f"HTTP {e.code}"
    except Exception as e:
        return False, str(e)


