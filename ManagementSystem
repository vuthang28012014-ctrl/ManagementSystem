# ANIMATION HELPERS
# ═══════════════════════════════════════════════════════════════
def _lerp(a, b, t): return a + (b - a) * t

def _hex_to_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))

def _rgb_to_hex(rgb):
    return "#{:02x}{:02x}{:02x}".format(*[max(0, min(255, int(c))) for c in rgb])


def animate_color(widget, from_color, to_color, duration=150, steps=8,
                  attr="bg", on_done=None):
    """Tween widget color (bg/fg) từ from_color → to_color."""
    if not widget: return
    try:
        f = _hex_to_rgb(from_color)
        t = _hex_to_rgb(to_color)
    except Exception:
        return
    delay = max(10, duration // steps)

    def step(i):
        try:
            if not widget.winfo_exists(): return
        except Exception:
            return
        k = i / steps
        k = 1 - (1 - k) ** 3        # ease-out cubic
        cur = tuple(_lerp(f[j], t[j], k) for j in range(3))
        try:
            widget.configure(**{attr: _rgb_to_hex(cur)})
        except tk.TclError:
            return
        if i < steps:
            widget.after(delay, lambda: step(i + 1))
        elif on_done:
            on_done()

    step(0)


def fade_in_window(root, duration=280, steps=14):
    """Fade cửa sổ từ alpha 0 → 1 (Windows/macOS)."""
    try:
        root.attributes("-alpha", 0.0)
    except Exception:
        return
    def step(i):
        try: root.attributes("-alpha", i / steps)
        except Exception: return
        if i < steps:
            root.after(max(12, duration // steps), lambda: step(i + 1))
    step(1)


def _remove_flash(tree, iid, tag, orig_tags):
    try:
        if tree.exists(iid):
            tree.item(iid, tags=orig_tags)
    except Exception:
        pass
    # Xóa tag để tránh memory leak tích tụ
    try:
        tree.tag_delete(tag)
    except Exception:
        pass


def flash_row(tree, iid, color="#45475a", duration=420):
    """Nhấp nháy 1 row Treeview (tự xóa tag sau khi xong)."""
    try:
        if not tree.exists(iid): return
        FLASH_TAG = "_flash_row"
        tree.tag_configure(FLASH_TAG, background=color)
        orig = list(tree.item(iid, "tags"))
        if FLASH_TAG not in orig:
            tree.item(iid, tags=orig + [FLASH_TAG])
        tree.after(duration, lambda: _remove_flash(tree, iid, FLASH_TAG, orig))
    except Exception:
        pass

def _grab_widget_image(widget, w, h):
    """Chụp ảnh widget từ màn hình. Trả PIL.Image (RGB) hoặc None."""
    if not PIL_OK or widget is None:
        return None
    try:
        widget.update_idletasks()
        rx = widget.winfo_rootx()
        ry = widget.winfo_rooty()
        img = ImageGrab.grab(bbox=(rx, ry, rx + w, ry + h))
        return img.convert("RGB")
    except Exception as e:
        log_warn(f"Grab widget fail: {e}")
        return None


def _blend_card_with_bg(img, w, h, alpha, bg_hex):
    """
    Blend ảnh card với màu nền.
    alpha = 1 → ảnh rõ hoàn toàn
    alpha = 0 → chỉ thấy màu nền
    """
    if not PIL_OK or img is None:
        return None
    try:
        rgb = _hex_to_rgb(bg_hex)
        bg = Image.new("RGB", (w, h), rgb)
        a = max(0.0, min(1.0, alpha))
        blended = Image.blend(bg, img, a)
        return ImageTk.PhotoImage(blended)
    except Exception:
        return None
