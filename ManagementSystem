def _normalize_remote(raw):
    """Chuẩn hóa data remote về format chuẩn."""
    out = {}
    for sid_str, info in raw.items():
        if sid_str == "_meta":
            continue
        try:
            sid = int(sid_str)
        except (ValueError, TypeError):
            continue
        if "weeks" not in info:
            info["weeks"] = tao_du_lieu_tat_ca_tuan()
            info["weeks"][1]["attendance"] = info.get("attendance", diem_danh_moi())
            info["weeks"][1]["reasons"]    = info.get("reasons",    ly_do_moi())
            info["weeks"][1]["errors"]     = info.get("errors",     loi_moi())
            for k in ("attendance", "reasons", "errors"):
                info.pop(k, None)
        for t in range(1, TONG_TUAN + 1):
            if t not in info["weeks"]:
                info["weeks"][t] = tuan_moi()
            else:
                info["weeks"][t] = _chuan_hoa_tuan(info["weeks"][t])
        if not validate_hs_info(info):
            info["name"]  = str(info.get("name",  ""))
            info["class"] = str(info.get("class", ""))
        out[sid] = info
    return out


def _merge_week(local_w, remote_w):
    """
    Union merge 1 tuần:
      - attendance: OR (ai true thì true)
      - reasons:    local nếu có, ngược lại remote
      - errors:     local nếu có, ngược lại remote
    """
    merged = {"attendance": {}, "reasons": {}, "errors": {}}
    for day in THU:
        la = bool(local_w.get("attendance", {}).get(day, False))
        ra = bool(remote_w.get("attendance", {}).get(day, False))
        merged["attendance"][day] = la or ra

        lr = (local_w.get("reasons",  {}).get(day, "") or "").strip()
        rr = (remote_w.get("reasons", {}).get(day, "") or "").strip()
        merged["reasons"][day] = lr if lr else rr

        le = (local_w.get("errors",  {}).get(day, "") or "").strip()
        re_ = (remote_w.get("errors", {}).get(day, "") or "").strip()
        merged["errors"][day] = le if le else re_
    return merged


def _merge_hs(local_hs, remote_hs):
    """Union merge 1 học sinh."""
    merged = {
        "name":  local_hs.get("name")  or remote_hs.get("name",  ""),
        "class": local_hs.get("class") or remote_hs.get("class", ""),
        "weeks": {},
    }
    lw = local_hs.get("weeks", {}) or {}
    rw = remote_hs.get("weeks", {}) or {}
    all_weeks = {str(k) for k in lw.keys()} | {str(k) for k in rw.keys()}
    for wk in all_weeks:
        l_val = lw.get(wk) or lw.get(int(wk) if wk.isdigit() else wk)
        r_val = rw.get(wk) or rw.get(int(wk) if wk.isdigit() else wk)
        if l_val and r_val:
            merged["weeks"][wk] = _merge_week(l_val, r_val)
        elif l_val:
            merged["weeks"][wk] = l_val
        else:
            merged["weeks"][wk] = r_val
    # Đảm bảo đủ 35 tuần
    for t in range(1, TONG_TUAN + 1):
        key = str(t)
        if key not in merged["weeks"]:
            merged["weeks"][key] = tuan_moi()
    return merged


def merge_data(local_data, remote_data):
    """
    Merge toàn bộ dataset.
    local_data / remote_data: dict {sid_int: hs_info}
    Trả về dict {sid_int: merged_info}
    """
    merged = {}
    all_ids = set(local_data.keys()) | set(remote_data.keys())
    for sid in all_ids:
        l_hs = local_data.get(sid)
        r_hs = remote_data.get(sid)
        if l_hs and r_hs:
            merged[sid] = _merge_hs(l_hs, r_hs)
        elif l_hs:
            merged[sid] = l_hs
        else:
            merged[sid] = r_hs
    return merged

def ghi_file(HocSinh, ly_do_mac_dinh, filename=DATA_FILE):
    """
    Pull remote → merge với local → ghi local → push.
    Trả (ok_local, ok_gh, err, merged_dict_or_None).

    merged_dict: chỉ khác None nếu có merge xảy ra (để UI refresh).
    """
    # Auto-fill lý do
    for sid, d in HocSinh.items():
        for t, w in d.get("weeks", {}).items():
            att = w.get("attendance", {})
            rea = w.setdefault("reasons", ly_do_moi())
            for day in THU:
                if not att.get(day, False) and not rea.get(day, "").strip():
                    rea[day] = ly_do_mac_dinh

    merged_dict = None

    # ─────── BƯỚC 1: PULL REMOTE ───────
    if GH_CONFIG:
        log_info("Đang pull data mới nhất từ GitHub...")
        remote_raw = github_fetch(GH_CONFIG)
        if remote_raw:
            try:
                parsed_raw = json.loads(
                    remote_raw,
                    object_pairs_hook=_object_pairs_hook_clean,
                )
                remote_data = _normalize_remote(parsed_raw)
                local_data  = {int(k): v for k, v in HocSinh.items()}
                merged_dict = merge_data(local_data, remote_data)
                log_info(f"✓ Merge OK — {len(merged_dict)} HS "
                         f"(local {len(local_data)} / remote {len(remote_data)})")
            except Exception as e:
                log_error(f"Merge fail: {e} — push local only")
                merged_dict = None
        else:
            log_warn("Không fetch được remote — push local only")

    # ─────── BƯỚC 2: ĐÓNG GÓI ───────
    source = merged_dict if merged_dict is not None else HocSinh
    payload = {
        "_meta": {"updated_at": datetime.now(timezone.utc).isoformat()},
    }
    for k, v in source.items():
        payload[str(k)] = v
    content = json.dumps(payload, indent=2, ensure_ascii=False)

    # Backup
    _backup_file(filename, keep=DEFAULT_SETTINGS["backup_count"])

    # Ghi local atomic
    ok_local = False
    try:
        tmp = filename + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, filename)
        ok_local = True
        log_info("✓ Ghi local OK")
    except Exception as e:
        log_error(f"Ghi local lỗi: {e}")

    # ─────── BƯỚC 3: PUSH ───────
    if GH_CONFIG:
        log_info("Đang push GitHub...")
        ok_gh, err = github_push(GH_CONFIG, content)
        if ok_gh:
            log_info("✓ Push GitHub thành công")
        else:
            log_error(f"✗ Push GitHub fail: {err}")
        return ok_local, ok_gh, err, merged_dict

    return ok_local, False, "no config", merged_dict


