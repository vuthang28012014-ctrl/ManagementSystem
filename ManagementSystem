    def _build_settings_tab_bar(self, card):
        """
        Tab bar + indicator animation + container cho tab content.
        Returns (tab_frames: dict[str, Frame], switch_tab: callable).
        """
        TAB_H = 40
        tab_bar = tk.Canvas(card, bg=self.NEN2, height=TAB_H,
                             highlightthickness=0, bd=0)
        tab_bar.pack(fill="x")

        tab_defs = [
            ("effects",   "🎬 Hiệu ứng"),
            ("config",    "📋 Cấu hình khác"),
            ("changelog", "📝 Update log"),
        ]
        tab_btns = {}
        tab_frames = {}

        INDICATOR_COLOR  = "#e8e8f0"
        INDICATOR_RADIUS = 10

        def _rr_coords(x1, y1, x2, y2, r=INDICATOR_RADIUS):
            max_r = min(abs(x2 - x1) / 2, abs(y2 - y1) / 2)
            r = min(r, max_r)
            return (
                x1+r, y1, x1+r, y1, x2-r, y1, x2-r, y1,
                x2, y1, x2, y1+r, x2, y1+r, x2, y2-r,
                x2, y2-r, x2, y2, x2-r, y2, x2-r, y2,
                x1+r, y2, x1+r, y2, x1, y2, x1, y2-r,
                x1, y2-r, x1, y1+r, x1, y1+r, x1, y1,
            )

        indicator_id = tab_bar.create_polygon(
            *_rr_coords(0, 0, 0, 0),
            fill=INDICATOR_COLOR, outline="", smooth=True)

        _tab_font = tkfont.Font(family="Segoe UI", size=9, weight="bold")
        PADDING_X, GAP, BTN_H = 16, 6, 30
        BTN_Y = (TAB_H - BTN_H) // 2
        cursor_x = 6
        for key, label in tab_defs:
            text_w = _tab_font.measure(label)
            w = text_w + PADDING_X * 2
            cx = cursor_x + w // 2
            cy = BTN_Y + BTN_H // 2
            text_id = tab_bar.create_text(cx, cy, text=label,
                                            font=_tab_font,
                                            fill=self.CHU_MO)
            tab_btns[key] = {"x": cursor_x, "y": BTN_Y,
                             "w": w, "h": BTN_H, "text_id": text_id}
            cursor_x += w + GAP

        current_tab = {"key": None}
        _ind_anim   = {"job": None}

        def _set_text_colors(active_key):
            for k, info in tab_btns.items():
                try:
                    fill = "#1e1e2e" if k == active_key else self.CHU_MO
                    tab_bar.itemconfigure(info["text_id"], fill=fill)
                except Exception as e:
                    log_warn(f"tab text color fail: {e}")

        def _move_indicator(old_key, new_key):
            if _ind_anim["job"]:
                try: self.root.after_cancel(_ind_anim["job"])
                except Exception: pass
                _ind_anim["job"] = None
            if new_key not in tab_btns:
                return
            n = tab_btns[new_key]
            nx = n["x"] + n["w"] // 2
            ny = n["y"] + n["h"] // 2
            nw, nh = n["w"], n["h"]
            if old_key is None or old_key not in tab_btns:
                try:
                    tab_bar.coords(indicator_id, *_rr_coords(
                        nx - nw/2, ny - nh/2, nx + nw/2, ny + nh/2))
                except Exception as e:
                    log_warn(f"indicator place fail: {e}")
                _set_text_colors(new_key)
                return
            o = tab_btns[old_key]
            ox, oy = o["x"] + o["w"]//2, o["y"] + o["h"]//2
            ow, oh = o["w"], o["h"]
            try: tab_bar.itemconfigure(o["text_id"], fill=self.CHU_MO)
            except Exception: pass
            total = 16
            def _step(i):
                if i > total:
                    _ind_anim["job"] = None
                    try:
                        tab_bar.coords(indicator_id, *_rr_coords(
                            nx - nw/2, ny - nh/2, nx + nw/2, ny + nh/2))
                    except Exception: pass
                    _set_text_colors(new_key)
                    return
                t = i / total
                k = 1 - (1 - t) ** 3
                cx = ox + (nx - ox) * k
                cy = oy + (ny - oy) * k
                cw = ow + (nw - ow) * k
                ch = oh + (nh - oh) * k
                try:
                    tab_bar.coords(indicator_id, *_rr_coords(
                        cx - cw/2, cy - ch/2, cx + cw/2, cy + ch/2))
                except Exception:
                    return
                _ind_anim["job"] = self.root.after(
                    16, lambda: _step(i + 1))
            _step(0)

        container = tk.Frame(card, bg=self.NEN)
        container.pack(fill="both", expand=True)

        for key, _ in tab_defs:
            tab_frames[key] = tk.Frame(container, bg=self.NEN)

        def switch_tab(key):
            old_key = current_tab["key"]
            if old_key == key:
                return
            current_tab["key"] = key
            _move_indicator(old_key, key)
            for k, f in tab_frames.items():
                if k == key:
                    f.pack(fill="both", expand=True, padx=16, pady=(10, 0))
                else:
                    f.pack_forget()

        def _on_tab_click(e):
            for key, info in tab_btns.items():
                if (info["x"] <= e.x <= info["x"] + info["w"]
                        and info["y"] <= e.y <= info["y"] + info["h"]):
                    switch_tab(key)
                    return
        tab_bar.bind("<Button-1>", _on_tab_click)
        return tab_frames, switch_tab

