        err_data = Reference(
            ws_data,
            min_col=12, max_col=12,
            min_row=1, max_row=1 + len(WEEKS))
        err_cats = Reference(
            ws_data,
            min_col=1, max_col=1,
            min_row=2, max_row=1 + len(WEEKS))

