                    "Mở Settings → Tab 'Cấu hình khác' → 'Zalo' "
                    "để cấu hình.\n\nMở Settings bây giờ?")
                if ans:
                    self.mo_settings_inline()
            return

        if auto:
            tuan = self._tuan_moi_nhat_co_du_lieu() or self.tuan_hien_tai
        else:
            tuan = self.tuan_hien_tai
        min_ab = int(self.settings.get("zalo_min_absent", 1))
        msg = _build_zalo_absent_message(
            self.HocSinh, tuan, self.settings["ly_do_mac_dinh"], min_ab)
        if not msg:
            if not auto:
                self.thong_bao(
                    f"✓ Tuần {tuan} không có HS vắng ≥ {min_ab} buổi",
                    self.XANH_LA)
            return

        # Chống gửi lặp: bỏ dòng "Thời gian" rồi băm nội dung
        _core = "\n".join(ln for ln in msg.split("\n")
                          if not ln.startswith("Thời gian:"))
        msg_hash = f"{tuan}:{_hash_str(_core)}"
        if auto and self.settings.get("zalo_last_hash") == msg_hash:
            return

        self.thong_bao("📨 Đang gửi Zalo...", self.XANH_DUONG)

        def task():
            for chunk in _chia_tin_nhan(msg):
                ok_c, err_c = zalo_send(token, chat_id, chunk)
                if not ok_c:
                    return ok_c, err_c
            return True, None

        def on_done(res):
            ok, err = res
            if ok:
                self.settings["zalo_last_sent"] = _time.time()
                self.settings["zalo_last_hash"] = msg_hash
                save_settings(self.settings)
                self.thong_bao("✓ Đã gửi thông báo Zalo", self.XANH_LA)
            else:
                log_warn(f"Zalo send fail: {err}")
                if not auto:
                    messagebox.showerror(
                        "Lỗi gửi Zalo",
                        f"Không gửi được tin nhắn.\n\nLỗi: {err}\n\n"
                        "Kiểm tra:\n"
                        "  • Bot Token đúng chưa?\n"
                        "  • Chat ID đúng chưa?\n"
                        "  • Đã /start bot trong Zalo chưa?\n"
                        "  • Có kết nối Internet không?")
                self.thong_bao(f"✗ Zalo: {err}", self.DO)

        self._async(task, on_success=on_done)

