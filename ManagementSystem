    # ═══ HS CRUD ═══
    def them_hoc_sinh(self):
        """Thêm mới nếu Mã chưa có, cập nhật nếu Mã đã tồn tại."""
        if not self._can_write(): return          # ← THÊM DÒNG NÀY
        ma_str = self.o_ma.get().strip()
        ten    = self.o_ten.get().strip()
        lop    = self.o_lop.get().strip()
        to     = self.o_to.get().strip()

        if not ma_str or not ten or not lop:
            self.thong_bao("⚠ Nhập đầy đủ Mã, Tên, Lớp", self.VANG)
            return
        try:
            ma = int(ma_str)
        except ValueError:
            self.thong_bao("⚠ Mã phải là số nguyên", self.DO)
            self.o_ma.focus_set()
            return

        # Chuẩn hóa tổ
        if to and to not in ("1", "2", "3", "4"):
            self.thong_bao("⚠ Tổ phải là 1, 2, 3, 4 hoặc để trống", self.VANG)
            self.o_to.focus_set()
            return

        to_str = f", Tổ {to}" if to else ""

        # ── TRƯỜNG HỢP 1: ĐÃ TỒN TẠI → SỬA ──
        if ma in self.HocSinh:
            d = self.HocSinh[ma]
            old_name  = d.get("name",  "")
            old_class = d.get("class", "")
            old_to    = d.get("to",    "")

            # Không có gì đổi → thoát
            if old_name == ten and old_class == lop and old_to == to:
                self.thong_bao("⚠ Không có gì thay đổi", self.CHU_MO)
                return

            self._snapshot(f"Sửa HS {ma}")

            # Cập nhật từng field
            d["name"]  = ten
            d["class"] = lop
            d["to"]    = to

            self.xoa_form()
            self.cap_nhat_bang()
            self.cap_nhat_diem_danh()

            # Thông báo chi tiết cái gì đổi
            changes = []
            if old_name  != ten: changes.append(f"tên '{old_name}' → '{ten}'")
            if old_class != lop: changes.append(f"lớp '{old_class}' → '{lop}'")
            if old_to    != to:
                o = old_to if old_to else "∅"
                n = to      if to      else "∅"
                changes.append(f"tổ {o} → {n}")

            detail = " · ".join(changes) if changes else "cập nhật"
            self.thong_bao(f"✓ Đã sửa mã {ma}: {detail}", self.CAM)

            # Flash row vừa sửa
            if self.settings.get("enable_animation", True):
                self.bang.after(50, lambda: flash_row(
                    self.bang, str(ma), color="#5a5a3f", duration=500))
                self.bang_dd.after(50, lambda: flash_row(
                    self.bang_dd, str(ma), color="#5a5a3f", duration=500))
            return

        # ── TRƯỜNG HỢP 2: CHƯA TỒN TẠI → THÊM MỚI ──
        self._snapshot(f"Thêm HS {ma}")
        self.HocSinh[ma] = {
            "name": ten, "class": lop, "to": to,
            "weeks": tao_du_lieu_tat_ca_tuan(),
        }
        self.xoa_form()
        self.cap_nhat_bang()
        self.cap_nhat_diem_danh()
        self.thong_bao(
            f"✓ Đã thêm: {ten} (Mã {ma}, {lop}{to_str})", self.XANH_LA)

        # Flash row mới
        if self.settings.get("enable_animation", True):
            self.bang.after(50, lambda: flash_row(
                self.bang, str(ma), color="#3f5a3f", duration=500))

    def xoa_da_chon(self):
        if not self._can_write(): return          # ← THÊM DÒNG NÀY
        sel = self.bang.selection()
        if not sel:
            self.thong_bao("⚠ Chưa chọn HS nào", self.VANG); return
        ds_ma = []
        for i in sel:
            try:
                ds_ma.append(int(self.bang.item(i, "values")[0]))
            except (ValueError, IndexError, TypeError):
                continue
        if not ds_ma:
            self.thong_bao("⚠ Không đọc được mã HS", self.DO); return
        ds_ten = [self.HocSinh[s]["name"] for s in ds_ma if s in self.HocSinh]
        if not messagebox.askyesno("Xác nhận xóa",
            f"Xóa {len(ds_ma)} học sinh?\n\n" + "\n".join(f"• {n}" for n in ds_ten)):
            return
        self._snapshot(f"Xóa {len(ds_ma)} HS")
        for ma in ds_ma: self.HocSinh.pop(ma, None)
        self.cap_nhat_bang()
        self.cap_nhat_diem_danh()
        self._xoa_panel_ct()
        self.thong_bao(f"✓ Đã xóa {len(ds_ma)} HS (Ctrl+Z để hoàn tác)", self.XANH_LA)

    def luu_ngay(self, auto=False):
        if not self._can_write(): return          # ← THÊM DÒNG NÀY
        if self._saving:
            self.thong_bao("⏳ Đang lưu...", self.VANG)
            return
        self._saving = True
        self.thong_bao("💾 Đang pull → merge → push...", self.XANH_DUONG)
        self._start_progress()          # ← THÊM DÒNG NÀY

        # Snapshot để thread dùng (tránh race condition)
        local_snapshot = deepcopy(self.HocSinh)
        ly_do_md = self.settings["ly_do_mac_dinh"]

        # Bản local gốc để so sánh với bản merged (cảnh báo máy khác sửa)
        local_ref = deepcopy(local_snapshot)
        base_snapshot = deepcopy(getattr(self, "_base", None))

        def task():
            return ghi_file(local_snapshot, ly_do_md, DATA_FILE,
                            backup_count=self.settings["backup_count"],
                            base=base_snapshot)

        def on_done(res):
            ok_local, ok_gh, err, merged = res
            self._saving = False

            # ── So sánh để cảnh báo máy khác đã sửa ──
            if merged is not None:
                try:
                    local_int = {int(k): v for k, v in local_ref.items()}
                    warn = _diff_for_warning(local_int, merged)
                    total = (len(warn["new_hs"])
                             + warn["att_changes"]
                             + warn["reason_changes"]
                             + warn["error_changes"])
                    if total > 0:
                        lines = ["🔄 Phát hiện thay đổi từ máy khác "
                                 "— đã tự động merge:\n"]
                        if warn["new_hs"]:
                            names = warn["new_hs"][:10]
                            lines.append(
                                f"➕ {len(warn['new_hs'])} HS mới:")
                            for n in names:
                                lines.append(f"   • {n}")
                            if len(warn["new_hs"]) > 10:
                                lines.append(
                                    f"   ... và {len(warn['new_hs'])-10} HS khác")
                        if warn["deleted_hs"]:
                            lines.append(
                                f"➖ {len(warn['deleted_hs'])} HS bị xóa")
                        if warn["att_changes"]:
                            lines.append(
                                f"✓ {warn['att_changes']} ô điểm danh thay đổi")
                        if warn["reason_changes"]:
                            lines.append(
                                f"✏ {warn['reason_changes']} lý do thay đổi")
                        if warn["error_changes"]:
                            lines.append(
                                f"⚠ {warn['error_changes']} lỗi thay đổi")
                        lines.append("\nDữ liệu đã được cập nhật "
                                     "— kiểm tra lại nếu cần.")
                        self.root.after(200, lambda: messagebox.showinfo(
                            "Đã merge với máy khác", "\n".join(lines)))
                except Exception as e:
                    log_warn(f"Diff warning fail: {e}")
            self._progress_running = False
            self._progress_pos     = 0
            if self._tw_job:
                try: self.root.after_cancel(self._tw_job)
                except Exception: pass
                self._tw_job = None
            self._slide_busy       = False
            self._dirty = False
            self._stop_progress()

            # Update UI với bản merged (nếu có)
            if merged is not None:
                self.HocSinh.clear()
                for k, v in merged.items():
                    self.HocSinh[k] = v
                self.cap_nhat_bang()
                self.cap_nhat_diem_danh()
                log_info(f"UI refresh với {len(self.HocSinh)} HS sau merge")

            # ── Lưu thất bại thì giữ cờ dirty để auto-save thử lại ──
            if not (ok_local and (ok_gh or not GH_CONFIG)):
                self._dirty = True

            # ── Cập nhật base cho lần merge 3 chiều kế tiếp ──
            if ok_gh:
                self._base = deepcopy(self.HocSinh)

            # ── Gửi Zalo nếu bật (chỉ khi bấm Lưu tay, không phải auto-save) ──
            if (ok_local
                    and not auto
                    and self.settings.get("zalo_enabled", False)
                    and self.settings.get("zalo_notify_on_save", True)):
                try:
                    self.gui_thong_bao_zalo(auto=True)
                except Exception as e:
                    log_warn(f"Auto zalo fail: {e}")

            n = len(self.HocSinh)
            if ok_local and ok_gh:
                self.thong_bao(f"✓ Pull-merge-push {n} HS lên GitHub", self.XANH_LA)
                if not auto:
                    self._spawn_confetti()
            elif ok_local:
                msg = f"✓ Local OK ({n} HS)"
                if GH_CONFIG:
                    msg += f" · ⚠ GitHub: {err or 'fail'}"
                self.thong_bao(msg, self.VANG)
            else:
                self.thong_bao("✗ Lỗi lưu — xem app.log", self.DO)

        def on_err(e):
            self._saving = False
            self._progress_running = False
            self._progress_pos     = 0
            if self._tw_job:
                try: self.root.after_cancel(self._tw_job)
                except Exception: pass
                self._tw_job = None
            self._slide_busy       = False
            self._dirty = True
            self._stop_progress()
            self.thong_bao(f"✗ Lỗi: {e}", self.DO)

        self._async(task, on_success=on_done, on_error=on_err)

