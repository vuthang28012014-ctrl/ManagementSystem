def _object_pairs_hook_clean(pairs, warnings=None):
    seen = {}
    for k, v in pairs:
        if k in seen:
            msg = f"Duplicate key '{k}' trong JSON — giữ bản cuối"
            log_warn(msg)
            if warnings is not None:
                warnings.append(msg)
        seen[k] = v
    return seen


def _backup_file(path, keep=5):
    """Backup file với timestamp. Giữ N bản mới nhất."""
    if not os.path.exists(path):
        return
    try:
        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        bak = f"{path}.bak.{ts}"
        with open(path, "rb") as src, open(bak, "wb") as dst:
            dst.write(src.read())
        # Dọn backup cũ
        parent = os.path.dirname(path) or "."
        base = os.path.basename(path) + ".bak."
        baks = sorted(
            [os.path.join(parent, f) for f in os.listdir(parent) if f.startswith(base)],
            key=os.path.getmtime
        )
        for old in baks[:-keep]:
            try: os.remove(old)
            except Exception: pass
    except Exception as e:
        log_warn(f"Backup thất bại: {e}")


def doc_file(HocSinh, filename=DATA_FILE):
    """Load data — ưu tiên GitHub, fallback local.
    Trả về (số_hs, warnings_list)."""
    warnings = []
    content  = None

    if GH_CONFIG:
        log_info(f"Đang tải từ GitHub {GH_CONFIG['owner']}/{GH_CONFIG['repo']}...")
        gh = github_fetch(GH_CONFIG)
        if gh:
            content = gh
            try:
                with open(filename, "w", encoding="utf-8") as f:
                    f.write(content)
                log_info("✓ Đã đồng bộ từ GitHub")
            except Exception as e:
                log_warn(f"Không ghi local: {e}")
        else:
            log_warn("GitHub không có — fallback local")

    if content is None:
        if not os.path.exists(filename):
            return 0, warnings
        try:
            with open(filename, "r", encoding="utf-8") as f:
                content = f.read().strip()
        except Exception as e:
            log_error(f"Đọc file lỗi: {e}")
            return 0, warnings

    if not content:
        return 0, warnings

    try:
        raw = json.loads(
            content,
            object_pairs_hook=lambda p: _object_pairs_hook_clean(p, warnings)
        )
    except json.JSONDecodeError as e:
        log_error(f"JSON lỗi: {e} — thử format text cũ")
        for line in content.splitlines():
            line = line.strip()
            if not line: continue
            parts = line.split("|")
            if len(parts) != 3: continue
            try:
                sid = int(parts[0])
                HocSinh[sid] = {
                    "name": parts[1], "class": parts[2],
                    "weeks": tao_du_lieu_tat_ca_tuan(),
                }
            except ValueError:
                continue
        return len(HocSinh), warnings

    # Migrate + validate
    bad_count = 0
    for sid_str, info in raw.items():
        try:
            sid = int(sid_str)
        except ValueError:
            bad_count += 1; continue

        # Migration: format cũ top-level attendance/reasons/errors → weeks[1]
        if "weeks" not in info:
            info["weeks"] = tao_du_lieu_tat_ca_tuan()
            info["weeks"][1]["attendance"] = info.get("attendance", diem_danh_moi())
            info["weeks"][1]["reasons"]    = info.get("reasons",    ly_do_moi())
            info["weeks"][1]["errors"]     = info.get("errors",     loi_moi())
            for k in ("attendance", "reasons", "errors"):
                info.pop(k, None)

        # ── Chuẩn hóa key int + điền tuần thiếu ──
        weeks_int = {}
        for k, v in info["weeks"].items():
            try:
                t_int = int(k)
            except (ValueError, TypeError):
                continue
            weeks_int[t_int] = _chuan_hoa_tuan(v)

        for t in range(1, TONG_TUAN + 1):
            if t not in weeks_int:
                weeks_int[t] = tuan_moi()

        info["weeks"] = weeks_int

        # Đảm bảo có field "to" (tổ)
        if "to" not in info:
            info["to"] = ""
        else:
            info["to"] = str(info["to"]).strip()

        # Validate schema
        if not validate_hs_info(info):
            log_warn(f"HS {sid} sai schema — chuyển name/class thành str")
            info["name"]  = str(info.get("name",  ""))
            info["class"] = str(info.get("class", ""))

        HocSinh[sid] = info

    if bad_count:
        warnings.append(f"{bad_count} HS có mã không hợp lệ đã bị bỏ qua")

    return len(HocSinh), warnings

