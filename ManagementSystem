def _normalize_remote(raw):
    """Chuẩn hóa data remote về format chuẩn (key int)."""
    out = {}
    for sid_str, info in raw.items():
        if sid_str == "_meta":
            continue
        try:
            sid = int(sid_str)
        except (ValueError, TypeError):
            continue
        if "weeks" not in info:
            info["weeks"] = tao_du_lieu_tat_ca_tuan()
            info["weeks"][1]["attendance"] = info.get("attendance", diem_danh_moi())
            info["weeks"][1]["reasons"]    = info.get("reasons",    ly_do_moi())
            info["weeks"][1]["errors"]     = info.get("errors",     loi_moi())
            for k in ("attendance", "reasons", "errors"):
                info.pop(k, None)

        # ── FIX: normalize key về int ──
        weeks_int = {}
        for k, v in (info.get("weeks") or {}).items():
            try:
                weeks_int[int(k)] = _chuan_hoa_tuan(v)
            except (ValueError, TypeError):
                continue
        for t in range(1, TONG_TUAN + 1):
            weeks_int.setdefault(t, tuan_moi())
        info["weeks"] = weeks_int

        if "to" not in info:
            info["to"] = ""
        else:
            info["to"] = str(info["to"]).strip()

        if not validate_hs_info(info):
            info["name"]  = str(info.get("name",  ""))
            info["class"] = str(info.get("class", ""))
        out[sid] = info
    return out

