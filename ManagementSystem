# DOC / GHI FILE (có tích hợp GitHub)
# ═══════════════════════════════════════════════════════════════
def doc_file(filename=TEN_FILE):
    """Load data — ưu tiên GitHub, fallback local."""
    content = None

    # 1. Thử fetch từ GitHub
    if GH_CONFIG:
        print(f"[Load] Đang tải từ GitHub ({GH_CONFIG['owner']}/{GH_CONFIG['repo']})...")
        gh_content = github_fetch(GH_CONFIG)
        if gh_content:
            content = gh_content
            # Ghi đè local bằng data từ GitHub (backup)
            try:
                with open(filename, "w", encoding="utf-8") as f:
                    f.write(content)
                print("[Load] ✓ Đã đồng bộ từ GitHub")
            except Exception as e:
                print(f"[Load] Không ghi local được: {e}")
        else:
            print("[Load] GitHub không có — fallback local")

    # 2. Fallback local
    if content is None:
        if not os.path.exists(filename):
            return 0
        try:
            with open(filename, "r", encoding="utf-8") as f:
                content = f.read().strip()
        except Exception as e:
            print(f"Lỗi đọc file: {e}")
            return 0

    if not content:
        return 0

    # 3. Parse JSON
    try:
        raw = json.loads(content)
        for sid_str, info in raw.items():
            sid = int(sid_str)
            # Migrate format cũ
            if "weeks" not in info:
                info["weeks"] = tao_du_lieu_tat_ca_tuan()
                info["weeks"][1]["attendance"] = info.get("attendance", diem_danh_moi())
                info["weeks"][1]["reasons"]    = info.get("reasons", ly_do_moi())
                info["weeks"][1]["errors"]     = info.get("errors", loi_moi())
                for k in ("attendance", "reasons", "errors"):
                    info.pop(k, None)
            for t in range(1, TONG_TUAN + 1):
                if t not in info["weeks"]:
                    info["weeks"][t] = tuan_moi()
                else:
                    info["weeks"][t] = _chuan_hoa_tuan(info["weeks"][t])
            HocSinh[sid] = info
        return len(HocSinh)
    except json.JSONDecodeError:
        # Fallback text format cũ
        for line in content.splitlines():
            line = line.strip()
            if not line: continue
            parts = line.split("|")
            if len(parts) != 3: continue
            try:
                sid = int(parts[0])
                HocSinh[sid] = {
                    "name": parts[1], "class": parts[2],
                    "weeks": tao_du_lieu_tat_ca_tuan(),
                }
            except ValueError:
                continue
        return len(HocSinh)


def ghi_file(filename=TEN_FILE):
    """Ghi data — lưu local + push GitHub."""
    # Đảm bảo vắng không lý do → "Không phép"
    for sid, d in HocSinh.items():
        for t, w in d.get("weeks", {}).items():
            att = w.get("attendance", {})
            rea = w.setdefault("reasons", ly_do_moi())
            for day in THU:
                if not att.get(day, False) and not rea.get(day, "").strip():
                    rea[day] = LY_DO_MAC_DINH

    content = json.dumps({str(k): v for k, v in HocSinh.items()},
                          indent=2, ensure_ascii=False)

    # 1. Ghi local (đảm bảo không mất data)
    try:
        with open(filename, "w", encoding="utf-8") as f:
            f.write(content)
        print("[Save] ✓ Đã ghi local")
    except Exception as e:
        print(f"[Save] Lỗi ghi local: {e}")

    # 2. Push GitHub
    if GH_CONFIG:
        print("[Save] Đang push lên GitHub...")
        ok = github_push(GH_CONFIG, content)
        if ok:
            print("[Save] ✓ Đã push GitHub")
        else:
            print("[Save] ⚠ Push GitHub thất bại — data an toàn ở local")
        return ok
    return False


