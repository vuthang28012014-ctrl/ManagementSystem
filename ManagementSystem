    def _xac_dinh_o(self, x, y):
        if self.bang_dd.identify("region", x, y) != "cell": return None
        row_id = self.bang_dd.identify_row(y)
        if not row_id: return None
        col_id = self.bang_dd.identify_column(x)
        col_idx = int(col_id[1:]) - 1
