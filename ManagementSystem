        if not self._can_write(): return          # ← THÊM DÒNG NÀY
        if not self._tuan_co_the_sua():
            self.thong_bao(
                f"⚠ Tuần {self.tuan_hien_tai} đã khóa (max={self.settings['max_editable_week']})",
                self.DO)
            self._pulse_locked(ma)
            return
        w = self._du_lieu_tuan(ma)
        if not w: return
        self._snapshot(f"Đổi trạng thái {ma}/{day}")
        d = self.HocSinh[ma]
        new_val = not w["attendance"].get(day, False)
        w["attendance"][day] = new_val
        if new_val:
            w["reasons"][day] = ""
            self.thong_bao(f"✓ {d['name']} — T{self.tuan_hien_tai} {day}: Có mặt", self.XANH_LA)
        else:
            w["reasons"][day] = self.settings["ly_do_mac_dinh"]
