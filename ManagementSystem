from typing import Any

def _fmt_rate(rate):
    """Tỉ lệ → chuỗi; None (chưa có dữ liệu) → '—'."""
    return "—" if rate is None else f"{rate:.1f}%"


def _rate_sort(rate):
    """Key sắp xếp tăng dần: chưa có dữ liệu xếp cuối."""
    return (1, 0.0) if rate is None else (0, rate)


def compute_stats(hoc_sinh: dict, weeks: list[int],
                   ly_do_md: str) -> dict[str, Any]:
    """
    Tính toàn bộ thống kê chuyên cần cho 1 tập tuần.

    Trả về:
      {
        "hs_order":     list[int],            # mã HS đã sort theo tên
        "hs_rows":      list[dict],           # {ma, name, class, to,
                                              #  cm, vp, vkp, loi, total, rate}
        "week_data":    list[tuple[int,float]],   # (tuần, tỉ lệ %)
        "err_week_data": list[tuple[int,float]],  # (tuần, % HS có lỗi)
        "class_data":   list[tuple[str,float,int,int]],  # (lớp, rate, cm, total)
        "totals": {"cm": int, "vp": int, "vkp": int, "loi": int,
                   "total": int, "rate": float},
      }
    """
    hs_order = sorted(hoc_sinh.keys(),
                      key=lambda m: hoc_sinh[m]["name"].lower())
    n_hs = len(hs_order) if hs_order else 1

    hs_rows: list[dict] = []
    all_cm = all_vp = all_vkp = all_loi = 0

    for ma in hs_order:
        d = hoc_sinh[ma]
        n_cm = n_vp = n_vkp = n_loi = 0
        for t in weeks:
            w = d.get("weeks", {}).get(t) or {}
            att = w.get("attendance", {})
            rea = w.get("reasons", {})
            err = w.get("errors", {})
            for day in THU:
                loai = phan_loai_o(att.get(day, False),
                                   rea.get(day, ""), ly_do_md)
                if loai == "cm":
                    n_cm += 1
                elif loai == "vp":
                    n_vp += 1
                elif loai == "vkp":
                    n_vkp += 1
                if (err.get(day, "") or "").strip():
                    n_loi += 1
        tt = n_cm + n_vp + n_vkp
        rate = (n_cm / tt * 100) if tt else None
        hs_rows.append({
            "ma": ma, "name": d["name"], "class": d["class"],
            "to": d.get("to", "") or "—",
            "cm": n_cm, "vp": n_vp, "vkp": n_vkp,
            "loi": n_loi, "total": tt, "rate": rate,
        })
        all_cm += n_cm; all_vp += n_vp
        all_vkp += n_vkp; all_loi += n_loi

    total_all = all_cm + all_vp + all_vkp
    rate_all = (all_cm / total_all * 100) if total_all else 0

    # ── Theo tuần ──
    week_data: list[tuple[int, float]] = []
    err_week_data: list[tuple[int, float]] = []
    for t in weeks:
        t_cm = t_vp = t_vkp = 0
        n_err_hs = 0
        for ma in hs_order:
            w = hoc_sinh[ma].get("weeks", {}).get(t) or {}
            att = w.get("attendance", {})
            rea = w.get("reasons", {})
            err = w.get("errors", {})
            for day in THU:
                loai = phan_loai_o(att.get(day, False),
                                   rea.get(day, ""), ly_do_md)
                if loai == "cm":
                    t_cm += 1
                elif loai == "vp":
                    t_vp += 1
                elif loai == "vkp":
                    t_vkp += 1
            if any((err.get(day, "") or "").strip() for day in THU):
                n_err_hs += 1
        tt = t_cm + t_vp + t_vkp
        week_data.append((t, (t_cm / tt * 100) if tt else None))
        err_week_data.append((t, n_err_hs / n_hs * 100))

    # ── Theo lớp ──
    class_stats: dict[str, list[int]] = {}
    for ma in hs_order:
        d = hoc_sinh[ma]
        cls = d.get("class", "") or "(Không lớp)"
        arr = class_stats.setdefault(cls, [0, 0, 0])
        for t in weeks:
            w = d.get("weeks", {}).get(t) or {}
            att = w.get("attendance", {})
            rea = w.get("reasons", {})
            for day in THU:
                loai = phan_loai_o(att.get(day, False),
                                   rea.get(day, ""), ly_do_md)
                if loai == "cm":
                    arr[0] += 1
                elif loai == "vp":
                    arr[1] += 1
                elif loai == "vkp":
                    arr[2] += 1
    class_data: list[tuple[str, float, int, int]] = []
    for cls, (p, e, a) in class_stats.items():
        tt = p + e + a
        class_data.append((cls, (p / tt * 100) if tt else None, p, tt))
    class_data.sort(key=lambda x: -x[1])

    # ── Theo lớp (chi tiết) ──
    by_class: dict[str, list[int]] = {}
    for h in hs_rows:
        cls = h["class"] or "(Không lớp)"
        arr = by_class.setdefault(cls, [0, 0, 0, 0])
        arr[0] += h["cm"]
        arr[1] += h["vp"]
        arr[2] += h["vkp"]
        arr[3] += 1

    return {
        "hs_order":      hs_order,
        "hs_rows":       hs_rows,
        "week_data":     week_data,
        "err_week_data": err_week_data,
        "class_data":    class_data,
        "by_class":      by_class,
        "totals": {
            "cm": all_cm, "vp": all_vp, "vkp": all_vkp,
            "loi": all_loi, "total": total_all, "rate": rate_all,
        },
    }

def _chuan_hoa_tuan(w: Any) -> dict:
    if not isinstance(w, dict):
        w = {}
    att = w.get("attendance")
    rea = w.get("reasons")
    err = w.get("errors")
    if not isinstance(att, dict): att = {}
    if not isinstance(rea, dict): rea = {}
    if not isinstance(err, dict): err = {}
    for d in THU:
        att.setdefault(d, False)
        rea.setdefault(d, "")
        err.setdefault(d, "")
    w["attendance"] = att
    w["reasons"]    = rea
    w["errors"]     = err
    return w


def validate_hs_info(info):
    """Trả True nếu info đúng schema. Không sửa info."""
    if not isinstance(info, dict):
        return False
    if not isinstance(info.get("name"),  str): return False
    if not isinstance(info.get("class"), str): return False
    if not isinstance(info.get("weeks"), dict): return False
    return True


