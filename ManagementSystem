    def _apply_update(self, remote_content, dlg):
        """Ghi file mới + backup file cũ."""
        if getattr(self, "read_only", False):
            messagebox.showwarning(
                "Chỉ xem",
                "Chế độ CHỈ XEM không được cập nhật. Mở lại app bằng mật khẩu.",
                parent=dlg)
            return
        script_path = _get_self_path()

        # ── Chuẩn hóa xuống dòng về LF để tránh \r\r\n khi ghi ──
        remote_content = _norm_text(remote_content)
        _lines = remote_content.split("\n")
        _nonblank = sum(1 for ln in _lines if ln.strip())
        _followed = sum(1 for i in range(len(_lines) - 1)
                        if _lines[i].strip() and not _lines[i + 1].strip())
        # File kép: gần như mọi dòng có chữ đều bị 1 dòng trống theo sau
        if _nonblank and _followed / _nonblank > 0.8:
            remote_content = _fix_double_newlines(remote_content)

        # ── Kiểm tra cú pháp trước khi ghi đè chính mình ──
        try:
            compile(remote_content, "<update>", "exec")
        except SyntaxError as e:
            log_error(f"Update bị hủy, file mới lỗi cú pháp: {e}")
            messagebox.showerror(
                "Bản cập nhật bị lỗi",
                f"File tải về có lỗi cú pháp nên KHÔNG được ghi đè.\n\n{e}",
                parent=dlg)
            return

        if not script_path:
            # Cho phép người dùng chọn file .py thủ công
            ans = messagebox.askyesno(
                "Không tìm thấy file script",
                "Không tự dò được file .py đang chạy.\n\n"
                "Bạn có muốn CHỌN THỦ CÔNG file script không?\n"
                "(Ví dụ: quanly.py)\n\n"
                "Nếu chạy từ .exe thì bấm 'No' để mở link tải.",
                parent=dlg)
            if ans:
                picked = filedialog.askopenfilename(
                    title="Chọn file script .py đang chạy",
                    filetypes=[("Python files", "*.py *.pyw"),
                                ("All files", "*.*")],
                    parent=dlg)
                if picked and os.path.exists(picked):
                    _remember_script_path(picked)
                    script_path = os.path.abspath(picked)
                else:
                    return
            else:
                messagebox.showinfo(
                    "Tải thủ công",
                    "Vui lòng tải bản mới tại:\n"
                    "https://github.com/vuthang28012014-ctrl/"
                    "ManagementSystem",
                    parent=dlg)
                return

        # 1. Backup file cũ
        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        bak_path = f"{script_path}.bak.{ts}"
        try:
            shutil.copy2(script_path, bak_path)
            log_info(f"✓ Backup script: {bak_path}")
        except Exception as e:
            log_error(f"Backup script fail: {e}")
            messagebox.showerror(
                "Lỗi backup",
                f"Không thể sao lưu file cũ:\n{e}",
                parent=dlg)
            return

        # 2. Ghi file mới (atomic qua tmp)
        try:
            tmp = script_path + ".new"
            with open(tmp, "w", encoding="utf-8", newline="\n") as f:
                f.write(remote_content)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, script_path)
            log_info(f"✓ Đã ghi script mới: {script_path}")
        except Exception as e:
            log_error(f"Apply update fail: {e}")
            # Rollback nếu có thể
            try:
                shutil.copy2(bak_path, script_path)
                log_info("✓ Đã rollback script")
            except Exception as rollback_err:
                log_error(f"Rollback fail: {rollback_err}")
            messagebox.showerror(
