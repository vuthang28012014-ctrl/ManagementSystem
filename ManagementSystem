# SHA256 của mật khẩu. Đổi mật khẩu: chạy
#   python -c "import hashlib;print(hashlib.sha256('MAT_KHAU_MOI'.encode()).hexdigest())"
# rồi dán vào đây, hoặc đặt khoá "password_sha256" trong settings.json (ưu tiên hơn).
_PWD_SHA256_DEFAULT = "96da37e95d5cc34fe3bef6c89428df859b8a217630d0c664da1daf1539caacf5"


def _check_password(pwd):
    expected = _PWD_SHA256_DEFAULT
    try:
        if os.path.exists(SETTINGS_FILE):
            with open(SETTINGS_FILE, "r", encoding="utf-8") as f:
                expected = (json.load(f).get("password_sha256") or expected)
    except Exception:
        pass
    got = hashlib.sha256(pwd.encode("utf-8")).hexdigest()
    return hmac.compare_digest(got, str(expected).strip().lower())


